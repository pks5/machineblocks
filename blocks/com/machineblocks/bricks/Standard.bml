<block
  xmlns="http://blockml.org/schema/block"
  xmlns:bml="http://blockml.org/schema/bml"
  xmlns:data="http://blockml.org/schema/data"
  xmlns:core="com.machineblocks.core"
  xmlns:type="com.machineblocks.type"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://blockml.org/schema/block
        https://blockml.org/schemas/core/block.xsd
    http://machineblocks.com/schema/core
        https://machineblocks.com/schemas/machineblocks/core.xsd
    http://machineblocks.com/schema/bricks
        https://machineblocks.com/schemas/machineblocks/bricks.xsd
  ">

  <idea>Lego compatible standard building block.</idea>

  <name>Standard</name>
  <type>com.machineblocks.bricks.Standard</type>
  <baseType>com.machineblocks.core.Block</baseType>
  <version>3.0.0</version>

  <properties>

    <!-- Size -->
    <property name="size" type="type:Size3D" value="[4, 2, 3]" />

    <!-- Base -->
    <property name="baseCutoutType" type="type:BaseCutoutType" value="standard" />
    <property name="pillars"                  type="Boolean"        value="true" />
    <property name="baseReliefCut"            type="Boolean"        value="false" />
    <property name="baseReliefCutHeight"      type="Float"          value="0.375" />
    <property name="baseReliefCutThickness"   type="Float"          value="0.375" />
    <property name="baseRoundingRadius"       type="type:RoundingRadius" value="0" />
    <property name="grille"                   type="type:GrilleType"       value="none" />
    <property name="grilleInverted" type="Boolean" value="false" />
    <property name="grilleDepth"    type="Float"   value="1" />
    <property name="grilleCount"    type="Float"   value="2.5" />
    <property name="bevel"          type="type:BevelList" value="[[0,0],[0,0],[0,0],[0,0]]" />

    <!-- Studs -->
    <property name="studs"           type="Boolean"     value="true" />
    <property name="studShift"       type="Boolean"     value="false" />
    <property name="studType"        type="type:StudType"       value="solid" />
    <property name="studPadding"     type="type:PaddingList" value="[0.2, 0.2, 0.2, 0.2]" />
    <property name="studBaseOverlap" type="Float"       value="0.25" />

    <!-- Holes -->
    <property name="holeX"            type="Boolean" value="false" />
    <property name="holeXType"        type="type:HoleType"  value="pin" />
    <property name="holeXShift"       type="Boolean" value="true" />
    <property name="holeXGridOffsetZ" type="Float"   value="3.5" />
    <property name="holeY"            type="Boolean" value="false" />
    <property name="holeYType"        type="type:HoleType"  value="pin" />
    <property name="holeYShift"       type="Boolean" value="true" />
    <property name="holeYGridOffsetZ" type="Float"   value="3.5" />
    <property name="holeZ"            type="Boolean" value="false" />
    <property name="holeZType"        type="type:HoleType"  value="pin" />
    <property name="holeZShift"       type="Boolean" value="true" />

    <!-- Recess -->
    <property name="recess"              type="Boolean"        value="false" />
    <property name="recessStuds"         type="Boolean"        value="false" />
    <property name="recessWallThickness" type="type:PaddingList"    value="[0.333, 0.333, 0.333, 0.333]" />
    <property name="recessDepth"         type="type:AutoOr_Float" value="auto" />
    <property name="recessStudPadding"   type="type:PaddingList"    value="[0.2, 0.2, 0.2, 0.2]" />

    <!-- Slope -->
    <property name="slope" type="type:SlopeList" value="[0, 0, 0, 0]" />

    <!-- Text -->
    <property name="text"      type="String"  value="" />
    <property name="textSide"  type="Integer" value="5" />
    <property name="textDepth" type="Float"   value="0.5" />
    <property name="textSize"  type="Integer" value="9" />
    <property name="textFont"  type="String"  value="RBNo3.1 Black">
      <suggestions>
        <suggestion value="Creato Display"               label="Creato Display" />
        <suggestion value="RBNo3.1 Black"                label="RBNo3.1 Black" />
        <suggestion value="Font Awesome 6 Free Regular"  label="Font Awesome Regular" />
        <suggestion value="Font Awesome 6 Free Solid"    label="Font Awesome Solid" />
      </suggestions>
    </property>
    <property name="textStyle" type="String"  value="Regular">
      <suggestions>
        <suggestion value="Regular" label="Regular" />
        <suggestion value="Bold"    label="Bold" />
        <suggestion value="Black"   label="Black" />
        <suggestion value="Light"   label="Light" />
        <suggestion value="Thin"    label="Thin" />
        <suggestion value="Medium"  label="Medium" />
      </suggestions>
    </property>
    <property name="textSpacing" type="Float" value="1" />
    <property name="textColor"   type="type:Color" value="#303D4E">
      <suggestions>
        <suggestion value="#303D4E" label="Midnight Blue" />
        <suggestion value="#EAC645" label="Sun Flower" />
        <suggestion value="#58B99D" label="Turquoise" />
        <suggestion value="#65C97A" label="Emerald" />
        <suggestion value="#5296D5" label="Peter River" />
        <suggestion value="#925CB1" label="Amethyst" />
        <suggestion value="#D65745" label="Alizarin" />
        <suggestion value="#EDF0F1" label="Clouds" />
      </suggestions>
    </property>

    <!-- Style -->
    <property name="baseColor" type="type:Color" value="#EAC645">
      <suggestions>
        <suggestion value="#EAC645" label="Sun Flower" />
        <suggestion value="#303D4E" label="Midnight Blue" />
        <suggestion value="#58B99D" label="Turquoise" />
        <suggestion value="#65C97A" label="Emerald" />
        <suggestion value="#5296D5" label="Peter River" />
        <suggestion value="#925CB1" label="Amethyst" />
        <suggestion value="#D65745" label="Alizarin" />
        <suggestion value="#EDF0F1" label="Clouds" />
      </suggestions>
    </property>
    <property name="surfacePattern"      type="String" value="none" />
    <property name="surfacePatternScale" type="Float"  value="0.2" />
    <property name="studIcon"            type="String" value="none" />

  </properties>

  <!--
    Single NativeBlock — no wrapper generated (1 child rule).
    All properties explicitly mapped — no passthrough.
    textFont and textStyle are combined by the ScadBlockProcessor:
      textFontFull = str(textFont, textStyle == "" ? "" : str(":style=", textStyle))
    recessDepth is AutoOr<Float> — ScadBlockProcessor splits into
      recessDepthAuto + recessDepth with hidden_merge.
  -->
  <composition>
    <core:NativeBlock
        size="${ size }"
        baseCutoutType="${ baseCutoutType }"
        pillars="${ pillars }"
        reliefCut="${ baseReliefCut }"
        reliefCutHeight="${ baseReliefCutHeight }"
        reliefCutThickness="${ baseReliefCutThickness }"
        baseRoundingRadius="${ baseRoundingRadius }"
        grille="${ grille }"
        grilleInverted="${ grilleInverted }"
        grilleDepth="${ grilleDepth }"
        grilleCount="${ grilleCount }"
        bevel="${ bevel }"
        studs="${ studs }"
        studShift="${ studShift }"
        studType="${ studType }"
        studPadding="${ studPadding }"
        studBaseOverlap="${ studBaseOverlap }"
        holeX="${ holeX }"
        holeXType="${ holeXType }"
        holeXShift="${ holeXShift }"
        holeXGridOffsetZ="${ holeXGridOffsetZ }"
        holeY="${ holeY }"
        holeYType="${ holeYType }"
        holeYShift="${ holeYShift }"
        holeYGridOffsetZ="${ holeYGridOffsetZ }"
        holeZ="${ holeZ }"
        holeZType="${ holeZType }"
        holeZShift="${ holeZShift }"
        recess="${ recess }"
        recessStuds="${ recessStuds }"
        recessWallThickness="${ recessWallThickness }"
        recessDepth="${ recessDepth }"
        recessStudPadding="${ recessStudPadding }"
        slope="${ slope }"
        text="${ text }"
        textSide="${ textSide }"
        textDepth="${ textDepth }"
        textSize="${ textSize }"
        textFont="${ textFont }"
        textStyle="${ textStyle }"
        textSpacing="${ textSpacing }"
        textColor="${ textColor }"
        baseColor="${ baseColor }"
        surfacePattern="${ surfacePattern }"
        surfacePatternScale="${ surfacePatternScale }"
        studIcon="${ studIcon }" />
  </composition>

</block>

<!--
  MachineBlocks.com Presets File

  Name: StandardPresets
  Filename: StandardPresets.bml
  FQN: com.machineblocks.bml.bricks.StandardPresets

  Named property presets for com.machineblocks.bml.bricks.Standard (Standard.bml).
  Presets are Block instances in presets — basePresets resolves within this Block.
  Customizer JSON output is render-target logic (machineblocks-v3-scad).
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:bricks="com.machineblocks.bml.bricks"
  xmlns:mbcore="com.machineblocks.bml.core"
  xmlns:mbt="com.machineblocks.bml.type">

  <name>StandardPresets</name>
  <type>bricks:StandardPresets</type>
  <baseType>mbcore:Block</baseType>
  <is>A named brick preset catalog</is>

  <documentation>Named property presets for the MachineBlocks Standard brick — sizes, colors, and
    composite combinations for Customizer and basePresets references.</documentation>
  <aggregations>
    <presets override="true">
      <composition>

        <bricks:Standard bml:id="brick-1x1" name="Brick 1x1" size="[1, 1, 3]" />

        <bricks:Standard bml:id="brick-2x4" name="Brick 2x4" size="[2, 4, 3]" />

        <bricks:Standard bml:id="brick-4x4" name="Brick 4x4" size="[4, 4, 3]" />

        <bricks:Standard bml:id="color-red" name="Red" baseColor="#D65745" />

        <bricks:Standard bml:id="color-blue" name="Blue" baseColor="#5296D5" />

        <bricks:Standard bml:id="color-midnight" name="Midnight Blue"
          baseColor="#303D4E" />

        <bricks:Standard bml:id="brick-1x1-red" name="Brick 1x1 Red">
          <basePresets>brick-1x1</basePresets>
          <basePresets>color-red</basePresets>
        </bricks:Standard>

        <bricks:Standard bml:id="brick-2x4-blue" name="Brick 2x4 Blue">
          <basePresets>brick-2x4</basePresets>
          <basePresets>color-blue</basePresets>
        </bricks:Standard>

        <bricks:Standard bml:id="brick-1x1-red-text"
          name="Brick 1x1 Red MB"
          basePresets="brick-1x1-red"
          text="MB"
          textColor="#EDF0F1" />

        <bricks:Standard bml:id="brick-2x4-special" name="Brick 2x4 Special" textColor="#EDF0F1">
          <basePresets>brick-2x4</basePresets>
          <basePresets>color-midnight</basePresets>
        </bricks:Standard>

      </composition>
    </presets>
  </aggregations>

</block>
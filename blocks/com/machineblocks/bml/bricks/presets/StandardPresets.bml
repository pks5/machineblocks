<!--MachineBlocks.com Presets File

  Name: StandardPresets
  Filename: StandardPresets.bml
  FQN: com.machineblocks.bml.bricks.StandardPresets

  Named property presets for com.machineblocks.bml.bricks.Standard (Standard.bml).
  Presets are Block instances in presets — basePresets resolves within this Block.
  Customizer JSON output is render-target logic (machineblocks-v3-scad).-->
<bricks:StandardPresets xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:bricks="com.machineblocks.bml.bricks"
  xmlns:mbcore="com.machineblocks.bml.core">

  <baseType>
    mbcore:Block
  </baseType>
  <is>
    A named brick preset catalog
  </is>
  <documentation>
    Named property presets for the MachineBlocks Standard brick — sizes, colors, and
    composite combinations for Customizer and basePresets references.
  </documentation>
  <aggregations>
    <presets override="true">
      <composition>
        <bricks:Standard bml:id="brick_1x1" name="Brick 1x1" size="{x:1,y:1,z:3}" />
        <bricks:Standard bml:id="brick_2x4" name="Brick 2x4" size="{x:2,y:4,z:3}" />
        <bricks:Standard bml:id="brick_4x4" name="Brick 4x4" size="{x:4,y:4,z:3}" />
        <bricks:Standard bml:id="color_red" name="Red" baseColor="#D65745" />
        <bricks:Standard bml:id="color_blue" name="Blue" baseColor="#5296D5" />
        <bricks:Standard bml:id="color_midnight" name="Midnight Blue" baseColor="#303D4E" />
        <bricks:Standard bml:id="brick_1x1_red" name="Brick 1x1 Red">
          <basePresets>brick_1x1</basePresets>
          <basePresets>color_red</basePresets>
        </bricks:Standard>
        <bricks:Standard bml:id="brick_2x4_blue" name="Brick 2x4 Blue">
          <basePresets>brick_2x4</basePresets>
          <basePresets>color_blue</basePresets>
        </bricks:Standard>
        <bricks:Standard bml:id="brick_1x1_red_text" name="Brick 1x1 Red MB" basePresets="brick_1x1_red" text="MB" textColor="#EDF0F1" />
        <bricks:Standard bml:id="brick_2x4_special" name="Brick 2x4 Special" textColor="#EDF0F1">
          <basePresets>brick_2x4</basePresets>
          <basePresets>color_midnight</basePresets>
        </bricks:Standard>
      </composition>
    </presets>
  </aggregations>
</bricks:StandardPresets>

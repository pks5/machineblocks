<block
  xmlns="http://blockml.org/schema/block"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      http://machineblocks.com/schema/core https://machineblocks.com/schemas/machineblocks/core.xsd
                      http://machineblocks.com/schema/bricks https://machineblocks.com/schemas/machineblocks/bricks.xsd
                      "
  xmlns:status="org.blockml.bml.status"
  xmlns:bricks="com.machineblocks.bml.bricks"
  xmlns:core="com.machineblocks.bml.core"
  xmlns:type="com.machineblocks.bml.type">
  <name>Standard</name>
  <type>bricks:Standard</type>
  <baseType>core:Block</baseType>
  <is>A Lego brick</is>
  <properties>

    <!-- Size -->
    <size type="type:Size3D">
      <value>[4, 2, 3]</value>
    </size>

    <!-- Base -->
    <baseCutoutType type="type:BaseCutoutType">
      <value>standard</value>
    </baseCutoutType>
    <pillars type="Boolean">
      <value>true</value>
    </pillars>
    <baseReliefCut type="Boolean">
      <value>false</value>
    </baseReliefCut>
    <baseReliefCutHeight type="Float">
      <value>0.375</value>
    </baseReliefCutHeight>
    <baseReliefCutThickness type="Float">
      <value>0.375</value>
    </baseReliefCutThickness>
    <baseRoundingRadius type="type:RoundingRadius">
      <status>Draft</status>
      <value>0</value>
    </baseRoundingRadius>
    <grille type="type:GrilleType">
      <value>none</value>
    </grille>
    <grilleInverted type="Boolean">
      <value>false</value>
    </grilleInverted>
    <grilleDepth type="Float">
      <value>1</value>
    </grilleDepth>
    <grilleCount type="Float">
      <value>2.5</value>
    </grilleCount>
    <bevel type="type:BevelList">
      <value>[[0,0],[0,0],[0,0],[0,0]]</value>
    </bevel>

    <!-- Studs -->
    <studs type="Boolean">
      <value>true</value>
    </studs>
    <studShift type="Boolean">
      <value>false</value>
    </studShift>
    <studType type="type:StudType">
      <value>solid</value>
    </studType>
    <studPadding type="type:PaddingList">
      <value>[0.2, 0.2, 0.2, 0.2]</value>
    </studPadding>
    <studBaseOverlap type="Float">
      <value>0.25</value>
    </studBaseOverlap>

    <!-- Holes -->
    <holeX type="Boolean">
      <value>false</value>
    </holeX>
    <holeXType type="type:HoleType">
      <value>pin</value>
    </holeXType>
    <holeXShift type="Boolean">
      <value>true</value>
    </holeXShift>
    <holeXGridOffsetZ type="Float">
      <value>3.5</value>
    </holeXGridOffsetZ>
    <holeY type="Boolean">
      <value>false</value>
    </holeY>
    <holeYType type="type:HoleType">
      <value>pin</value>
    </holeYType>
    <holeYShift type="Boolean">
      <value>true</value>
    </holeYShift>
    <holeYGridOffsetZ type="Float">
      <value>3.5</value>
    </holeYGridOffsetZ>
    <holeZ type="Boolean">
      <value>false</value>
    </holeZ>
    <holeZType type="type:HoleType">
      <value>pin</value>
    </holeZType>
    <holeZShift type="Boolean">
      <value>true</value>
    </holeZShift>

    <!-- Recess -->
    <recess type="Boolean">
      <value>false</value>
    </recess>
    <recessStuds type="Boolean">
      <value>false</value>
    </recessStuds>
    <recessWallThickness type="type:PaddingList">
      <value>[0.333, 0.333, 0.333, 0.333]</value>
    </recessWallThickness>
    <recessDepth type="type:AutoOr_Float">
      <value>auto</value>
    </recessDepth>
    <recessStudPadding type="type:PaddingList">
      <value>[0.2, 0.2, 0.2, 0.2]</value>
    </recessStudPadding>

    <!-- Slope -->
    <slope type="type:SlopeList">
      <value>[0, 0, 0, 0]</value>
    </slope>

    <!-- Text -->
    <text type="Text">
      <value></value>
    </text>
    <textSide type="Integer">
      <value>5</value>
    </textSide>
    <textDepth type="Float">
      <value>0.5</value>
    </textDepth>
    <textSize type="Integer">
      <value>9</value>
    </textSize>
    <textFont type="Text">
      <value>RBNo3.1 Black</value>
      <suggestions>
        <suggestion value="Creato Display" label="Creato Display" />
        <suggestion value="RBNo3.1 Black" label="RBNo3.1 Black" />
        <suggestion value="Font Awesome 6 Free Regular" label="Font Awesome Regular" />
        <suggestion value="Font Awesome 6 Free Solid" label="Font Awesome Solid" />
      </suggestions>
    </textFont>
    <textStyle type="Text">
      <value>Regular</value>
      <suggestions>
        <suggestion value="Regular" label="Regular" />
        <suggestion value="Bold" label="Bold" />
        <suggestion value="Black" label="Black" />
        <suggestion value="Light" label="Light" />
        <suggestion value="Thin" label="Thin" />
        <suggestion value="Medium" label="Medium" />
      </suggestions>
    </textStyle>
    <textSpacing type="Float">
      <value>1</value>
    </textSpacing>
    <textColor type="type:Color">
      <value>#303D4E</value>
      <suggestions>
        <suggestion value="#303D4E" label="Midnight Blue" />
        <suggestion value="#EAC645" label="Sun Flower" />
        <suggestion value="#58B99D" label="Turquoise" />
        <suggestion value="#65C97A" label="Emerald" />
        <suggestion value="#5296D5" label="Peter River" />
        <suggestion value="#925CB1" label="Amethyst" />
        <suggestion value="#D65745" label="Alizarin" />
        <suggestion value="#EDF0F1" label="Clouds" />
      </suggestions>
    </textColor>

    <!-- Style -->
    <baseColor type="type:Color">
      <value>#EAC645</value>
      <suggestions>
        <suggestion value="#EAC645" label="Sun Flower" />
        <suggestion value="#303D4E" label="Midnight Blue" />
        <suggestion value="#58B99D" label="Turquoise" />
        <suggestion value="#65C97A" label="Emerald" />
        <suggestion value="#5296D5" label="Peter River" />
        <suggestion value="#925CB1" label="Amethyst" />
        <suggestion value="#D65745" label="Alizarin" />
        <suggestion value="#EDF0F1" label="Clouds" />
      </suggestions>
    </baseColor>
    <surfacePattern type="Text">
      <value>none</value>
    </surfacePattern>
    <surfacePatternScale type="Float">
      <value>0.2</value>
    </surfacePatternScale>
    <studIcon type="Text">
      <value>none</value>
    </studIcon>

  </properties>

  <!--
    Single NativeBlock — no wrapper generated (1 child rule).
    All properties explicitly mapped — no passthrough.
    textFont and textStyle are combined by the ScadBlockProcessor:
      textFontFull = str(textFont, textStyle == "" ? "" : str(":style=", textStyle))
    recessDepth is AutoOr<Float> — ScadBlockProcessor splits into
      recessDepthAuto + recessDepth with hidden_merge.
  -->
  <composition>
    <core:NativeBlock
      size="${ size }"
      baseCutoutType="${ baseCutoutType }"
      pillars="${ pillars }"
      reliefCut="${ baseReliefCut }"
      reliefCutHeight="${ baseReliefCutHeight }"
      reliefCutThickness="${ baseReliefCutThickness }"
      baseRoundingRadius="${ baseRoundingRadius }"
      grille="${ grille }"
      grilleInverted="${ grilleInverted }"
      grilleDepth="${ grilleDepth }"
      grilleCount="${ grilleCount }"
      bevel="${ bevel }"
      studs="${ studs }"
      studShift="${ studShift }"
      studType="${ studType }"
      studPadding="${ studPadding }"
      studBaseOverlap="${ studBaseOverlap }"
      holeX="${ holeX }"
      holeXType="${ holeXType }"
      holeXShift="${ holeXShift }"
      holeXGridOffsetZ="${ holeXGridOffsetZ }"
      holeY="${ holeY }"
      holeYType="${ holeYType }"
      holeYShift="${ holeYShift }"
      holeYGridOffsetZ="${ holeYGridOffsetZ }"
      holeZ="${ holeZ }"
      holeZType="${ holeZType }"
      holeZShift="${ holeZShift }"
      recess="${ recess }"
      recessStuds="${ recessStuds }"
      recessWallThickness="${ recessWallThickness }"
      recessDepth="${ recessDepth }"
      recessStudPadding="${ recessStudPadding }"
      slope="${ slope }"
      text="${ text }"
      textSide="${ textSide }"
      textDepth="${ textDepth }"
      textSize="${ textSize }"
      textFont="${ textFont }"
      textStyle="${ textStyle }"
      textSpacing="${ textSpacing }"
      textColor="${ textColor }"
      baseColor="${ baseColor }"
      surfacePattern="${ surfacePattern }"
      surfacePatternScale="${ surfacePatternScale }"
      studIcon="${ studIcon }" />
  </composition>

</block>
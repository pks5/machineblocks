<examples:Connector xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:type="org.blockml.bml.type"
  xmlns:mbcore="com.machineblocks.bml.core"
  xmlns:examples="com.machineblocks.bml.examples"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    mbcore:CompositeBlock
  </baseType>
  <is>
    A brick composition example
  </is>
  <properties>
    <!--Grid dimensions-->
    <columns type="type:Integer">
      <value>5</value>
    </columns>
    <rows type="type:Integer">
      <value>4</value>
    </rows>
    <blockSize type="mbt:SizeXYZ">
      <value>[4,2,3]</value>
    </blockSize>
    <!--size is computed from columns, rows, blockSize.
      Computed value — references other properties of this Block.
      Cycle detection: columns, rows, blockSize have no dependencies → resolved first.-->
    <size type="mbt:SizeXYZ">
      <value>${ [blockSize.x * columns, blockSize.y * rows, blockSize.z] }</value>
    </size>
    <!--Checkerboard colors-->
    <colorA type="type:Color">
      <value>#55AB68</value>
    </colorA>
    <colorB type="type:Color">
      <value>#303D4E</value>
    </colorB>
  </properties>
  <!--Composition: columns × rows NativeBlock children as a single each over columns*rows.
    (Nested bml:container+each currently fails BML_MISSING_ID in validate despite bml:id.)
    Local x/y derived via bml:with.-->
  <aggregations>
    <_parts override="true">
      <composition>
        <mbcore:NativeBlock bml:each="i : ${ columns * rows }" bml:with="x=${ #math.floor(i / rows) },y=${ i - #math.floor(i / rows) * rows }" bml:id="brick" size="${ blockSize }" offset="${ [x * blockSize.x, y * blockSize.y, 0] }" baseColor="${ colorA }" connectors="false" />
      </composition>
    </_parts>
  </aggregations>
</examples:Connector>

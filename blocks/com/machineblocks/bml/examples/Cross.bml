<!--MachineBlocks.com Block File

  Name: Cross / Corner Brick
  Filename: Cross.bml
  FQN: com.machineblocks.bml.examples.Cross

  Copyright (c) 2022 - 2025 Jan Philipp Knoeller <pk@pksoftware.de>


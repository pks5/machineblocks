<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:type="org.blockml.bml.type"
  xmlns:unit="org.blockml.bml.unit"
  xmlns:mbcore="com.machineblocks.bml.core"
  xmlns:examples="com.machineblocks.bml.examples"
  xmlns:mbt="com.machineblocks.bml.type"
  xmlns:mbunit="com.machineblocks.bml.unit">

  <name>Cross</name>
  <type>examples:Cross</type>
  <baseType>mbcore:CompositeBlock</baseType>
  <is>An overlapping corner brick</is>
  <properties>

    <!--
      Wrapper properties.
      base=false, studs=false: the wrapper mb_block() is layout-only —
      geometry is rendered entirely by the two NativeBlock children.
    -->
    <studs type="Boolean">
      <value>true</value>
    </studs>

    <!-- Size -->
    <size type="mbt:SizeXYZ">
      <value>[4, 4, 3]</value>
    </size>

    <!-- Cross geometry -->
    <brick1SizeY type="Integer">
      <value>2</value>
      <documentation>Brick 1 size in Y-direction (grid units).</documentation>
    </brick1SizeY>
    <brick2SizeX type="Integer">
      <value>2</value>
      <documentation>Brick 2 size in X-direction (grid units).</documentation>
    </brick2SizeX>
    <brick1OffsetY type="Integer">
      <value>0</value>
      <documentation>Brick 1 offset in Y-direction (grid units).</documentation>
    </brick1OffsetY>
    <brick2OffsetX type="Integer">
      <value>0</value>
      <documentation>Brick 2 offset in X-direction (grid units).</documentation>
    </brick2OffsetX>

    <!-- Base — types aligned to NativeBlock -->
    <baseCutoutType type="mbt:BaseCutout">
      <value>Standard</value>
    </baseCutoutType>
    <pillars type="Boolean">
      <value>true</value>
    </pillars>
    <baseReliefCut type="Boolean">
      <value>false</value>
    </baseReliefCut>
    <baseReliefCutHeight type="Decimal(mbunit:MBU)">
      <value>0.4</value>
    </baseReliefCutHeight>
    <baseReliefCutThickness type="Decimal(mbunit:MBU)">
      <value>0.4</value>
    </baseReliefCutThickness>
    <grille type="mbt:Grille">
      <value>None</value>
    </grille>
    <grilleInverted type="Boolean">
      <value>false</value>
    </grilleInverted>
    <grilleDepth type="Decimal(mbunit:MBU)">
      <value>1</value>
    </grilleDepth>
    <grilleCount type="Integer">
      <value>5</value>
    </grilleCount>

    <studShift type="Boolean">
      <value>false</value>
    </studShift>
    <studType type="mbt:StudType">
      <value>Solid</value>
    </studType>
    <studPadding type="mbt:FaceMapXY(Decimal(mbunit:GridUnitXY))">
      <value>[0.2, 0.2, 0.2, 0.2]</value>
    </studPadding>
    <studBaseOverlap type="Decimal(mbunit:MBU)">
      <value>0.25</value>
    </studBaseOverlap>

    <!-- Style -->
    <baseColor type="Color">
      <value>#EAC645</value>
    </baseColor>
    <surfacePattern type="Boolean.False | FilePath">
      <value>False</value>
    </surfacePattern>
    <surfacePatternScale type="Decimal">
      <value>0.2</value>
    </surfacePatternScale>
    <studIcon type="Boolean.False | FilePath">
      <value>False</value>
    </studIcon>

  </properties>

  <!--
    Composition: 2 NativeBlock children.
    → ScadBlockProcessor generates automatic wrapper mb_block() with
      base=false, studs=false (from own properties above).

    Derived values via bml:with on <composition>:
      b1SizeY   = min(size.y, brick1SizeY)           — clamped brick1 height
      b1OffsetY = min(size.y - b1SizeY, brick1OffsetY) — clamped brick1 Y offset
      b2SizeX   = min(size.x, brick2SizeX)           — clamped brick2 width
      b2OffsetX = min(size.x - brick2SizeX, brick2OffsetX) — clamped brick2 X offset

    Note: bml:with variables are evaluated left-to-right, so b1OffsetY can
    reference b1SizeY and b2OffsetX can reference b2SizeX.

    baseWallGaps: WallGap[] — each entry is {face, pos, len}
      Brick 1 gets a gap in Y for where Brick 2 passes through.
      Brick 2 gets a gap in X for where Brick 1 passes through.
  -->
  <aggregations>

    <_parts override="true">
      <composition
        bml:with="
        b1SizeY   = ${ #math.min(size.y, brick1SizeY) },
        b1OffsetY = ${ #math.min(size.y - b1SizeY, brick1OffsetY) },
        b2SizeX   = ${ #math.min(size.x, brick2SizeX) },
        b2OffsetX = ${ #math.min(size.x - brick2SizeX, brick2OffsetX) }
      ">

        <!-- Brick 1: full X width, narrow in Y -->
        <mbcore:NativeBlock
          bml:id="brick1"
          size="${ [size.x, b1SizeY, size.z] }"
          offset="${ [0, b1OffsetY, 0] }"
          baseCutoutType="${ baseCutoutType }"
          pillars="${ pillars }"
          reliefCut="${ baseReliefCut }"
          reliefCutHeight="${ baseReliefCutHeight }"
          reliefCutThickness="${ baseReliefCutThickness }"
          grille="${ grille }"
          grilleInverted="${ grilleInverted }"
          grilleDepth="${ grilleDepth }"
          grilleCount="${ grilleCount }"
          studs="${ studs }"
          studShift="${ studShift }"
          studType="${ studType }"
          studPadding="${ studPadding }"
          studBaseOverlap="${ studBaseOverlap }"
          baseColor="${ baseColor }"
          surfacePattern="${ surfacePattern }"
          surfacePatternScale="${ surfacePatternScale }"
          studIcon="${ studIcon }"
          baseWallGaps="${ [{face: Y, pos: b2OffsetX, len: b2SizeX}] }" />

        <!-- Brick 2: narrow in X, full Y height -->
        <mbcore:NativeBlock
          bml:id="brick2"
          size="${ [b2SizeX, size.y, size.z] }"
          offset="${ [b2OffsetX, 0, 0] }"
          baseCutoutType="${ baseCutoutType }"
          pillars="${ pillars }"
          reliefCut="${ baseReliefCut }"
          reliefCutHeight="${ baseReliefCutHeight }"
          reliefCutThickness="${ baseReliefCutThickness }"
          grille="${ grille }"
          grilleInverted="${ grilleInverted }"
          grilleDepth="${ grilleDepth }"
          grilleCount="${ grilleCount }"
          studs="${ studs }"
          studShift="${ studShift }"
          studType="${ studType }"
          studPadding="${ studPadding }"
          studBaseOverlap="${ studBaseOverlap }"
          baseColor="${ baseColor }"
          surfacePattern="${ surfacePattern }"
          surfacePatternScale="${ surfacePatternScale }"
          studIcon="${ studIcon }"
          baseWallGaps="${ [{face: X, pos: b1OffsetY, len: b1SizeY}] }" />

      </composition>
    </_parts>
  </aggregations>
</block>

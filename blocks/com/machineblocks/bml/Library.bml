<!--MachineBlocks Root Library Descriptor

  Name: Library
  Filename: Library.bml
  FQN: com.machineblocks.bml.Library

  MachineBlocks root library — exports domain types, units, bricks, examples, and calibration.-->
<mb:Library xmlns="http://blockml.org/bml"
  xmlns:blockml="org.blockml.bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language"
  xmlns:mb="com.machineblocks.bml">

  <baseType>
    core:BlockLibrary
  </baseType>
  <is>
    A MachineBlocks root library
  </is>
  <version>
    3.0.0
  </version>
  <documentation>
    Publishable MachineBlocks root library (com.machineblocks.bml.Library). Groups shared domain
    ValueTypes, Units, MemberGroups (com.machineblocks.bml.group.*), ScadAnnotation, curated
    documentation blocks under com.machineblocks.bml.documentation.{concept,mbml,scad}, brick
    types (com.machineblocks.bml.bricks.*), calibration, and examples. Membership is the nearest
    Library.bml by directory, not a catalog list.
  </documentation>
  <references>
    <see type="mb:README" relation="ReadFirst">
      Human/LLM reading entry for this library.
    </see>
  </references>
  <language>
    <lang:English />
  </language>
  <properties>
    <description override="true">
      <value>MachineBlocks root library</value>
    </description>
  </properties>
  <aggregations>
    <readMe override="true">
      <composition>
        <mb:README />
      </composition>
    </readMe>
    <dependencies override="true">
      <composition>
        <blockml:Library />
      </composition>
    </dependencies>
  </aggregations>
</mb:Library>

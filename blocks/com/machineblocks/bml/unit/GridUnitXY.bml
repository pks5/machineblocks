<!--MachineBlocks — plate-grid unit in X/Y

  FQN: com.machineblocks.bml.unit.GridUnitXY-->
<mbunit:GridUnitXY xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:mbunit="com.machineblocks.bml.unit">

  <baseType>
    core:Unit
  </baseType>
  <is>
    MachineBlocks grid unit (X/Y)
  </is>
  <documentation>
    Plate-grid unit along X and Y. A 1×1 plate footprint is one GridUnitXY in each
    horizontal axis. Size in mbu via unitGridToMbu.x / unitGridToMbu.y (default 5 mbu per
    GridUnitXY). Distinct from GridUnitZ — vertical plate height uses a different mbu scale.
  </documentation>
</mbunit:GridUnitXY>

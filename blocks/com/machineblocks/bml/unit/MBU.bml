<!--MachineBlocks — MachineBlocks Unit

  FQN: com.machineblocks.bml.unit.MBU-->
<mbunit:MBU xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:mbunit="com.machineblocks.bml.unit">

  <baseType>
    core:Unit
  </baseType>
  <is>
    MachineBlocks Unit (mbu)
  </is>
  <documentation>
    Base geometric unit of the MachineBlocks system. Idealized block geometry is
    expressed in mbu; conversion to millimeters uses unitMbuToMm (default 1.6 mm per mbu).
  </documentation>
</mbunit:MBU>

<!--MachineBlocks — plate-grid unit in Z

  FQN: com.machineblocks.bml.unit.GridUnitZ-->
<mbunit:GridUnitZ xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:mbunit="com.machineblocks.bml.unit">

  <baseType>
    core:Unit
  </baseType>
  <is>
    MachineBlocks grid unit (Z)
  </is>
  <documentation>
    Plate-grid unit along Z (stack height). One plate layer is one GridUnitZ.
    Size in mbu via unitGridToMbu.z (default 2 mbu per GridUnitZ). Distinct from GridUnitXY —
    horizontal footprint uses a different mbu scale.
  </documentation>
</mbunit:GridUnitZ>

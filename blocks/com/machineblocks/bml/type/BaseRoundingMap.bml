<!--
  MachineBlocks — BaseRoundingMap struct type

  FQN: com.machineblocks.bml.type.BaseRoundingMap
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:mbt="com.machineblocks.bml.type">

  <name>BaseRoundingMap</name>
  <type>mbt:BaseRoundingMap</type>
  <baseType>mbt:AxisXYZ(Decimal | mbt:RadiusAB | mbt:CornerMap(Decimal | mbt:RadiusAB))</baseType>
  <is>A per-axis corner rounding map for the brick body</is>

  <documentation>Closed AxisXYZ(Decimal | RadiusAB | CornerMap(Decimal | RadiusAB)) for body corner rounding on
    all three brick axes. Not re-opened as a generic. Inherits x, y, z; each axis holds a
    CornerMap of unitless Decimal or RadiusAB (axis context supplies XY vs Z scale). SCAD
    serializes as the nested AxisXYZ / CornerMap form. Used by NativeBlock.baseRoundingRadius
    as the expanded alternative beside a bare Decimal broadcast.</documentation>

  <references>
    <see type="mbt:AxisXYZ" relation="Extends">
      Structural { x, y, z } map — BaseRoundingMap closes N/Z to CornerMap(Decimal | RadiusAB).
    </see>
    <see type="mbt:CornerMap" relation="SeeAlso">
      Per-corner { sw, nw, ne, se } map nested per axis.
    </see>
    <see type="mbt:RadiusAB" relation="SeeAlso">
      Per-corner anisotropic radius pair.
    </see>
    <see type="mbt:PlaneRoundingMap" relation="SeeAlso">
      Z-plane-only rounding map for recess / tongue (GridUnitXY).
    </see>
  </references>

</block>

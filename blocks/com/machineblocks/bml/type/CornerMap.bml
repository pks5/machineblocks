<!--MachineBlocks — CornerMap struct type

  FQN: com.machineblocks.bml.type.CornerMap-->
<mbt:CornerMap xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    type:StructType
  </baseType>
  <is>
    A value map on the four corners
  </is>
  <documentation>
    Struct ValueType for a corner-keyed map { sw, nw, ne, se } in the local brick
    frame. The four corners may lie on any local plane (XY, XZ, or YZ) — the plane is not part of
    the type. Generic T is the per-corner value type — any ValueType; no defaultType — bind T
    explicitly, e.g. CornerMap(Boolean) or CornerMap(Decimal(unit:Millimeter)). Short keys map to
    south-west / north-west / north-east / south-east.
  </documentation>
  <references>
    <see type="type:StructType" relation="Extends">
      Struct ValueType branch — named corner fields.
    </see>
    <see type="mbt:FaceMapXY" relation="SeeAlso">
      Face-keyed lateral map — parallel sparse map pattern.
    </see>
    <see type="mbt:Direction" relation="SeeAlso">
      Cardinal directions abbreviated in corner keys.
    </see>
  </references>
  <genericTypes>
    <T baseType="core:ValueType" />
  </genericTypes>
  <properties>
    <sw type="T">
      <documentation>
        Value at the south-west corner (sw).
      </documentation>
    </sw>
    <nw type="T">
      <documentation>
        Value at the north-west corner (nw).
      </documentation>
    </nw>
    <ne type="T">
      <documentation>
        Value at the north-east corner (ne).
      </documentation>
    </ne>
    <se type="T">
      <documentation>
        Value at the south-east corner (se).
      </documentation>
    </se>
  </properties>
</mbt:CornerMap>

<!--
  MachineBlocks — StudType enum

  FQN: com.machineblocks.bml.type.StudType
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:scad="com.machineblocks.bml.annotation.ScadAnnotation"
  xmlns:mbt="com.machineblocks.bml.type">

  <name>StudType</name>
  <type>mbt:StudType</type>
  <baseType>mbt:MBEnum(Text)</baseType>
  <is>A brick stud shape</is>

  <documentation>Enum ValueType for stud variants on MachineBlocks bricks.
    Extends MBEnum(Text). Solid is a massive stud; Hollow has a center hole.
    BOM property values store only the member id plus this EnumType;
    scad:value holds the SCAD serialization literal.</documentation>

  <aggregations>
    <values override="true">
      <composition>
        <StudType bml:id="Solid" scad:value="solid" />
        <StudType bml:id="Hollow" scad:value="hollow" />
      </composition>
    </values>
  </aggregations>

</block>

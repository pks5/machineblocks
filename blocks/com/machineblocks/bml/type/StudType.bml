<!--MachineBlocks — StudType enum

  FQN: com.machineblocks.bml.type.StudType-->
<mbt:StudType xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:scad="com.machineblocks.bml.annotation.ScadAnnotation"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    mbt:MBEnum(org.blockml.bml.type.Text)
  </baseType>
  <is>
    A brick stud shape
  </is>
  <documentation>
    Enum ValueType for stud variants on MachineBlocks bricks.
    Extends MBEnum(Text). Solid is a massive stud; Hollow has a center hole.
    BOM property values store only the member id plus this EnumType;
    scad:value holds the SCAD serialization literal.
  </documentation>
  <aggregations>
    <values override="true">
      <composition>
        <mbt:StudType bml:id="Solid" value="solid" />
        <mbt:StudType bml:id="Hollow" value="hollow" />
      </composition>
    </values>
  </aggregations>
</mbt:StudType>

<!--MachineBlocks — RotationXY struct type

  FQN: com.machineblocks.bml.type.RotationXY-->
<mbt:RotationXY xmlns="http://blockml.org/bml"
  xmlns:type="org.blockml.bml.type"
  xmlns:unit="org.blockml.bml.unit"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    mbt:AxisXY(type:Decimal(unit:Degree))
  </baseType>
  <is>
    A rotation about X and Y in degrees
  </is>
  <documentation>
    Semantic Struct ValueType for a rotation pair { x, y } in degrees. Extends
    AxisXY with N closed to Decimal(unit:Degree) — not re-opened as a generic. Rotation about
    X and Y (degrees of arc). Named RotationXY (not Rotation2D) — MachineBlocks axis-keyed
    types use XY / XYZ, not 2D / 3D.
  </documentation>
  <references>
    <see type="mbt:AxisXY" relation="Extends">
      Structural { x, y } map — RotationXY closes N to Decimal(unit:Degree).
    </see>
    <see type="mbt:RotationXYZ" relation="SeeAlso">
      Three-axis rotation map on AxisXYZ.
    </see>
    <see type="unit:Degree" relation="SeeAlso">
      Angular unit bound into N.
    </see>
  </references>
</mbt:RotationXY>

<!--MachineBlocks — FaceMapXYZ struct type

  FQN: com.machineblocks.bml.type.FaceMapXYZ-->
<mbt:FaceMapXYZ xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    mbt:FaceMapXY(T)
  </baseType>
  <is>
    A face-keyed value map on X, Y, and Z
  </is>
  <documentation>
    Struct ValueType for a sparse face map on all six faces
    { xNeg, xPos, yNeg, yPos, zNeg, zPos }. Extends FaceMapXY(T) and adds zNeg / zPos
    typed as Z. Z defaults to T (declaration-order sibling default) so FaceMapXYZ(T) keeps one
    binding; supply both when Z faces differ — e.g.
    FaceMapXYZ(Decimal(mbunit:GridUnitXY), Decimal(mbunit:GridUnitZ)).
    Preferred type for NativeBlock face maps with Z (baseAdjustment, sizeMod, …). Lateral-only
    maps use FaceMapXY. Named FaceMapXYZ (not FaceMap3D).
  </documentation>
  <references>
    <see type="mbt:FaceMapXY" relation="Extends">
      Four-face parent — xNeg, xPos, yNeg, yPos inherited; zNeg / zPos declared here.
    </see>
    <see type="mbt:Face" relation="SeeAlso">
      Face enum — six axis-directed faces (XNeg … ZPos).
    </see>
    <see type="mbt:AxisXYZ" relation="SeeAlso">
      Parallel pattern — AxisXYZ(N, Z) with Z defaulting to N.
    </see>
  </references>
  <genericTypes>
    <T baseType="core:ValueType" />
    <Z baseType="core:ValueType" defaultType="T" />
  </genericTypes>
  <properties>
    <zNeg type="Z">
      <documentation>
        Value on the Z- face (negative Z) — type Z (defaults to T).
      </documentation>
    </zNeg>
    <zPos type="Z">
      <documentation>
        Value on the Z+ face (positive Z) — type Z (defaults to T).
      </documentation>
    </zPos>
  </properties>
</mbt:FaceMapXYZ>

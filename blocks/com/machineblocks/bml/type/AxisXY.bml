<!--
  MachineBlocks — AxisXY struct type

  FQN: com.machineblocks.bml.type.AxisXY
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:mbt="com.machineblocks.bml.type">

  <name>AxisXY</name>
  <type>mbt:AxisXY</type>
  <baseType>mbt:MultiAxis(N)</baseType>
  <is>A value pair along X and Y</is>

  <documentation>Struct ValueType for axis-keyed { x, y }. Extends MultiAxis(N).
    N is any ValueType (default Decimal) — numbers, structs, enums, etc. Bare AxisXY is Decimal
    (dimensionless). Supply a unit via N — e.g. AxisXY(Decimal(unit:Millimeter)) or
    AxisXY(Integer(mbunit:MBU)).</documentation>

  <genericTypes>
    <N baseType="core:ValueType" defaultType="Decimal"/>
  </genericTypes>

  <properties>
    <x type="N">
      <documentation>Value along the X axis.</documentation>
    </x>
    <y type="N">
      <documentation>Value along the Y axis.</documentation>
    </y>
  </properties>

  <references>
    <see type="mbt:MultiAxis" relation="Extends">
      Abstract axis-map base — N.
    </see>
    <see type="mbt:AxisXYZ" relation="SeeAlso">
      Adds Z — extends this type.
    </see>
    <see type="mbt:SizeXY" relation="SeeAlso">
      Size semantics on AxisXY.
    </see>
    <see type="mbt:OffsetXY" relation="SeeAlso">
      Offset semantics on AxisXY.
    </see>
    <see type="mbt:RotationXY" relation="SeeAlso">
      Rotation semantics — AxisXY with N closed to Decimal(unit:Degree).
    </see>
  </references>

</block>

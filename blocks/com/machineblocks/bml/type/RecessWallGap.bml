<!--MachineBlocks — RecessWallGap struct type

  FQN: com.machineblocks.bml.type.RecessWallGap-->
<mbt:RecessWallGap xmlns="http://blockml.org/bml"
  xmlns:type="org.blockml.bml.type"
  xmlns:mbt="com.machineblocks.bml.type"
  xmlns:mbunit="com.machineblocks.bml.unit">

  <baseType>
    mbt:WallGap
  </baseType>
  <is>
    A recess wall opening with end padding
  </is>
  <documentation>
    Struct ValueType for a gap in a recess wall. Extends WallGap (face, pos, len)
    with padStart and padEnd — how much the opening is reduced inward from each end along the
    wall. Both default to Auto. Used where recess openings need tongue/groove-aware end insets
    beyond a plain WallGap.
  </documentation>
  <references>
    <see type="mbt:WallGap" relation="Extends">
      Base gap — face, pos, len inherited; padStart / padEnd declared here.
    </see>
    <see type="mbt:Auto" relation="SeeAlso">
      Default sentinel for padStart / padEnd.
    </see>
    <see type="mbunit:GridUnitXY" relation="SeeAlso">
      Unit on explicit Decimal pad values.
    </see>
  </references>
  <properties>
    <padStart type="mbt:Auto | type:Decimal(mbunit:GridUnitXY)">
      <documentation>
        How much the gap is reduced from the start end along the wall
        (GridUnitXY). Auto selects the default inset.
      </documentation>
      <value>Auto</value>
    </padStart>
    <padEnd type="mbt:Auto | type:Decimal(mbunit:GridUnitXY)">
      <documentation>
        How much the gap is reduced from the end along the wall
        (GridUnitXY). Auto selects the default inset.
      </documentation>
      <value>Auto</value>
    </padEnd>
  </properties>
</mbt:RecessWallGap>

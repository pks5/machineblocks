<!--
  MachineBlocks — HoleEdgeMode enum

  FQN: com.machineblocks.bml.type.HoleEdgeMode
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:scad="com.machineblocks.bml.annotation.ScadAnnotation"
  xmlns:mbt="com.machineblocks.bml.type">

  <name>HoleEdgeMode</name>
  <type>mbt:HoleEdgeMode</type>
  <baseType>mbt:MBEnum(Text)</baseType>
  <is>A hole edge application mode</is>

  <documentation>Enum ValueType for how hole-edge treatment applies along an edge —
    none / start / end / all. Extends MBEnum(Text). BOM property values store only the member id
    (None / Start / End / All) plus this EnumType; scad:value holds the SCAD serialization
    literal.</documentation>

  <aggregations>
    <values override="true">
      <composition>
        <HoleEdgeMode bml:id="None" scad:value="none" />
        <HoleEdgeMode bml:id="Start" scad:value="start" />
        <HoleEdgeMode bml:id="End" scad:value="end" />
        <HoleEdgeMode bml:id="All" scad:value="all" />
      </composition>
    </values>
  </aggregations>

  <references>
    <see type="mbt:HoleEdgePair" relation="SeeAlso">
      Two companion edges as AxisAB(HoleEdgeMode).
    </see>
    <see type="mbt:HoleEdgeMap" relation="SeeAlso">
      Per hole-axis X/Y/Z map on NativeBlock.holeXYZEdgeMode.
    </see>
  </references>

</block>

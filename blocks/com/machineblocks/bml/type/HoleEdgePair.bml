<!--MachineBlocks — HoleEdgePair struct type

  FQN: com.machineblocks.bml.type.HoleEdgePair-->
<mbt:HoleEdgePair xmlns="http://blockml.org/bml"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    mbt:AxisAB(mbt:HoleEdgeMode)
  </baseType>
  <is>
    A hole-edge mode pair on two companion edges
  </is>
  <documentation>
    Closed AxisAB(HoleEdgeMode) for one hole-axis entry's inner two companion
    edges — e.g. X-holes use [Y-edge, Z-edge]. Not re-opened as a generic. Inherits a and b;
    SCAD serializes as a 2-element array of HoleEdgeMode literals (none / start / end / all).
    Used inside HoleEdgeMap and as a top-level alternative on NativeBlock.holeXYZEdgeMode.
  </documentation>
  <references>
    <see type="mbt:AxisAB" relation="Extends">
      Structural { a, b } map — HoleEdgePair closes N/B to HoleEdgeMode.
    </see>
    <see type="mbt:HoleEdgeMode" relation="SeeAlso">
      Per-edge mode enum.
    </see>
    <see type="mbt:HoleEdgeMap" relation="SeeAlso">
      Per hole-axis (X/Y/Z) map that may nest HoleEdgePair.
    </see>
  </references>
</mbt:HoleEdgePair>

<!--MachineBlocks — FaceAxisXY enum

  FQN: com.machineblocks.bml.type.FaceAxisXY-->
<mbt:FaceAxisXY xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:scad="com.machineblocks.bml.annotation.ScadAnnotation"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    mbt:MBEnum(org.blockml.bml.type.Text)
  </baseType>
  <is>
    An XY face, axis, or both axes
  </is>
  <documentation>
    Enum ValueType for XY-directed faces (x- / x+ / y- / y+), single axes (x / y),
    and the combined XY plane on MachineBlocks bricks. Extends MBEnum(Text). BOM property values
    store only the member id plus this EnumType; scad:value holds the SCAD serialization literal.
  </documentation>
  <aggregations>
    <values override="true">
      <composition>
        <mbt:FaceAxisXY bml:id="XNeg" value="x-" />
        <mbt:FaceAxisXY bml:id="XPos" value="x+" />
        <mbt:FaceAxisXY bml:id="YNeg" value="y-" />
        <mbt:FaceAxisXY bml:id="YPos" value="y+" />
        <mbt:FaceAxisXY bml:id="X" value="x" />
        <mbt:FaceAxisXY bml:id="Y" value="y" />
        <mbt:FaceAxisXY bml:id="XY" value="xy" />
      </composition>
    </values>
  </aggregations>
</mbt:FaceAxisXY>

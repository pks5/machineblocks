<!--MachineBlocks — PortShapeType enum

  FQN: com.machineblocks.bml.type.PortShapeType-->
<mbt:PortShapeType xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:scad="com.machineblocks.bml.annotation.ScadAnnotation"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    mbt:MBEnum(org.blockml.bml.type.Text)
  </baseType>
  <is>
    A port cutout shape kind
  </is>
  <documentation>
    Enum ValueType for port shape kinds — rect / circle. Extends MBEnum(Text).
    BOM property values store only the member id (Rect / Circle) plus this EnumType;
    scad:value holds the SCAD serialization literal. Used by Port.PortShape.type.
  </documentation>
  <aggregations>
    <values override="true">
      <composition>
        <mbt:PortShapeType bml:id="Rect" value="rect" />
        <mbt:PortShapeType bml:id="Circle" value="circle" />
      </composition>
    </values>
  </aggregations>
</mbt:PortShapeType>

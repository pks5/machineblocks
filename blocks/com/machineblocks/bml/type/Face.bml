<!--MachineBlocks — Face enum

  FQN: com.machineblocks.bml.type.Face-->
<mbt:Face xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:scad="com.machineblocks.bml.annotation.ScadAnnotation"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    mbt:MBEnum(org.blockml.bml.type.Text)
  </baseType>
  <is>
    A directed face on a brick
  </is>
  <documentation>
    Enum ValueType for the six axis-directed faces on MachineBlocks bricks.
    Extends MBEnum(Text). BOM property values store only the member id plus this EnumType;
    scad:value holds the SCAD serialization literal (x- / x+ / …).
  </documentation>
  <aggregations>
    <values override="true">
      <composition>
        <mbt:Face bml:id="XNeg" value="x-" />
        <mbt:Face bml:id="XPos" value="x+" />
        <mbt:Face bml:id="YNeg" value="y-" />
        <mbt:Face bml:id="YPos" value="y+" />
        <mbt:Face bml:id="ZNeg" value="z-" />
        <mbt:Face bml:id="ZPos" value="z+" />
      </composition>
    </values>
  </aggregations>
</mbt:Face>

<!--MachineBlocks — HoleType enum

  FQN: com.machineblocks.bml.type.HoleType-->
<mbt:HoleType xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:scad="com.machineblocks.bml.annotation.ScadAnnotation"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    mbt:MBEnum(org.blockml.bml.type.Text)
  </baseType>
  <is>
    A Technic hole shape
  </is>
  <documentation>
    Enum ValueType for LEGO Technic hole shapes on MachineBlocks bricks.
    Extends MBEnum(Text). Pin is a round hole; Axle is a cross-shaped hole.
    BOM property values store only the member id plus this EnumType; scad:value holds the
    SCAD serialization literal.
  </documentation>
  <aggregations>
    <values override="true">
      <composition>
        <mbt:HoleType bml:id="Axle" value="axle" />
        <mbt:HoleType bml:id="Pin" value="pin" />
      </composition>
    </values>
  </aggregations>
</mbt:HoleType>

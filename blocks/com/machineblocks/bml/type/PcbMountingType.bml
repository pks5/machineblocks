<!--MachineBlocks — PcbMountingType enum

  FQN: com.machineblocks.bml.type.PcbMountingType-->
<mbt:PcbMountingType xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:scad="com.machineblocks.bml.annotation.ScadAnnotation"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    mbt:MBEnum(org.blockml.bml.type.Text)
  </baseType>
  <is>
    A PCB mounting mode
  </is>
  <documentation>
    Enum ValueType for PCB mounting features on MachineBlocks bricks —
    clips (clip-in frame) / sockets (screw sockets). Extends MBEnum(Text). BOM property
    values store only the member id (Clips / Sockets) plus this EnumType; scad:value holds
    the SCAD serialization literal. Used by NativeBlock.pcb as Boolean.False | PcbMountingType.
  </documentation>
  <aggregations>
    <values override="true">
      <composition>
        <mbt:PcbMountingType bml:id="Clips" value="clips" />
        <mbt:PcbMountingType bml:id="Sockets" value="sockets" />
      </composition>
    </values>
  </aggregations>
</mbt:PcbMountingType>

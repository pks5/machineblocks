<!--MachineBlocks — QualityPreset enum

  FQN: com.machineblocks.bml.type.QualityPreset-->
<mbt:QualityPreset xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:scad="com.machineblocks.bml.annotation.ScadAnnotation"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    mbt:MBEnum(org.blockml.bml.type.Text)
  </baseType>
  <is>
    A render or mesh quality preset
  </is>
  <documentation>
    Enum ValueType for quality presets — preview / normal / print / render.
    Extends MBEnum(Text). BOM property values store only the member id (Preview / Normal /
    Print / Render) plus this EnumType; scad:value holds the SCAD serialization literal.
  </documentation>
  <aggregations>
    <values override="true">
      <composition>
        <mbt:QualityPreset bml:id="Preview" value="preview" />
        <mbt:QualityPreset bml:id="Normal" value="normal" />
        <mbt:QualityPreset bml:id="Print" value="print" />
        <mbt:QualityPreset bml:id="Render" value="render" />
      </composition>
    </values>
  </aggregations>
</mbt:QualityPreset>

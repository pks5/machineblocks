<!--MachineBlocks — Auto constant sentinel

  FQN: com.machineblocks.bml.type.Auto-->
<mbt:Auto xmlns="http://blockml.org/bml"
  xmlns:type="org.blockml.bml.type"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    type:Constant(type:Text)
  </baseType>
  <is>
    The literal Auto sentinel
  </is>
  <documentation>
    Named Constant(Text) for the singleton value "Auto". Use as a union
    alternative — for example Auto | Float — instead of writing Constant(Text){value: "Auto"}
    at every reference site. The external value is "Auto" (identical to Text).
  </documentation>
  <references>
    <see type="type:Constant" relation="Extends">
      Constant(Text) with value fixed to "Auto".
    </see>
  </references>
  <properties>
    <value override="true" type="type:Text">
      <value>Auto</value>
    </value>
  </properties>
</mbt:Auto>

<!--MachineBlocks — AxisXYZ struct type

  FQN: com.machineblocks.bml.type.AxisXYZ-->
<mbt:AxisXYZ xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    mbt:AxisXY(N)
  </baseType>
  <is>
    A value triple along X, Y, and Z
  </is>
  <documentation>
    Struct ValueType for axis-keyed { x, y, z }. Extends AxisXY(N) and adds z.
    Inherits x and y typed as N. Z is a separate generic (defaultType N) so the Z component may
    differ from X/Y — e.g. AxisXYZ(Decimal(mbunit:GridUnitXY), Decimal(mbunit:GridUnitZ)).
    Bare AxisXYZ / AxisXYZ(T) binds Z to the same effective type as N. N and Z are any ValueType
    (default Decimal).
  </documentation>
  <references>
    <see type="mbt:AxisXY" relation="Extends">
      Two-axis parent — x, y inherited; z declared here.
    </see>
    <see type="mbt:MultiAxis" relation="SeeAlso">
      Abstract axis-map base — N.
    </see>
    <see type="mbt:SizeXYZ" relation="SeeAlso">
      Size semantics on AxisXYZ — N = GridUnitXY, Z = GridUnitZ by default.
    </see>
    <see type="mbt:OffsetXYZ" relation="SeeAlso">
      Offset semantics on AxisXYZ — same grid-unit defaults as SizeXYZ.
    </see>
    <see type="mbt:RotationXYZ" relation="SeeAlso">
      Rotation semantics — AxisXYZ with N (and Z via default) closed to Decimal(unit:Degree).
    </see>
  </references>
  <genericTypes>
    <N baseType="core:ValueType" defaultType="org.blockml.bml.type.Decimal" />
    <Z baseType="core:ValueType" defaultType="N" />
  </genericTypes>
  <properties>
    <z type="Z">
      <documentation>
        Value along the Z axis — type Z (defaults to N).
      </documentation>
    </z>
  </properties>
</mbt:AxisXYZ>

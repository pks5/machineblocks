<!--MachineBlocks — ScadQualityClassMinSegments struct type

  FQN: com.machineblocks.bml.type.ScadQualityClassMinSegments-->
<mbt:ScadQualityClassMinSegments xmlns="http://blockml.org/bml"
  xmlns:type="org.blockml.bml.type"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    type:StructType
  </baseType>
  <is>
    Per quality-class minimum segment counts
  </is>
  <documentation>
    Struct ValueType for OpenSCAD quality-class minimum full-circle segment counts
    { functional, visual, hidden }. Prevents small radii from becoming overly coarse. Used by
    NativeBlock.scadQualityClassMinSegments.
  </documentation>
  <references>
    <see type="type:StructType" relation="Extends">
      Struct ValueType branch — functional, visual, hidden.
    </see>
    <see type="mbt:ScadQualityClassFactors" relation="SeeAlso">
      Parallel per-class segment length multipliers.
    </see>
    <see type="mbt:ScadQualityProfile" relation="SeeAlso">
      Per-preset segment length and max segment count.
    </see>
  </references>
  <properties>
    <functional type="type:Integer">
      <documentation>
        Minimum full-circle segment count for the functional quality class.
      </documentation>
    </functional>
    <visual type="type:Integer">
      <documentation>
        Minimum full-circle segment count for the visual quality class.
      </documentation>
    </visual>
    <hidden type="type:Integer">
      <documentation>
        Minimum full-circle segment count for the hidden quality class.
      </documentation>
    </hidden>
  </properties>
</mbt:ScadQualityClassMinSegments>

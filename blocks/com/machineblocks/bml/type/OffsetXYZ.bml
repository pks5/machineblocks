<!--MachineBlocks — OffsetXYZ struct type

  FQN: com.machineblocks.bml.type.OffsetXYZ-->
<mbt:OffsetXYZ xmlns="http://blockml.org/bml"
  xmlns:type="org.blockml.bml.type"
  xmlns:mbt="com.machineblocks.bml.type"
  xmlns:mbunit="com.machineblocks.bml.unit">

  <baseType>
    mbt:AxisXYZ(N, Z)
  </baseType>
  <is>
    An offset along X, Y, and Z
  </is>
  <documentation>
    Semantic Struct ValueType for an offset triple { x, y, z }. Extends AxisXYZ(N, Z) —
    inherits x, y (N) and z (Z); adds offset / translation semantics (may be negative). N and Z are
    constrained to Number. Bare OffsetXYZ defaults N to Decimal(mbunit:GridUnitXY) and Z to
    Decimal(mbunit:GridUnitZ) — distinct plate-grid scales. Uniform override requires both
    arguments — e.g. OffsetXYZ(Decimal(unit:Millimeter), Decimal(unit:Millimeter)). Named
    OffsetXYZ (not Offset3D) — MachineBlocks axis-keyed types use XY / XYZ, not 2D / 3D.
  </documentation>
  <references>
    <see type="mbt:AxisXYZ" relation="Extends">
      Structural { x, y, z } map — OffsetXYZ adds offset semantics; forwards N and Z.
    </see>
    <see type="mbt:OffsetXY" relation="SeeAlso">
      Two-axis offset map on AxisXY.
    </see>
    <see type="mbt:SizeXYZ" relation="SeeAlso">
      Parallel size semantics on AxisXYZ.
    </see>
  </references>
  <genericTypes>
    <N baseType="type:Number" defaultType="org.blockml.bml.type.Decimal" />
    <Z baseType="type:Number" defaultType="org.blockml.bml.type.Decimal" />
  </genericTypes>
</mbt:OffsetXYZ>

<!--MachineBlocks — MultiAxis abstract struct base

  FQN: com.machineblocks.bml.type.MultiAxis-->
<mbt:MultiAxis xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:type="org.blockml.bml.type"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    type:StructType
  </baseType>
  <is>
    An axis-keyed multi-component value
  </is>
  <documentation>
    Abstract StructType base for MachineBlocks axis-keyed maps (AxisXY, AxisXYZ).
    Generic N (ValueType, default Decimal) is the per-axis value type on XY. AxisXYZ adds Z
    (ValueType, defaultType N) so the Z component may differ. Units travel with N / Z —
    e.g. AxisXY(Decimal(unit:Millimeter)), AxisXYZ(Decimal(mbunit:GridUnitXY), Decimal(mbunit:GridUnitZ)).
    Bare MultiAxis / AxisXY / AxisXYZ resolve to Decimal (dimensionless).
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="mbt:AxisXY" relation="SeeAlso">
      Two-axis map — x, y.
    </see>
    <see type="mbt:AxisXYZ" relation="SeeAlso">
      Three-axis map — x, y, z (extends AxisXY).
    </see>
  </references>
  <genericTypes>
    <N baseType="core:ValueType" defaultType="org.blockml.bml.type.Decimal" />
  </genericTypes>
</mbt:MultiAxis>

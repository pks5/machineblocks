<!--MachineBlocks — ScadQualityClassFactors struct type

  FQN: com.machineblocks.bml.type.ScadQualityClassFactors-->
<mbt:ScadQualityClassFactors xmlns="http://blockml.org/bml"
  xmlns:type="org.blockml.bml.type"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    type:StructType
  </baseType>
  <is>
    Per quality-class segment length multipliers
  </is>
  <documentation>
    Struct ValueType for OpenSCAD quality-class segment length multipliers
    { functional, visual, hidden }. Higher values reduce mesh quality and improve render
    performance. Used by NativeBlock.scadQualityClassFactors.
  </documentation>
  <references>
    <see type="type:StructType" relation="Extends">
      Struct ValueType branch — functional, visual, hidden.
    </see>
    <see type="mbt:ScadQualityProfile" relation="SeeAlso">
      Per-preset segment length and max segment count.
    </see>
  </references>
  <properties>
    <functional type="type:Decimal">
      <documentation>
        Segment length multiplier for the functional quality class.
      </documentation>
    </functional>
    <visual type="type:Decimal">
      <documentation>
        Segment length multiplier for the visual quality class.
      </documentation>
    </visual>
    <hidden type="type:Decimal">
      <documentation>
        Segment length multiplier for the hidden quality class.
      </documentation>
    </hidden>
  </properties>
</mbt:ScadQualityClassFactors>

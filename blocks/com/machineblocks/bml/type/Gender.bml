<!--MachineBlocks — Gender enum

  FQN: com.machineblocks.bml.type.Gender-->
<mbt:Gender xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:scad="com.machineblocks.bml.annotation.ScadAnnotation"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    mbt:MBEnum(org.blockml.bml.type.Text)
  </baseType>
  <is>
    A connector mating gender
  </is>
  <documentation>
    Enum ValueType for male / female connector mating. Extends MBEnum(Text).
    BOM property values store only the member id (Male / Female) plus this EnumType;
    scad:value holds the SCAD serialization literal. Used by Connector.gender.
  </documentation>
  <aggregations>
    <values override="true">
      <composition>
        <mbt:Gender bml:id="Male" value="male" />
        <mbt:Gender bml:id="Female" value="female" />
      </composition>
    </values>
  </aggregations>
</mbt:Gender>

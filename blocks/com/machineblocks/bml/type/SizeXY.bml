<!--
  MachineBlocks — SizeXY struct type

  FQN: com.machineblocks.bml.type.SizeXY
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:type="org.blockml.bml.type"
  xmlns:mbt="com.machineblocks.bml.type"
  xmlns:mbunit="com.machineblocks.bml.unit">

  <name>SizeXY</name>
  <type>mbt:SizeXY</type>
  <baseType>mbt:AxisXY(N)</baseType>
  <is>A size along X and Y</is>

  <documentation>Semantic Struct ValueType for a size pair { x, y }. Extends AxisXY(N) —
    inherits x and y; adds size semantics (extent / footprint). N is constrained to Number
    (AxisXY remains ValueType-universal). Bare SizeXY defaults N to Decimal(mbunit:GridUnitXY).
    Override via N — e.g. SizeXY(Decimal(unit:Millimeter)). Named SizeXY (not Size2D) —
    MachineBlocks axis-keyed types use XY / XYZ, not 2D / 3D.</documentation>

  <genericTypes>
    <N baseType="Number" defaultType="Decimal(mbunit:GridUnitXY)"/>
  </genericTypes>

  <references>
    <see type="mbt:AxisXY" relation="Extends">
      Structural { x, y } map — SizeXY adds size semantics.
    </see>
    <see type="mbt:SizeXYZ" relation="SeeAlso">
      Three-axis size map on AxisXYZ.
    </see>
    <see type="mbt:OffsetXY" relation="SeeAlso">
      Parallel offset semantics on AxisXY.
    </see>
  </references>

</block>

<!--MachineBlocks — Inherit constant sentinel

  FQN: com.machineblocks.bml.type.Inherit-->
<mbt:Inherit xmlns="http://blockml.org/bml"
  xmlns:type="org.blockml.bml.type"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    type:Constant(type:Text)
  </baseType>
  <is>
    The literal Inherit sentinel
  </is>
  <documentation>
    Named Constant(Text) for the singleton value "Inherit". Use as a union
    alternative — for example Inherit | Float — instead of writing Constant(Text){value: "Inherit"}
    at every reference site. The external value is "Inherit" (identical to Text). Signals that a
    property should take its effective value from the parent / surrounding context.
  </documentation>
  <references>
    <see type="type:Constant" relation="Extends">
      Constant(Text) with value fixed to "Inherit".
    </see>
    <see type="mbt:Auto" relation="SeeAlso">
      Parallel Auto sentinel Constant.
    </see>
    <see type="mbt:None" relation="SeeAlso">
      Parallel None sentinel Constant.
    </see>
  </references>
  <properties>
    <value override="true" type="type:Text">
      <value>Inherit</value>
    </value>
  </properties>
</mbt:Inherit>

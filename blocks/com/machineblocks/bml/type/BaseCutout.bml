<!--
  MachineBlocks — BaseCutout enum

  FQN: com.machineblocks.bml.type.BaseCutout
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:scad="com.machineblocks.bml.annotation.ScadAnnotation"
  xmlns:mbt="com.machineblocks.bml.type">

  <name>BaseCutout</name>
  <type>mbt:BaseCutout</type>
  <baseType>mbt:MBEnum(Text)</baseType>
  <is>An underside brick cutout shape</is>

  <documentation>Enum ValueType for base cutout variants on MachineBlocks bricks.
    Extends MBEnum(Text). BOM property values store only the member id plus this EnumType;
    scad:value holds the SCAD serialization literal.</documentation>

  <aggregations>
    <values>
      <composition>
        <BaseCutout bml:id="None" scad:value="none" />
        <BaseCutout bml:id="Standard" scad:value="standard" />
        <BaseCutout bml:id="Groove" scad:value="groove" />
        <BaseCutout bml:id="Studs" scad:value="studs" />
      </composition>
    </values>
  </aggregations>

</block>

<!--MachineBlocks — BaseCutout enum

  FQN: com.machineblocks.bml.type.BaseCutout-->
<mbt:BaseCutout xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:scad="com.machineblocks.bml.annotation.ScadAnnotation"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    mbt:MBEnum(org.blockml.bml.type.Text)
  </baseType>
  <is>
    An underside brick cutout shape
  </is>
  <documentation>
    Enum ValueType for base cutout variants on MachineBlocks bricks.
    Extends MBEnum(Text). BOM property values store only the member id plus this EnumType;
    scad:value holds the SCAD serialization literal.
  </documentation>
  <aggregations>
    <values override="true">
      <composition>
        <mbt:BaseCutout bml:id="None" value="none" />
        <mbt:BaseCutout bml:id="Standard" value="standard" />
        <mbt:BaseCutout bml:id="Groove" value="groove" />
        <mbt:BaseCutout bml:id="Studs" value="studs" />
      </composition>
    </values>
  </aggregations>
</mbt:BaseCutout>

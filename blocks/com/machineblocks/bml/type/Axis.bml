<!--MachineBlocks — Axis enum

  FQN: com.machineblocks.bml.type.Axis-->
<mbt:Axis xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:scad="com.machineblocks.bml.annotation.ScadAnnotation"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    mbt:MBEnum(org.blockml.bml.type.Text)
  </baseType>
  <is>
    A coordinate axis
  </is>
  <documentation>
    Enum ValueType for the X / Y / Z axes on MachineBlocks bricks.
    Extends MBEnum(Text). BOM property values store only the member id plus this EnumType;
    scad:value holds the SCAD serialization literal.
  </documentation>
  <aggregations>
    <values override="true">
      <composition>
        <mbt:Axis bml:id="X" value="x" />
        <mbt:Axis bml:id="Y" value="y" />
        <mbt:Axis bml:id="Z" value="z" />
      </composition>
    </values>
  </aggregations>
</mbt:Axis>

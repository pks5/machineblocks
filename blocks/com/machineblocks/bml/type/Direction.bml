<!--MachineBlocks — Direction enum

  FQN: com.machineblocks.bml.type.Direction-->
<mbt:Direction xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:scad="com.machineblocks.bml.annotation.ScadAnnotation"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    mbt:MBEnum(org.blockml.bml.type.Text)
  </baseType>
  <is>
    A cardinal direction
  </is>
  <documentation>
    Enum ValueType for west / north / east / south on MachineBlocks bricks.
    Extends MBEnum(Text). BOM property values store only the member id plus this EnumType;
    scad:value holds the SCAD serialization literal.
  </documentation>
  <aggregations>
    <values override="true">
      <composition>
        <mbt:Direction bml:id="West" value="west" />
        <mbt:Direction bml:id="North" value="north" />
        <mbt:Direction bml:id="East" value="east" />
        <mbt:Direction bml:id="South" value="south" />
      </composition>
    </values>
  </aggregations>
</mbt:Direction>

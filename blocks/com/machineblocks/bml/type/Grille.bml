<!--MachineBlocks — Grille enum

  FQN: com.machineblocks.bml.type.Grille-->
<mbt:Grille xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:scad="com.machineblocks.bml.annotation.ScadAnnotation"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    mbt:MBEnum(org.blockml.bml.type.Text)
  </baseType>
  <is>
    A top-plate grille bar direction
  </is>
  <documentation>
    Enum ValueType for grille bar orientation on MachineBlocks bricks.
    Extends MBEnum(Text). Members X / Y set bar direction; None disables the grille.
    BOM property values store only the member id plus this EnumType; scad:value holds the
    SCAD serialization literal.
  </documentation>
  <aggregations>
    <values override="true">
      <composition>
        <mbt:Grille bml:id="X" value="x" />
        <mbt:Grille bml:id="Y" value="y" />
        <mbt:Grille bml:id="None" value="none" />
      </composition>
    </values>
  </aggregations>
</mbt:Grille>

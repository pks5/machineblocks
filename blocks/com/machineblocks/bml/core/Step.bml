<!--MachineBlocks MBOM — Set assembly step

  FQN: com.machineblocks.bml.core.Step-->
<mbcore:Step xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:core="org.blockml.bml.core"
  xmlns:mbcore="com.machineblocks.bml.core"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    core:Block
  </baseType>
  <is>
    A single assembly instruction
  </is>
  <documentation>
    Framework Block defining one assembly instruction step. Document order in _steps
    defines build order.
  </documentation>
  <final>
    true
  </final>
  <references>
    <see type="mbcore:Set">
      Used as children of Set's _steps aggregation.
    </see>
    <see type="mbcore:Block">
      part association references a placed instance by bml:id in _parts.
    </see>
  </references>
  <properties>
    <description type="org.blockml.bml.type.Text">
      <documentation>
        Additional description of the step.
      </documentation>
    </description>
  </properties>
  <associations>
    <part type="org.blockml.bml.type.InstanceReference(mbcore:Block)" />
  </associations>
</mbcore:Step>

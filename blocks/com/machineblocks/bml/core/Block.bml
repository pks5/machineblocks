<!--MachineBlocks MBOM — domain base Block

  FQN: com.machineblocks.bml.core.Block-->
<mbcore:Block xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:core="org.blockml.bml.core"
  xmlns:mbcore="com.machineblocks.bml.core"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    core:Entity
  </baseType>
  <is>
    A MachineBlocks domain Block
  </is>
  <documentation>
    MachineBlocks domain base Block. Carries presets aggregation and basePresets
    association for domain-specific preset resolution. Preset merge is compiler logic; Customizer
    output is render-target logic.
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="core:Entity">
      Domain branch base — Entity instances with composition identity.
    </see>
    <see type="mbcore:CompositeBlock">
      Composable sub-type with default _parts aggregation for child block instances.
    </see>
    <see type="mbcore:NativeBlock">
      Final leaf sub-type rendered directly as mb_block() SCAD primitive.
    </see>
    <see type="mbcore:Set">
      LEGO-style build sub-type with palette, placed parts, and assembly steps.
    </see>
  </references>
  <properties>
    <name type="org.blockml.bml.type.Text">
      <documentation>
        The human readable name of the Block.
      </documentation>
    </name>
  </properties>
  <aggregations>
    <presets type="mbcore:Block[]" />
  </aggregations>
  <associations>
    <basePresets type="org.blockml.bml.type.InstanceReference(bml:Self)[]" />
  </associations>
</mbcore:Block>

<!--MachineBlocks MBOM — domain base Block

  FQN: com.machineblocks.bml.core.Block-->
<mbcore:Block xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:mbcore="com.machineblocks.bml.core">

  <baseType>
    core:Block
  </baseType>
  <is>
    A MachineBlocks domain Block
  </is>
  <documentation>
    MachineBlocks domain base Block. Carries name and the basePresets association.

    Preset catalogs are BlockPresets(T). T is the target block, and presets holds
    instances of T. basePresets on those instances resolves sibling presets in that
    catalog.

    Preset merge is compiler logic. The render target writes customizer JSON under
    the manifestation filename of T.
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="core:Block">
      Framework inheritance root — domain Blocks extend Block.
    </see>
    <see type="mbcore:CompositeBlock">
      Composable sub-type with default _parts aggregation for child block instances.
    </see>
    <see type="mbcore:ConfigProfile">
      Config-conventional parameter surface. NativeBlock extends it. ConfigSet
      profiles are instances of this type.
    </see>
    <see type="mbcore:ConfigSet">
      Collection of ConfigProfile values. The SCAD customizer selects one profile.
    </see>
    <see type="mbcore:NativeBlock">
      Final leaf sub-type rendered directly as mb_block() SCAD primitive. Inherits ConfigProfile.
    </see>
    <see type="mbcore:Set">
      LEGO-style build sub-type with placed parts and assembly steps.
    </see>
    <see type="mbcore:BlockPresets">
      Preset catalog. Closes generic T on the target block; presets is T[].
    </see>
  </references>
  <properties>
    <name type="org.blockml.bml.type.Text">
      <documentation>
        The human readable name of the Block.
      </documentation>
    </name>
  </properties>
  <associations>
    <basePresets type="org.blockml.bml.type.InstanceReference(bml:Self)[]" />
  </associations>
</mbcore:Block>

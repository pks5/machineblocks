<!--
  MachineBlocks MBOM — NativeBlock (mb_block primitive)

  FQN: com.machineblocks.bml.core.NativeBlock
  Final — cannot be used as baseType on Block definitions

  SSOT for all MachineBlocks MBML / SCAD parameters: property set, types, docs,
  defaults, and scad:value literals. Type shapes SSOT: com.machineblocks.bml.type.*
  (Library.bml membership). Markdown / YAML / scad-lib docs must follow this BML —
  they must not redefine the parameter inventory.
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:type="org.blockml.bml.type"
  xmlns:unit="org.blockml.bml.unit"
  xmlns:scad="com.machineblocks.bml.annotation.ScadAnnotation"
  xmlns:mbcore="com.machineblocks.bml.core"
  xmlns:mbt="com.machineblocks.bml.type"
  xmlns:mbunit="com.machineblocks.bml.unit"
  xmlns:mbgroup="com.machineblocks.bml.group">

  <name>NativeBlock</name>
  <type>mbcore:NativeBlock</type>
  <baseType>mbcore:Block</baseType>
  <is>A leaf geometry Block</is>

  <documentation>Final leaf Block mapped directly to SCAD mb_block() — the native geometry primitive
    at render time. Uses children aggregation for mb_block() sub-geometry instead of _parts.

    Sole SSOT for MachineBlocks (MB) native parameters: names, types, documentation, defaults,
    and scad:value live only here. Markdown, YAML (09_mbom_properties.yml, 09_api_parameters.yml),
    and scad-lib docs must follow this file — align to it or link only; never redefine the inventory.

    Type shapes SSOT: com.machineblocks.bml.type.* (Library.bml membership). Extend types there;
    do not invent parallel type tables in Markdown/YAML.
  </documentation>

  <references>
    <see type="mbcore:Block">
      Extends Block directly — not CompositeBlock.
    </see>
    <see type="mbcore:CompositeBlock">
      Contrasts with CompositeBlock which uses _parts for composition children.
    </see>
  </references>

  <final>true</final>

  <!-- Native MB properties — sole inventory for mb_block() / MBML parameters (SSOT) -->
  <properties>
    <align type="mbt:Align | mbt:AxisXYZ(mbt:Align)">
      <groups>
        <mbgroup:Positioning />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Alignment relative to the origin, per brick axis.
        Scalar Align broadcasts to X/Y/Z; AxisXYZ(Align) sets each axis.
        "start" = toward x-/y-/z-, "end" = toward x+/y+/z+.
        Origin is [0,0,0] globally, or defined by parent's alignChildren.
        Alignment is based strictly on the bounding box.
        Contrast: face-local anchors (e.g. Port.align) use Align | AxisAB(Align),
        not AxisXYZ — see Align / Port type docs.
      </documentation>
      <changelog>
        <change version="3.0.0">mb_param_align() now always resolves to a 3-element array.</change>
      </changelog>
      <value>Start</value>
      <scad:value>start</scad:value>
      <examples>
        <example language="BML" snippet="true" title="center">
          <![CDATA[
<NativeBlock align="Center" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="center">
          <![CDATA[
          ...
          ["align", "center"]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="per-axis">
          <![CDATA[
<NativeBlock align="{x: Start, y: Center, z: End}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="per-axis">
          <![CDATA[
          ...
          ["align", ["start", "center", "end"]]
          ...
          ]]>
        </scad:example>
      </examples>
    </align>

    <alignChildren type="mbt:Align | mbt:AxisXYZ(mbt:Align)">
      <groups>
        <mbgroup:Positioning />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Defines the origin inside a parent brick for child positioning.
        Same convention as align (Align | AxisXYZ(Align) in brick space).
        Children use this as their reference point.
      </documentation>
      <changelog>
        <change version="3.0.0">mb_param_alignChildren() now always resolves to a 3-element array.</change>
      </changelog>
      <value>Start</value>
      <scad:value>start</scad:value>
      <examples>
        <example language="BML" snippet="true" title="center">
          <![CDATA[
<NativeBlock alignChildren="Center" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="center">
          <![CDATA[
          ...
          ["alignChildren", "center"]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="per-axis">
          <![CDATA[
<NativeBlock alignChildren="{x: Start, y: Center, z: End}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="per-axis">
          <![CDATA[
          ...
          ["alignChildren", ["start", "center", "end"]]
          ...
          ]]>
        </scad:example>
      </examples>
    </alignChildren>

    <base type="Boolean">
      <groups>
        <mbgroup:Body />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Whether the base body is drawn. Purely visual — no effect on
        bounding box, align, size, or calculations. Other features (studs,
        text, etc.) are controlled separately.
      </documentation>
      <value>true</value>
      <scad:value>true</scad:value>
      <examples>
        <example language="BML" snippet="true" title="hidden">
          <![CDATA[
<NativeBlock base="false" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="hidden">
          <![CDATA[
          ...
          ["base", false]
          ...
          ]]>
        </scad:example>
      </examples>
    </base>

    <baseAdjustment type="mbt:FaceMapXYZ(Decimal(unit:Millimeter))">
      <groups>
        <mbgroup:Calibration />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <documentation>Per-side calibration adjustment in mm. Extends or reduces specific sides
        of a block. Never scales with the scale parameter.

        PRIMARY PURPOSE — Per-side fine-tuning:
        While sizeAdjustment provides global calibration, baseAdjustment
        allows per-side overrides including z- and z+ (which sizeAdjustment
        cannot address individually).

        z- SPECIAL BEHAVIOUR: A z- value does not reduce block height from below.
        Instead it shifts the brick downward by the z- amount (independent of
        offset), and extends z+ by the same amount. This means the brick gains
        a downward protrusion while the top side expands correspondingly.
        Same applies to sizeMod z-.

        Difference to sizeMod: baseAdjustment is for printer calibration and
        gap closing in composite blocks. sizeMod is a semantic geometry change.

        IN CONFIG — typically empty or used for global z+/z- adjustments.

        IN COMPOSITE BLOCKS — use namespaced entries to pass side-specific
        adjustments to child composite blocks. The child uses mb_params_filter()
        to extract its namespace:
        // In outer block:
        ["baseAdjustment", [["pbx.x+", 0.01], ["pty.z+", 0.1]]]
        // In inner composite block (pbx part):
        ["baseAdjustment", mb_params_filter(baseAdjustment, "pbx")]
        // Result: [["x+", 0.01]]

        mb_params_filter(param, namespace, overrides?):
        Filters a pseudo-map by namespace prefix, removes the prefix from keys.
        Ignores entries without a namespace and entries with numeric keys.
        Optional third argument applies fixed overrides after filtering.
        Universal — can be applied to any [[string, value]] pseudo-map parameter.
      </documentation>
      <changelog>
        <change version="3.0.0">Renamed from baseSideAdjustment. Format changed from
          float/2-element/
          4-element array to pseudo-map [[side, value]] format. Now supports all
          6 sides (including z-) and namespace-prefixed keys for composite patterns.
          z- now has a special downward-shift behaviour (not a plain height reduction).
          Default changed from -0.1 to [] (empty).
        </change>
      </changelog>
      <value>{xNeg: 0, xPos: 0, yNeg: 0, yPos: 0, zNeg: 0, zPos: 0}</value>
      <scad:value>[0, 0, 0, 0, 0, 0]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="xy face calibration">
          <![CDATA[
<NativeBlock baseAdjustment="{xNeg: 0.05, xPos: 0.05, yNeg: -0.02, yPos: -0.02, zNeg: 0, zPos: 0}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="xy face calibration">
          <![CDATA[
          ...
          ["baseAdjustment", [0.05, 0.05, -0.02, -0.02, 0, 0]]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="z-plus tweak">
          <![CDATA[
<NativeBlock baseAdjustment="{xNeg: 0, xPos: 0, yNeg: 0, yPos: 0, zNeg: 0, zPos: 0.1}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="z-plus tweak">
          <![CDATA[
          ...
          ["baseAdjustment", [0, 0, 0, 0, 0, 0.1]]
          ...
          ]]>
        </scad:example>
      </examples>
    </baseAdjustment>

    <baseClampHeight type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:BaseClamp />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Height of the base clamp lip.</documentation>
      <value>0.5</value>
      <scad:value>0.5</scad:value>
      <examples>
        <example language="BML" snippet="true" title="taller lip">
          <![CDATA[
<NativeBlock baseClampHeight="0.6" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="taller lip">
          <![CDATA[
          ...
          ["baseClampHeight", 0.6]
          ...
          ]]>
        </scad:example>
      </examples>
    </baseClampHeight>

    <baseClampOffset type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:BaseClamp />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Distance from the bottom edge of the block to the base clamp lip.
        The base clamp is a small lip on the inner wall of the underside
        opening, around tubes, and in stud holes (baseCutoutType=studs)
        that increases clamping force.
      </documentation>
      <value>0.25</value>
      <scad:value>0.25</scad:value>
      <examples>
        <example language="BML" snippet="true" title="raised">
          <![CDATA[
<NativeBlock baseClampOffset="0.375" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="raised">
          <![CDATA[
          ...
          ["baseClampOffset", 0.375]
          ...
          ]]>
        </scad:example>
      </examples>
    </baseClampOffset>

    <baseClampOuter type="Boolean">
      <groups>
        <mbgroup:BaseClamp />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Whether a clamp lip is also placed on the outer side of the block.
        Not useful for normal bricks. Useful in composite blocks where an
        outer surface of a sub-brick becomes an inner surface in the
        overall block.
      </documentation>
      <value>false</value>
      <scad:value>false</scad:value>
      <examples>
        <example language="BML" snippet="true" title="outer">
          <![CDATA[
<NativeBlock baseClampOuter="true" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="outer">
          <![CDATA[
          ...
          ["baseClampOuter", true]
          ...
          ]]>
        </scad:example>
      </examples>
    </baseClampOuter>

    <baseClampThickness type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:BaseClamp />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Thickness of the base clamp lip.</documentation>
      <value>0.1</value>
      <scad:value>0.1</scad:value>
      <examples>
        <example language="BML" snippet="true" title="thicker">
          <![CDATA[
<NativeBlock baseClampThickness="0.2" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="thicker">
          <![CDATA[
          ...
          ["baseClampThickness", 0.2]
          ...
          ]]>
        </scad:example>
      </examples>
    </baseClampThickness>

    <baseColor type="Color">
      <groups>
        <mbgroup:Body />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Color of the brick body, studs, and all other parts.
        Does NOT apply to text (use textColor separately).
      </documentation>
      <value>#EAC645</value>
      <scad:value>"#EAC645"</scad:value>
      <examples>
        <example language="BML" snippet="true" title="yellow">
          <![CDATA[
<NativeBlock baseColor="#EAC645" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="yellow">
          <![CDATA[
          ...
          ["baseColor", "#EAC645"]
          ...
          ]]>
        </scad:example>
      </examples>
    </baseColor>

    <baseCrop type="mbt:FaceMapXYZ(Decimal(mbunit:GridUnitXY), Decimal(mbunit:GridUnitZ))">
      <groups>
        <mbgroup:CoreGeometry />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Hard cut or extension per side (all six faces: x±, y±, z±).
        Positive = cut geometry, negative = extend geometry.
        The cut is applied brutally — without regard to grid compatibility,
        walls, tubes, or other structural features.
        Does NOT affect bounding box or positioning.
        For semantic size modification that keeps the brick structurally intact,
        use sizeMod instead. baseCrop is intended for cross-sections, screenshots,
        or helper bricks — not for normal size adjustment.
        Same functionality as crop in V2, renamed only.
      </documentation>
      <since>3.0.0</since>
      <value>{xNeg: 0, xPos: 0, yNeg: 0, yPos: 0, zNeg: 0, zPos: 0}</value>
      <scad:value>[0, 0, 0, 0, 0, 0]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="crop sides">
          <![CDATA[
<NativeBlock baseCrop="{xNeg: 0.5, xPos: 0.5, yNeg: 0, yPos: 0, zNeg: 0, zPos: 0}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="crop sides">
          <![CDATA[
          ...
          ["baseCrop", [0.5, 0.5, 0, 0, 0, 0]]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="cross-section">
          <![CDATA[
<NativeBlock baseCrop="{xNeg: 0, xPos: 0, yNeg: 0, yPos: 0, zNeg: 0, zPos: 1}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="cross-section">
          <![CDATA[
          ...
          ["baseCrop", [0, 0, 0, 0, 0, 1]]
          ...
          ]]>
        </scad:example>
      </examples>
    </baseCrop>

    <baseCutoutMaxDepth type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:Underside />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Maximum depth of the underside opening (baseCutoutType=standard only).
        Default 5 mbu ≈ 8 mm. Limits underside depth; if the limit applies,
        the topPlateHeight grows accordingly. When recess is defined, the
        baseCutoutDepth shrinks to the minimum (1 mbu) and topPlateHeight
        shrinks to its minimum value.
      </documentation>
      <value>5</value>
      <scad:value>5</scad:value>
      <examples>
        <example language="BML" snippet="true" title="deeper">
          <![CDATA[
<NativeBlock baseCutoutMaxDepth="6" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="deeper">
          <![CDATA[
          ...
          ["baseCutoutMaxDepth", 6]
          ...
          ]]>
        </scad:example>
      </examples>
    </baseCutoutMaxDepth>

    <baseCutoutType type="mbt:BaseCutout">
      <groups>
        <mbgroup:Underside />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Type of underside opening.
        standard: Classic LEGO underside with tubes/pins.
        studs: Alternative with only stud holes, no tube structure.
        Grid-compatible but only fits exactly on studs.
        groove: Counterpart to tongue — a groove that the tongue fits into.
        none: Solid underside, no opening. For solid structures in composite
        blocks, e.g. embedded blocks without their own underside.
      </documentation>
      <value>Standard</value>
      <scad:value>standard</scad:value>
      <examples>
        <example language="BML" snippet="true" title="Solid block without underside cutout">
          <![CDATA[
<NativeBlock baseCutoutType="None" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="Solid block without underside cutout">
          <![CDATA[
          ...
          ["baseCutoutType", "none"]
          ...
          ]]>
        </scad:example>
      </examples>
    </baseCutoutType>

    <baseRoundingRadius type="Decimal | mbt:RadiusAB | mbt:BaseRoundingMap">
      <groups>
        <mbgroup:Rounding />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Rounding radius of the block corners. Unlike recessRoundingRadius /
        tongueRoundingRadius (Z-plane / horizontal corners only via PlaneRoundingMap), this
        parameter defines radii along all three brick axes via BaseRoundingMap
        (AxisXYZ(Decimal | RadiusAB | CornerMap(Decimal | RadiusAB))). Because the three axes use different scales
        (XY grid vs Z plate height), component values stay unitless Decimal | RadiusAB — the
        axis context supplies the physical meaning.

        Authored forms (combinable inside BaseRoundingMap):
        • Decimal — same radius on all axes and corners
        • RadiusAB — same anisotropic {a,b} on all axes and corners
        • BaseRoundingMap — per axis: Decimal | RadiusAB | CornerMap; per corner: Decimal | RadiusAB
      </documentation>
      <value>0.0</value>
      <scad:value>0.0</scad:value>
      <examples>
        <example language="BML" snippet="true" title="uniform">
          <![CDATA[
<NativeBlock baseRoundingRadius="5" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="uniform">
          <![CDATA[
          ...
          ["baseRoundingRadius", 5]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="anisotropic">
          <![CDATA[
<NativeBlock baseRoundingRadius="{a: 3, b: 2}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="anisotropic">
          <![CDATA[
          ...
          ["baseRoundingRadius", [[3, 2], [3, 2], [3, 2]]]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="per-axis mix">
          <![CDATA[
<NativeBlock baseRoundingRadius="{x: {sw: 2, nw: {a: 3, b: 2}}, y: 0, z: {a: 1, b: 4}}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="per-axis mix">
          <![CDATA[
          ...
          ["baseRoundingRadius", [[2, [3, 2], 0, 0], 0, [1, 4]]]
          ...
          ]]>
        </scad:example>
      </examples>
    </baseRoundingRadius>

    <baseWallGaps type="mbt:WallGap[]">
      <groups>
        <mbgroup:Underside />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Gaps in the underside wall (baseCutoutType=standard).
        Used to restore grid compatibility in composite blocks where blocks cross.
        Replaces baseWallGapsX and baseWallGapsY from V2.
        Each entry specifies one side, a position, and optionally a length.
        To open both sides at a position, add two separate entries.
      </documentation>
      <since>3.0.0</since>
      <value>[]</value>
      <scad:value>[]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="faces">
          <![CDATA[
<NativeBlock baseWallGaps="[{face: XNeg, pos: 1, len: 2}, {face: YPos, pos: 0, len: 1}]" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="faces">
          <![CDATA[
          ...
          ["baseWallGaps", [["x-", 1, 2], ["y+", 0, 1]]]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="axes">
          <![CDATA[
<NativeBlock baseWallGaps="[{face: X, pos: 1, len: 2}, {face: Y, pos: 0, len: 1}]" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="axes">
          <![CDATA[
          ...
          ["baseWallGaps", [["x", 1, 2], ["y", 0, 1]]]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="xy">
          <![CDATA[
<NativeBlock baseWallGaps="[{face: XY, pos: 2, len: 1}]" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="xy">
          <![CDATA[
          ...
          ["baseWallGaps", [["xy", 2, 1]]]
          ...
          ]]>
        </scad:example>
      </examples>
    </baseWallGaps>

    <baseWallThickness type="mbt:Auto | Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:Underside />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Wall thickness of the underside opening (baseCutoutType=standard).
        Automatically calculated. Usually does not need adjustment.
      </documentation>
      <value>Auto</value>
      <scad:value>auto</scad:value>
      <examples>
        <example language="BML" snippet="true" title="explicit">
          <![CDATA[
<NativeBlock baseWallThickness="1.1" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="explicit">
          <![CDATA[
          ...
          ["baseWallThickness", 1.1]
          ...
          ]]>
        </scad:example>
      </examples>
    </baseWallThickness>

    <baseWallThicknessAdjustment type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:Underside />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <documentation>Calibration adjustment for baseWallThickness.
        Only for calibration. Not for AI in settings.
      </documentation>
      <value>-0.1</value>
      <scad:value>-0.1</scad:value>
      <examples>
        <example language="BML" snippet="true" title="tighter">
          <![CDATA[
<NativeBlock baseWallThicknessAdjustment="-0.2" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="tighter">
          <![CDATA[
          ...
          ["baseWallThicknessAdjustment", -0.2]
          ...
          ]]>
        </scad:example>
      </examples>
    </baseWallThicknessAdjustment>

    <bevel type="mbt:Bevel">
      <groups>
        <mbgroup:CoreGeometry />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Creates wedges by shifting corners on the horizontal (Z-face) plane
        only — Bevel = CornerMap(OffsetXY) in GridUnitXY, not a multi-axis map like
        baseRoundingRadius. Each of the four local corners (sw / nw / ne / se) gets an XY
        displacement. World XY (not AxisAB) is intentional: the plane is fixed to the brick
        Z-face. The resulting shape is intersected with the bounding box. Can be used
        together with slope.
      </documentation>
      <changelog>
        <change version="3.0.0">Can now be combined with slope.</change>
      </changelog>
      <value>
        {
        sw: {x: 0, y: 0},
        nw: {x: 0, y: 0},
        ne: {x: 0, y: 0},
        se: {x: 0, y: 0}
        }
      </value>
      <scad:value>
        [
        [0,0],
        [0,0],
        [0,0],
        [0,0]
        ]
      </scad:value>
      <examples>
        <example language="BML" snippet="true" title="corner shift">
          <![CDATA[
<NativeBlock bevel="{sw: {x: 0, y: 0}, nw: {x: 0, y: 0}, ne: {x: 1, y: 0}, se: {x: 1, y: 0}}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="corner shift">
          <![CDATA[
          ...
          ["bevel", [[0, 0], [0, 0], [1, 0], [1, 0]]]
          ...
          ]]>
        </scad:example>
      </examples>
    </bevel>

    <connectorDepth type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:Connectors />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>How far the connector triangles protrude.</documentation>
      <value>0.75</value>
      <scad:value>0.75</scad:value>
      <examples>
        <example language="BML" snippet="true" title="deeper">
          <![CDATA[
<NativeBlock connectorDepth="0.875" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="deeper">
          <![CDATA[
          ...
          ["connectorDepth", 0.875]
          ...
          ]]>
        </scad:example>
      </examples>
    </connectorDepth>

    <connectorLength type="mbt:Auto | Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:Connectors />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Length of the connector run on the face. At "auto" equals the
        available space (brick height for x/y faces, width/depth for z faces).
      </documentation>
      <since>3.0.0</since>
      <value>Auto</value>
      <scad:value>auto</scad:value>
      <examples>
        <example language="BML" snippet="true" title="explicit">
          <![CDATA[
<NativeBlock connectorLength="2" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="explicit">
          <![CDATA[
          ...
          ["connectorLength", 2]
          ...
          ]]>
        </scad:example>
      </examples>
    </connectorLength>

    <connectorLengthClearance type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:Connectors />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Clearance of the recess depth relative to the triangle depth.
        Ensures male and female connectors fit together.
      </documentation>
      <since>3.0.0</since>
      <value>0.2</value>
      <scad:value>0.2</scad:value>
      <examples>
        <example language="BML" snippet="true" title="more clearance">
          <![CDATA[
<NativeBlock connectorLengthClearance="0.3" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="more clearance">
          <![CDATA[
          ...
          ["connectorLengthClearance", 0.3]
          ...
          ]]>
        </scad:example>
      </examples>
    </connectorLengthClearance>

    <connectorSideClearance type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:Connectors />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Clearance of the recess width relative to the triangle width.
        Ensures male and female connectors fit together.
      </documentation>
      <since>3.0.0</since>
      <value>0.1</value>
      <scad:value>0.1</scad:value>
      <examples>
        <example language="BML" snippet="true" title="more clearance">
          <![CDATA[
<NativeBlock connectorSideClearance="0.2" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="more clearance">
          <![CDATA[
          ...
          ["connectorSideClearance", 0.2]
          ...
          ]]>
        </scad:example>
      </examples>
    </connectorSideClearance>

    <connectorWidth type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:Connectors />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Width of the connector triangles.</documentation>
      <value>2.25</value>
      <scad:value>2.25</scad:value>
      <examples>
        <example language="BML" snippet="true" title="wider">
          <![CDATA[
<NativeBlock connectorWidth="2" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="wider">
          <![CDATA[
          ...
          ["connectorWidth", 2]
          ...
          ]]>
        </scad:example>
      </examples>
    </connectorWidth>

    <connectors type="Boolean.False | mbt:Connector[]">
      <groups>
        <mbgroup:Connectors />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Side connection system using triangular wedges. Alternative to tongue/groove.
        Enables side-by-side (0°) and angled (90°) connections.
        Padding skips connectors at start/end — important when connecting
        bricks of different sizes.
      </documentation>
      <changelog>
        <change version="3.0.0">Completely new format: [face, direction, gender, align?,
          padStart?, padEnd?]
          per connector. The old [[side, arrangement]] format is no longer valid.
          Padding is now per-connector; the separate connectorPadding parameter is removed.
        </change>
      </changelog>
      <value>false</value>
      <scad:value>false</scad:value>
      <examples>
        <example language="BML" snippet="true" title="basic">
          <![CDATA[
<NativeBlock connectors="[{face: XPos, axis: Y, gender: Male}]" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="basic">
          <![CDATA[
          ...
          ["connectors", [["x+", "y", "male"]]]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="with padding">
          <![CDATA[
<NativeBlock connectors="[{face: XPos, axis: Y, gender: Male, align: Center, padStart: 1, padEnd: 1}]" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="with padding">
          <![CDATA[
          ...
          ["connectors", [["x+", "y", "male", "center", 1, 1]]]
          ...
          ]]>
        </scad:example>
      </examples>
    </connectors>


    <debug type="Boolean">
      <groups>
        <mbgroup:System />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Enables debug output to the console. Has no effect on geometry.
        Used for development and troubleshooting.
      </documentation>
      <since>3.0.0</since>
      <value>false</value>
      <scad:value>false</scad:value>
      <examples>
        <example language="BML" snippet="true" title="on">
          <![CDATA[
<NativeBlock debug="true" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="on">
          <![CDATA[
          ...
          ["debug", true]
          ...
          ]]>
        </scad:example>
      </examples>
    </debug>

    <debugShowOnly type="Text">
      <groups>
        <mbgroup:System />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Debug-only filter. When set to a string, only that part of the block
        is shown (e.g. "studs"), all other geometry is hidden. Has no effect
        on geometry semantics — for debugging/inspection only.
      </documentation>
      <since>3.0.0</since>
      <examples>
        <example language="BML" snippet="true" title="not set">
          <![CDATA[
<NativeBlock />  <!-- debugShowOnly is not set — omit the property -->
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="not set">
          <![CDATA[
          ...
          ["debugShowOnly", undef]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="filter studs">
          <![CDATA[
<NativeBlock debugShowOnly="studs" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="filter studs">
          <![CDATA[
          ...
          ["debugShowOnly", "studs"]
          ...
          ]]>
        </scad:example>
      </examples>
    </debugShowOnly>

    <direction type="mbt:Direction">
      <groups>
        <mbgroup:Positioning />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Semantic grid-aligned rotation. Applied before align.
        west=0°, north=90°, east=180°, south=270° (clockwise).
        All internal values (size, side numbering, etc.) always refer to
        "west" orientation. Direction only changes placement/display.
        Before align is applied the brick is centered on its body center.
      </documentation>
      <value>West</value>
      <scad:value>west</scad:value>
      <examples>
        <example language="BML" snippet="true" title="north">
          <![CDATA[
<NativeBlock direction="North" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="north">
          <![CDATA[
          ...
          ["direction", "north"]
          ...
          ]]>
        </scad:example>
      </examples>
    </direction>

    <grille type="mbt:Grille">
      <groups>
        <mbgroup:Grille />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Whether the top plate is rendered as a grille with regular openings.
        "x" or "y" defines the direction of the grille bars.
      </documentation>
      <value>None</value>
      <scad:value>none</scad:value>
      <examples>
        <example language="BML" snippet="true" title="x bars">
          <![CDATA[
<NativeBlock grille="X" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="x bars">
          <![CDATA[
          ...
          ["grille", "x"]
          ...
          ]]>
        </scad:example>
      </examples>
    </grille>

    <grilleCount type="Integer">
      <groups>
        <mbgroup:Grille />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Number of grille bars across the entire surface.</documentation>
      <value>5</value>
      <scad:value>5</scad:value>
      <examples>
        <example language="BML" snippet="true" title="three">
          <![CDATA[
<NativeBlock grilleCount="3" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="three">
          <![CDATA[
          ...
          ["grilleCount", 3]
          ...
          ]]>
        </scad:example>
      </examples>
    </grilleCount>

    <grilleDepth type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:Grille />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Depth of the grille openings.</documentation>
      <value>1</value>
      <scad:value>1</scad:value>
      <examples>
        <example language="BML" snippet="true" title="deeper">
          <![CDATA[
<NativeBlock grilleDepth="1.25" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="deeper">
          <![CDATA[
          ...
          ["grilleDepth", 1.25]
          ...
          ]]>
        </scad:example>
      </examples>
    </grilleDepth>

    <grilleInverted type="Boolean">
      <groups>
        <mbgroup:Grille />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Whether the grille starts with an opening instead of a solid bar.</documentation>
      <value>false</value>
      <scad:value>false</scad:value>
      <examples>
        <example language="BML" snippet="true" title="inverted">
          <![CDATA[
<NativeBlock grilleInverted="true" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="inverted">
          <![CDATA[
          ...
          ["grilleInverted", true]
          ...
          ]]>
        </scad:example>
      </examples>
    </grilleInverted>

    <holeX type="Boolean">
      <groups>
        <mbgroup:TechnicHolesX />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Whether LEGO Technic holes are drawn along the X-axis.
        Multiple rows possible depending on block height. Use holeXAreas for per-region
        overrides; later areas win on overlap.
      </documentation>
      <value>false</value>
      <scad:value>false</scad:value>
      <examples>
        <example language="BML" snippet="true" title="enabled">
          <![CDATA[
<NativeBlock holeX="true" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="enabled">
          <![CDATA[
          ...
          ["holeX", true]
          ...
          ]]>
        </scad:example>
      </examples>
    </holeX>

    <holeXAreas type="mbt:SelectiveGrid(Boolean | mbt:HoleType)[]">
      <groups>
        <mbgroup:TechnicHolesX />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Per-region overrides for holeX on the plate grid. Each entry is an inclusive
        rectangular range (start/end in GridUnitXY) with a Boolean or HoleType value. Later entries
        win on overlap.
      </documentation>
      <value>[]</value>
      <scad:value>[]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="one area">
          <![CDATA[
<NativeBlock holeX="true" holeXAreas="[{start:{x:0,y:0}, end:{x:1,y:1}, value:false}]" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="one area">
          <![CDATA[
          ...
          ["holeX", true],
          ["holeXAreas", [[[0,0],[1,1],false]]]
          ...
          ]]>
        </scad:example>
      </examples>
    </holeXAreas>

    <holeY type="Boolean">
      <groups>
        <mbgroup:TechnicHolesY />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Whether LEGO Technic holes are drawn along the Y-axis.
        Multiple rows possible depending on block height.
        Type, shift, diameter, inset, and grid parameters are shared with
        holeX and holeZ via the holeXYZ* and holeXY* unified parameters.
        Use holeYAreas for per-region overrides; later areas win on overlap.
      </documentation>
      <value>false</value>
      <scad:value>false</scad:value>
      <examples>
        <example language="BML" snippet="true" title="enabled">
          <![CDATA[
<NativeBlock holeY="true" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="enabled">
          <![CDATA[
          ...
          ["holeY", true]
          ...
          ]]>
        </scad:example>
      </examples>
    </holeY>

    <holeYAreas type="mbt:SelectiveGrid(Boolean | mbt:HoleType)[]">
      <groups>
        <mbgroup:TechnicHolesY />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Per-region overrides for holeY on the plate grid. Each entry is an inclusive
        rectangular range (start/end in GridUnitXY) with a Boolean or HoleType value. Later entries
        win on overlap.
      </documentation>
      <value>[]</value>
      <scad:value>[]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="one area">
          <![CDATA[
<NativeBlock holeY="true" holeYAreas="[{start:{x:0,y:0}, end:{x:1,y:1}, value:false}]" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="one area">
          <![CDATA[
          ...
          ["holeY", true],
          ["holeYAreas", [[[0,0],[1,1],false]]]
          ...
          ]]>
        </scad:example>
      </examples>
    </holeYAreas>

    <holeZ type="Boolean">
      <groups>
        <mbgroup:TechnicHolesZ />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Whether LEGO Technic holes are drawn along the Z-axis.
        Type, shift, diameter, and inset parameters are shared with holeX
        and holeY via the holeXYZ* unified parameters.
        Z holes now also support insets (holeXYZInsetThickness/Depth).
        Use holeZAreas for per-region overrides; later areas win on overlap.
      </documentation>
      <value>false</value>
      <scad:value>false</scad:value>
      <examples>
        <example language="BML" snippet="true" title="enabled">
          <![CDATA[
<NativeBlock holeZ="true" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="enabled">
          <![CDATA[
          ...
          ["holeZ", true]
          ...
          ]]>
        </scad:example>
      </examples>
    </holeZ>

    <holeZAreas type="mbt:SelectiveGrid(Boolean | mbt:HoleType)[]">
      <groups>
        <mbgroup:TechnicHolesZ />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Per-region overrides for holeZ on the plate grid. Each entry is an inclusive
        rectangular range (start/end in GridUnitXY) with a Boolean or HoleType value. Later entries
        win on overlap.
      </documentation>
      <value>[]</value>
      <scad:value>[]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="one area">
          <![CDATA[
<NativeBlock holeZ="true" holeZAreas="[{start:{x:0,y:0}, end:{x:1,y:1}, value:false}]" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="one area">
          <![CDATA[
          ...
          ["holeZ", true],
          ["holeZAreas", [[[0,0],[1,1],false]]]
          ...
          ]]>
        </scad:example>
      </examples>
    </holeZAreas>

    <holeXYGridOffsetZ type="Decimal(mbunit:MBU) | mbt:AxisXY(Decimal(mbunit:MBU))">
      <groups>
        <mbgroup:TechnicHoles />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Per-axis scalar: distance from the block bottom to the center of the first
        row of Technic holes for X-holes and Y-holes (AxisXY in MBU — not OffsetXY;
        one independent scalar per hole axis, not a 2D translation).
        Each component can independently be a single value or a 2-element array.
      </documentation>
      <since>3.0.0</since>
      <value>3.625</value>
      <scad:value>3.625</scad:value>
      <examples>
        <example language="BML" snippet="true" title="global">
          <![CDATA[
<NativeBlock holeXYGridOffsetZ="3" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="global">
          <![CDATA[
          ...
          ["holeXYGridOffsetZ", 3]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="per-axis">
          <![CDATA[
<NativeBlock holeXYGridOffsetZ="{x: 3, y: 4}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="per-axis">
          <![CDATA[
          ...
          ["holeXYGridOffsetZ", [3, 4]]
          ...
          ]]>
        </scad:example>
      </examples>
    </holeXYGridOffsetZ>

    <holeXYGridOffsetZAdjustment type="Decimal(unit:Millimeter) | mbt:AxisXY(Decimal(unit:Millimeter))">
      <groups>
        <mbgroup:TechnicHoles />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <documentation>Calibration adjustment for holeXYGridOffsetZ — per-axis scalar in mm
        (AxisXY, same convention as holeXYGridOffsetZ).
      </documentation>
      <since>3.0.0</since>
      <value>0.0</value>
      <scad:value>0.0</scad:value>
      <examples>
        <example language="BML" snippet="true" title="global">
          <![CDATA[
<NativeBlock holeXYGridOffsetZAdjustment="0.1" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="global">
          <![CDATA[
          ...
          ["holeXYGridOffsetZAdjustment", 0.1]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="per-axis">
          <![CDATA[
<NativeBlock holeXYGridOffsetZAdjustment="{x: 0.1, y: -0.1}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="per-axis">
          <![CDATA[
          ...
          ["holeXYGridOffsetZAdjustment", [0.1, -0.1]]
          ...
          ]]>
        </scad:example>
      </examples>
    </holeXYGridOffsetZAdjustment>

    <holeXYGridSizeZ type="Decimal(mbunit:MBU) | mbt:AxisXY(Decimal(mbunit:MBU))">
      <groups>
        <mbgroup:TechnicHoles />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Per-axis scalar: center-to-center distance between two rows of Technic
        holes for X-holes and Y-holes (AxisXY in MBU — not SizeXY; one independent
        spacing scalar per hole axis, not a 2D footprint).
      </documentation>
      <since>3.0.0</since>
      <value>6</value>
      <scad:value>6</scad:value>
      <examples>
        <example language="BML" snippet="true" title="global">
          <![CDATA[
<NativeBlock holeXYGridSizeZ="6" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="global">
          <![CDATA[
          ...
          ["holeXYGridSizeZ", 6]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="per-axis">
          <![CDATA[
<NativeBlock holeXYGridSizeZ="{x: 6, y: 8}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="per-axis">
          <![CDATA[
          ...
          ["holeXYGridSizeZ", [6, 8]]
          ...
          ]]>
        </scad:example>
      </examples>
    </holeXYGridSizeZ>

    <holeXYGridSizeZAdjustment type="Decimal(unit:Millimeter) | mbt:AxisXY(Decimal(unit:Millimeter))">
      <groups>
        <mbgroup:TechnicHoles />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <documentation>Calibration adjustment for holeXYGridSizeZ — per-axis scalar in mm
        (AxisXY, same convention as holeXYGridSizeZ).
      </documentation>
      <since>3.0.0</since>
      <value>0.0</value>
      <scad:value>0.0</scad:value>
      <examples>
        <example language="BML" snippet="true" title="global">
          <![CDATA[
<NativeBlock holeXYGridSizeZAdjustment="0.1" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="global">
          <![CDATA[
          ...
          ["holeXYGridSizeZAdjustment", 0.1]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="per-axis">
          <![CDATA[
<NativeBlock holeXYGridSizeZAdjustment="{x: 0.1, y: 0}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="per-axis">
          <![CDATA[
          ...
          ["holeXYGridSizeZAdjustment", [0.1, 0]]
          ...
          ]]>
        </scad:example>
      </examples>
    </holeXYGridSizeZAdjustment>

    <holeXYMinTopMargin type="Decimal(mbunit:MBU) | mbt:AxisXY(Decimal(mbunit:MBU))">
      <groups>
        <mbgroup:TechnicHoles />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Per-axis scalar: minimum distance between the block top and the topmost
        row of Technic holes for X-holes and Y-holes (AxisXY in MBU). Determines whether
        a row is drawn.
      </documentation>
      <since>3.0.0</since>
      <value>0.5</value>
      <scad:value>0.5</scad:value>
      <examples>
        <example language="BML" snippet="true" title="global">
          <![CDATA[
<NativeBlock holeXYMinTopMargin="1" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="global">
          <![CDATA[
          ...
          ["holeXYMinTopMargin", 1]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="per-axis">
          <![CDATA[
<NativeBlock holeXYMinTopMargin="{x: 1, y: 0.5}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="per-axis">
          <![CDATA[
          ...
          ["holeXYMinTopMargin", [1, 0.5]]
          ...
          ]]>
        </scad:example>
      </examples>
    </holeXYMinTopMargin>

    <holeXYZAxleThickness type="Decimal(mbunit:MBU) | mbt:AxisXYZ(Decimal(mbunit:MBU))">
      <groups>
        <mbgroup:TechnicHoles />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Thickness of one strut of the cross axle for holeXYZType="axle".
        Follows the 1/2/3-value array rule.
      </documentation>
      <since>3.0.0</since>
      <value>1</value>
      <scad:value>1</scad:value>
      <examples>
        <example language="BML" snippet="true" title="global">
          <![CDATA[
<NativeBlock holeXYZAxleThickness="1.2" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="global">
          <![CDATA[
          ...
          ["holeXYZAxleThickness", 1.2]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="per-axis">
          <![CDATA[
<NativeBlock holeXYZAxleThickness="{x: 1, y: 1, z: 1.2}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="per-axis">
          <![CDATA[
          ...
          ["holeXYZAxleThickness", [1, 1, 1.2]]
          ...
          ]]>
        </scad:example>
      </examples>
    </holeXYZAxleThickness>

    <holeXYZAxleThicknessAdjustment type="Decimal(unit:Millimeter) | mbt:AxisXYZ(Decimal(unit:Millimeter))">
      <groups>
        <mbgroup:TechnicHoles />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <documentation>Calibration adjustment for holeXYZAxleThickness, in mm.
        Follows the 1/2/3-value array rule.
        Analog to other Adjustment parameters for printer compensation.
      </documentation>
      <since>3.0.0</since>
      <value>0.0</value>
      <scad:value>0.0</scad:value>
      <examples>
        <example language="BML" snippet="true" title="global">
          <![CDATA[
<NativeBlock holeXYZAxleThicknessAdjustment="0.05" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="global">
          <![CDATA[
          ...
          ["holeXYZAxleThicknessAdjustment", 0.05]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="per-axis">
          <![CDATA[
<NativeBlock holeXYZAxleThicknessAdjustment="{x: 0, y: 0, z: 0.05}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="per-axis">
          <![CDATA[
          ...
          ["holeXYZAxleThicknessAdjustment", [0, 0, 0.05]]
          ...
          ]]>
        </scad:example>
      </examples>
    </holeXYZAxleThicknessAdjustment>

    <holeXYZDiameter type="mbt:Auto | Decimal(mbunit:MBU) | mbt:AxisXYZ(Decimal(mbunit:MBU))">

      <scad:value>[0, 0, 0]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="xyz offset">
          <![CDATA[
<NativeBlock offset="{x: 1, y: 0, z: 0.5}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="xyz offset">
          <![CDATA[
          ...
          ["offset", [1, 0, 0.5]]
          ...
          ]]>
        </scad:example>
      </examples>
    </offset>

    <pcb type="Boolean.False | mbt:PcbMountingType">
      <groups>
        <mbgroup:Pcb />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>PCB mounting mode. Combines the former pcb (bool) and pcbMountingType into one.
        false or "none": no PCB mounting features.
        "clips": frame for clipping in the PCB.
        "sockets": screw sockets for socket/screw mounting.
      </documentation>
      <changelog>
        <change version="3.0.0">Now accepts mounting type values directly: false/"none", "clips",
          "sockets".
          Merges the former pcb (bool) and pcbMountingType ("clips"|"screws") parameters.
        </change>
      </changelog>
      <value>false</value>
      <scad:value>false</scad:value>
      <examples>
        <example language="BML" snippet="true" title="clips">
          <![CDATA[
<NativeBlock pcb="Clips" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="clips">
          <![CDATA[
          ...
          ["pcb", "clips"]
          ...
          ]]>
        </scad:example>
      </examples>
    </pcb>


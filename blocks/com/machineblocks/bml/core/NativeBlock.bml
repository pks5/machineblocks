<!--MachineBlocks MBOM — NativeBlock (mb_block primitive)

  FQN: com.machineblocks.bml.core.NativeBlock
  Final — cannot be used as baseType on Block definitions

  SSOT for all MachineBlocks MBML / SCAD parameters: property set, types, docs,
  defaults, and scad:value literals. Type shapes SSOT: com.machineblocks.bml.type.*
  (Library.bml membership). Markdown / YAML / scad-lib docs must follow this BML —
  they must not redefine the parameter inventory.-->
<mbcore:NativeBlock xmlns="http://blockml.org/bml"
  xmlns:type="org.blockml.bml.type"
  xmlns:unit="org.blockml.bml.unit"
  xmlns:scad="com.machineblocks.bml.annotation.ScadAnnotation"
  xmlns:mbcore="com.machineblocks.bml.core"
  xmlns:mbt="com.machineblocks.bml.type"
  xmlns:mbunit="com.machineblocks.bml.unit"
  xmlns:mbgroup="com.machineblocks.bml.group">

  <baseType>
    mbcore:Block
  </baseType>
  <is>
    A leaf geometry Block
  </is>
  <documentation>
    Final leaf Block mapped directly to SCAD mb_block() — the native geometry primitive
    at render time. Uses children aggregation for mb_block() sub-geometry instead of _parts.
    
    Sole SSOT for MachineBlocks (MB) native parameters: names, types, documentation, defaults,
    and scad:value live only here. Markdown, YAML (09_mbom_properties.yml, 09_api_parameters.yml),
    and scad-lib docs must follow this file — align to it or link only; never redefine the inventory.
    
    Type shapes SSOT: com.machineblocks.bml.type.* (Library.bml membership). Extend types there;
    do not invent parallel type tables in Markdown/YAML.
  </documentation>
  <final>
    true
  </final>
  <references>
    <see type="mbcore:Block">
      Extends Block directly — not CompositeBlock.
    </see>
    <see type="mbcore:CompositeBlock">
      Contrasts with CompositeBlock which uses _parts for composition children.
    </see>
  </references>
  <properties>
    <align type="mbt:Align | mbt:AxisXYZ(mbt:Align)">
      <documentation>
        Alignment relative to the origin, per brick axis.
        Scalar Align broadcasts to X/Y/Z; AxisXYZ(Align) sets each axis.
        "start" = toward x-/y-/z-, "end" = toward x+/y+/z+.
        Origin is [0,0,0] globally, or defined by parent's alignChildren.
        Alignment is based strictly on the bounding box.
        Contrast: face-local anchors (e.g. Port.align) use Align | AxisAB(Align),
        not AxisXYZ — see Align / Port type docs.
      </documentation>
      <changelog>
        <change version="3.0.0">
          mb_param_align() now always resolves to a 3-element array.
        </change>
      </changelog>
      <examples>
        <example title="center" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock align="Center" />]]>
        </example>
        <scad:example title="center" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["align", "center"]
          ...
          ]]>
        </scad:example>
        <example title="per-axis" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock align="{x: Start, y: Center, z: End}" />]]>
        </example>
        <scad:example title="per-axis" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["align", ["start", "center", "end"]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Positioning />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>Start</value>
      <scad:value>start</scad:value>
    </align>
    <alignChildren type="mbt:Align | mbt:AxisXYZ(mbt:Align)">
      <documentation>
        Defines the origin inside a parent brick for child positioning.
        Same convention as align (Align | AxisXYZ(Align) in brick space).
        Children use this as their reference point.
      </documentation>
      <changelog>
        <change version="3.0.0">
          mb_param_alignChildren() now always resolves to a 3-element array.
        </change>
      </changelog>
      <examples>
        <example title="center" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock alignChildren="Center" />]]>
        </example>
        <scad:example title="center" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["alignChildren", "center"]
          ...
          ]]>
        </scad:example>
        <example title="per-axis" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock alignChildren="{x: Start, y: Center, z: End}" />]]>
        </example>
        <scad:example title="per-axis" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["alignChildren", ["start", "center", "end"]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Positioning />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>Start</value>
      <scad:value>start</scad:value>
    </alignChildren>
    <base type="type:Boolean">
      <documentation>
        Whether the base body is drawn. Purely visual — no effect on
        bounding box, align, size, or calculations. Other features (studs,
        text, etc.) are controlled separately.
      </documentation>
      <examples>
        <example title="hidden" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock base="false" />]]>
        </example>
        <scad:example title="hidden" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["base", false]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Body />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>true</value>
      <scad:value>true</scad:value>
    </base>
    <baseAdjustment type="mbt:FaceMapXYZ(type:Decimal(unit:Millimeter))">
      <documentation>
        Per-side calibration adjustment in mm. Extends or reduces specific sides
        of a block. Never scales with the scale parameter.
        
        PRIMARY PURPOSE — Per-side fine-tuning:
        While sizeAdjustment provides global calibration, baseAdjustment
        allows per-side overrides including z- and z+ (which sizeAdjustment
        cannot address individually).
        
        z- SPECIAL BEHAVIOUR: A z- value does not reduce block height from below.
        Instead it shifts the brick downward by the z- amount (independent of
        offset), and extends z+ by the same amount. This means the brick gains
        a downward protrusion while the top side expands correspondingly.
        Same applies to sizeMod z-.
        
        Difference to sizeMod: baseAdjustment is for printer calibration and
        gap closing in composite blocks. sizeMod is a semantic geometry change.
        
        IN CONFIG — typically empty or used for global z+/z- adjustments.
        
        IN COMPOSITE BLOCKS — use namespaced entries to pass side-specific
        adjustments to child composite blocks. The child uses mb_params_filter()
        to extract its namespace:
        // In outer block:
        ["baseAdjustment", [["pbx.x+", 0.01], ["pty.z+", 0.1]]]
        // In inner composite block (pbx part):
        ["baseAdjustment", mb_params_filter(baseAdjustment, "pbx")]
        // Result: [["x+", 0.01]]
        
        mb_params_filter(param, namespace, overrides?):
        Filters a pseudo-map by namespace prefix, removes the prefix from keys.
        Ignores entries without a namespace and entries with numeric keys.
        Optional third argument applies fixed overrides after filtering.
        Universal — can be applied to any [[string, value]] pseudo-map parameter.
      </documentation>
      <changelog>
        <change version="3.0.0">
          Renamed from baseSideAdjustment. Format changed from
          float/2-element/
          4-element array to pseudo-map [[side, value]] format. Now supports all
          6 sides (including z-) and namespace-prefixed keys for composite patterns.
          z- now has a special downward-shift behaviour (not a plain height reduction).
          Default changed from -0.1 to [] (empty).
        </change>
      </changelog>
      <examples>
        <example title="xy face calibration" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock baseAdjustment="{xNeg: 0.05, xPos: 0.05, yNeg: -0.02, yPos: -0.02, zNeg: 0, zPos: 0}" />]]>
        </example>
        <scad:example title="xy face calibration" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["baseAdjustment", [0.05, 0.05, -0.02, -0.02, 0, 0]]
          ...
          ]]>
        </scad:example>
        <example title="z-plus tweak" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock baseAdjustment="{xNeg: 0, xPos: 0, yNeg: 0, yPos: 0, zNeg: 0, zPos: 0.1}" />]]>
        </example>
        <scad:example title="z-plus tweak" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["baseAdjustment", [0, 0, 0, 0, 0, 0.1]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Calibration />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <value>{xNeg:0,xPos:0,yNeg:0,yPos:0,zNeg:0,zPos:0}</value>
      <scad:value>[0,0,0,0,0,0]</scad:value>
    </baseAdjustment>
    <baseClampHeight type="type:Decimal(mbunit:MBU)">
      <documentation>
        Height of the base clamp lip.
      </documentation>
      <examples>
        <example title="taller lip" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock baseClampHeight="0.6" />]]>
        </example>
        <scad:example title="taller lip" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["baseClampHeight", 0.6]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:BaseClamp />
        <mbgroup:RareAiUsage />
      </groups>
      <value>0.5</value>
      <scad:value>0.5</scad:value>
    </baseClampHeight>
    <baseClampOffset type="type:Decimal(mbunit:MBU)">
      <documentation>
        Distance from the bottom edge of the block to the base clamp lip.
        The base clamp is a small lip on the inner wall of the underside
        opening, around tubes, and in stud holes (baseCutoutType=studs)
        that increases clamping force.
      </documentation>
      <examples>
        <example title="raised" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock baseClampOffset="0.375" />]]>
        </example>
        <scad:example title="raised" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["baseClampOffset", 0.375]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:BaseClamp />
        <mbgroup:RareAiUsage />
      </groups>
      <value>0.25</value>
      <scad:value>0.25</scad:value>
    </baseClampOffset>
    <baseClampOuter type="type:Boolean">
      <documentation>
        Whether a clamp lip is also placed on the outer side of the block.
        Not useful for normal bricks. Useful in composite blocks where an
        outer surface of a sub-brick becomes an inner surface in the
        overall block.
      </documentation>
      <examples>
        <example title="outer" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock baseClampOuter="true" />]]>
        </example>
        <scad:example title="outer" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["baseClampOuter", true]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:BaseClamp />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>false</value>
      <scad:value>false</scad:value>
    </baseClampOuter>
    <baseClampThickness type="type:Decimal(unit:Millimeter)">
      <documentation>
        Thickness of the base clamp lip.
      </documentation>
      <examples>
        <example title="thicker" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock baseClampThickness="0.2" />]]>
        </example>
        <scad:example title="thicker" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["baseClampThickness", 0.2]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:BaseClamp />
        <mbgroup:RareAiUsage />
      </groups>
      <value>0.1</value>
      <scad:value>0.1</scad:value>
    </baseClampThickness>
    <baseColor type="type:Color">
      <documentation>
        Color of the brick body, studs, and all other parts.
        Does NOT apply to text (use textColor separately).
      </documentation>
      <examples>
        <example title="yellow" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock baseColor="#EAC645" />]]>
        </example>
        <scad:example title="yellow" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["baseColor", "#EAC645"]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Body />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>#EAC645</value>
      <scad:value>"#EAC645"</scad:value>
    </baseColor>
    <baseCrop type="mbt:FaceMapXYZ(type:Decimal(mbunit:GridUnitXY), type:Decimal(mbunit:GridUnitZ))">
      <documentation>
        Hard cut or extension per side (all six faces: x±, y±, z±).
        Positive = cut geometry, negative = extend geometry.
        The cut is applied brutally — without regard to grid compatibility,
        walls, tubes, or other structural features.
        Does NOT affect bounding box or positioning.
        For semantic size modification that keeps the brick structurally intact,
        use sizeMod instead. baseCrop is intended for cross-sections, screenshots,
        or helper bricks — not for normal size adjustment.
        Same functionality as crop in V2, renamed only.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="crop sides" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock baseCrop="{xNeg: 0.5, xPos: 0.5, yNeg: 0, yPos: 0, zNeg: 0, zPos: 0}" />]]>
        </example>
        <scad:example title="crop sides" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["baseCrop", [0.5, 0.5, 0, 0, 0, 0]]
          ...
          ]]>
        </scad:example>
        <example title="cross-section" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock baseCrop="{xNeg: 0, xPos: 0, yNeg: 0, yPos: 0, zNeg: 0, zPos: 1}" />]]>
        </example>
        <scad:example title="cross-section" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["baseCrop", [0, 0, 0, 0, 0, 1]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:CoreGeometry />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>{xNeg:0,xPos:0,yNeg:0,yPos:0,zNeg:0,zPos:0}</value>
      <scad:value>[0,0,0,0,0,0]</scad:value>
    </baseCrop>
    <baseCutoutMaxDepth type="type:Decimal(mbunit:MBU)">
      <documentation>
        Maximum depth of the underside opening (baseCutoutType=standard only).
        Default 5 mbu ≈ 8 mm. Limits underside depth; if the limit applies,
        the topPlateHeight grows accordingly. When recess is defined, the
        baseCutoutDepth shrinks to the minimum (1 mbu) and topPlateHeight
        shrinks to its minimum value.
      </documentation>
      <examples>
        <example title="deeper" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock baseCutoutMaxDepth="6" />]]>
        </example>
        <scad:example title="deeper" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["baseCutoutMaxDepth", 6]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Underside />
        <mbgroup:RareAiUsage />
      </groups>
      <value>5</value>
      <scad:value>5</scad:value>
    </baseCutoutMaxDepth>
    <baseCutoutType type="mbt:BaseCutout">
      <documentation>
        Type of underside opening.
        standard: Classic LEGO underside with tubes/pins.
        studs: Alternative with only stud holes, no tube structure.
        Grid-compatible but only fits exactly on studs.
        groove: Counterpart to tongue — a groove that the tongue fits into.
        none: Solid underside, no opening. For solid structures in composite
        blocks, e.g. embedded blocks without their own underside.
      </documentation>
      <examples>
        <example title="Solid block without underside cutout" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock baseCutoutType="None" />]]>
        </example>
        <scad:example title="Solid block without underside cutout" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["baseCutoutType", "none"]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Underside />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>Standard</value>
      <scad:value>standard</scad:value>
    </baseCutoutType>
    <baseRoundingRadius type="type:Decimal | mbt:RadiusAB | mbt:BaseRoundingMap">
      <documentation>
        Rounding radius of the block corners. Unlike recessRoundingRadius /
        tongueRoundingRadius (Z-plane / horizontal corners only via PlaneRoundingMap), this
        parameter defines radii along all three brick axes via BaseRoundingMap
        (AxisXYZ(Decimal | RadiusAB | CornerMap(Decimal | RadiusAB))). Because the three axes use different scales
        (XY grid vs Z plate height), component values stay unitless Decimal | RadiusAB — the
        axis context supplies the physical meaning.
        
        Authored forms (combinable inside BaseRoundingMap):
        • Decimal — same radius on all axes and corners
        • RadiusAB — same anisotropic {a,b} on all axes and corners
        • BaseRoundingMap — per axis: Decimal | RadiusAB | CornerMap; per corner: Decimal | RadiusAB
      </documentation>
      <examples>
        <example title="uniform" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock baseRoundingRadius="5" />]]>
        </example>
        <scad:example title="uniform" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["baseRoundingRadius", 5]
          ...
          ]]>
        </scad:example>
        <example title="anisotropic" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock baseRoundingRadius="{a: 3, b: 2}" />]]>
        </example>
        <scad:example title="anisotropic" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["baseRoundingRadius", [[3, 2], [3, 2], [3, 2]]]
          ...
          ]]>
        </scad:example>
        <example title="per-axis mix" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock baseRoundingRadius="{x: {sw: 2, nw: {a: 3, b: 2}}, y: 0, z: {a: 1, b: 4}}" />]]>
        </example>
        <scad:example title="per-axis mix" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["baseRoundingRadius", [[2, [3, 2], 0, 0], 0, [1, 4]]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Rounding />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>0</value>
      <scad:value>0</scad:value>
    </baseRoundingRadius>
    <baseWallGaps type="mbt:WallGap[]">
      <documentation>
        Gaps in the underside wall (baseCutoutType=standard).
        Used to restore grid compatibility in composite blocks where blocks cross.
        Replaces baseWallGapsX and baseWallGapsY from V2.
        Each entry specifies one side, a position, and optionally a length.
        To open both sides at a position, add two separate entries.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="faces" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock baseWallGaps="[{face: XNeg, pos: 1, len: 2}, {face: YPos, pos: 0, len: 1}]" />]]>
        </example>
        <scad:example title="faces" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["baseWallGaps", [["x-", 1, 2], ["y+", 0, 1]]]
          ...
          ]]>
        </scad:example>
        <example title="axes" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock baseWallGaps="[{face: X, pos: 1, len: 2}, {face: Y, pos: 0, len: 1}]" />]]>
        </example>
        <scad:example title="axes" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["baseWallGaps", [["x", 1, 2], ["y", 0, 1]]]
          ...
          ]]>
        </scad:example>
        <example title="xy" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock baseWallGaps="[{face: XY, pos: 2, len: 1}]" />]]>
        </example>
        <scad:example title="xy" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["baseWallGaps", [["xy", 2, 1]]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Underside />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>[]</value>
      <scad:value>[]</scad:value>
    </baseWallGaps>
    <baseWallThickness type="mbt:Auto | type:Decimal(mbunit:MBU)">
      <documentation>
        Wall thickness of the underside opening (baseCutoutType=standard).
        Automatically calculated. Usually does not need adjustment.
      </documentation>
      <examples>
        <example title="explicit" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock baseWallThickness="1.1" />]]>
        </example>
        <scad:example title="explicit" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["baseWallThickness", 1.1]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Underside />
        <mbgroup:RareAiUsage />
      </groups>
      <value>Auto</value>
      <scad:value>auto</scad:value>
    </baseWallThickness>
    <baseWallThicknessAdjustment type="type:Decimal(unit:Millimeter)">
      <documentation>
        Calibration adjustment for baseWallThickness.
        Only for calibration. Not for AI in settings.
      </documentation>
      <examples>
        <example title="tighter" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock baseWallThicknessAdjustment="-0.2" />]]>
        </example>
        <scad:example title="tighter" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["baseWallThicknessAdjustment", -0.2]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Underside />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <value>-0.1</value>
      <scad:value>-0.1</scad:value>
    </baseWallThicknessAdjustment>
    <bevel type="mbt:Bevel">
      <documentation>
        Creates wedges by shifting corners on the horizontal (Z-face) plane
        only — Bevel = CornerMap(OffsetXY) in GridUnitXY, not a multi-axis map like
        baseRoundingRadius. Each of the four local corners (sw / nw / ne / se) gets an XY
        displacement. World XY (not AxisAB) is intentional: the plane is fixed to the brick
        Z-face. The resulting shape is intersected with the bounding box. Can be used
        together with slope.
      </documentation>
      <changelog>
        <change version="3.0.0">
          Can now be combined with slope.
        </change>
      </changelog>
      <examples>
        <example title="corner shift" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock bevel="{sw: {x: 0, y: 0}, nw: {x: 0, y: 0}, ne: {x: 1, y: 0}, se: {x: 1, y: 0}}" />]]>
        </example>
        <scad:example title="corner shift" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["bevel", [[0, 0], [0, 0], [1, 0], [1, 0]]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:CoreGeometry />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>{sw:{x:0,y:0},nw:{x:0,y:0},ne:{x:0,y:0},se:{x:0,y:0}}</value>
      <scad:value>[[0,0],[0,0],[0,0],[0,0]]</scad:value>
    </bevel>
    <connectorDepth type="type:Decimal(mbunit:MBU)">
      <documentation>
        How far the connector triangles protrude.
      </documentation>
      <examples>
        <example title="deeper" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock connectorDepth="0.875" />]]>
        </example>
        <scad:example title="deeper" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["connectorDepth", 0.875]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Connectors />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>0.75</value>
      <scad:value>0.75</scad:value>
    </connectorDepth>
    <connectorLength type="mbt:Auto | type:Decimal(mbunit:MBU)">
      <documentation>
        Length of the connector run on the face. At "auto" equals the
        available space (brick height for x/y faces, width/depth for z faces).
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="explicit" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock connectorLength="2" />]]>
        </example>
        <scad:example title="explicit" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["connectorLength", 2]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Connectors />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>Auto</value>
      <scad:value>auto</scad:value>
    </connectorLength>
    <connectorLengthClearance type="type:Decimal(unit:Millimeter)">
      <documentation>
        Clearance of the recess depth relative to the triangle depth.
        Ensures male and female connectors fit together.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="more clearance" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock connectorLengthClearance="0.3" />]]>
        </example>
        <scad:example title="more clearance" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["connectorLengthClearance", 0.3]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Connectors />
        <mbgroup:RareAiUsage />
      </groups>
      <value>0.2</value>
      <scad:value>0.2</scad:value>
    </connectorLengthClearance>
    <connectorSideClearance type="type:Decimal(unit:Millimeter)">
      <documentation>
        Clearance of the recess width relative to the triangle width.
        Ensures male and female connectors fit together.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="more clearance" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock connectorSideClearance="0.2" />]]>
        </example>
        <scad:example title="more clearance" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["connectorSideClearance", 0.2]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Connectors />
        <mbgroup:RareAiUsage />
      </groups>
      <value>0.1</value>
      <scad:value>0.1</scad:value>
    </connectorSideClearance>
    <connectorWidth type="type:Decimal(mbunit:MBU)">
      <documentation>
        Width of the connector triangles.
      </documentation>
      <examples>
        <example title="wider" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock connectorWidth="2" />]]>
        </example>
        <scad:example title="wider" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["connectorWidth", 2]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Connectors />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>2.25</value>
      <scad:value>2.25</scad:value>
    </connectorWidth>
    <connectors type="type:Boolean | mbt:Connector[]">
      <documentation>
        Side connection system using triangular wedges. Alternative to tongue/groove.
        Enables side-by-side (0°) and angled (90°) connections.
        Padding skips connectors at start/end — important when connecting
        bricks of different sizes.
      </documentation>
      <changelog>
        <change version="3.0.0">
          Completely new format: [face, direction, gender, align?,
          padStart?, padEnd?]
          per connector. The old [[side, arrangement]] format is no longer valid.
          Padding is now per-connector; the separate connectorPadding parameter is removed.
        </change>
      </changelog>
      <examples>
        <example title="basic" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock connectors="[{face: XPos, axis: Y, gender: Male}]" />]]>
        </example>
        <scad:example title="basic" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["connectors", [["x+", "y", "male"]]]
          ...
          ]]>
        </scad:example>
        <example title="with padding" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock connectors="[{face: XPos, axis: Y, gender: Male, align: Center, padStart: 1, padEnd: 1}]" />]]>
        </example>
        <scad:example title="with padding" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["connectors", [["x+", "y", "male", "center", 1, 1]]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Connectors />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>false</value>
      <scad:value>false</scad:value>
    </connectors>
    <debug type="type:Boolean">
      <documentation>
        Enables debug output to the console. Has no effect on geometry.
        Used for development and troubleshooting.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="on" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock debug="true" />]]>
        </example>
        <scad:example title="on" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["debug", true]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:System />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>false</value>
      <scad:value>false</scad:value>
    </debug>
    <debugShowOnly type="type:Text">
      <documentation>
        Debug-only filter. When set to a string, only that part of the block
        is shown (e.g. "studs"), all other geometry is hidden. Has no effect
        on geometry semantics — for debugging/inspection only.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="not set" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock />  <!-- debugShowOnly is not set — omit the property -->]]>
        </example>
        <scad:example title="not set" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["debugShowOnly", undef]
          ...
          ]]>
        </scad:example>
        <example title="filter studs" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock debugShowOnly="studs" />]]>
        </example>
        <scad:example title="filter studs" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["debugShowOnly", "studs"]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:System />
        <mbgroup:RareAiUsage />
      </groups>
    </debugShowOnly>
    <direction type="mbt:Direction">
      <documentation>
        Semantic grid-aligned rotation. Applied before align.
        west=0°, north=90°, east=180°, south=270° (clockwise).
        All internal values (size, side numbering, etc.) always refer to
        "west" orientation. Direction only changes placement/display.
        Before align is applied the brick is centered on its body center.
      </documentation>
      <examples>
        <example title="north" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock direction="North" />]]>
        </example>
        <scad:example title="north" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["direction", "north"]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Positioning />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>West</value>
      <scad:value>west</scad:value>
    </direction>
    <grille type="mbt:Grille">
      <documentation>
        Whether the top plate is rendered as a grille with regular openings.
        "x" or "y" defines the direction of the grille bars.
      </documentation>
      <examples>
        <example title="x bars" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock grille="X" />]]>
        </example>
        <scad:example title="x bars" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["grille", "x"]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Grille />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>None</value>
      <scad:value>none</scad:value>
    </grille>
    <grilleCount type="type:Integer">
      <documentation>
        Number of grille bars across the entire surface.
      </documentation>
      <examples>
        <example title="three" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock grilleCount="3" />]]>
        </example>
        <scad:example title="three" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["grilleCount", 3]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Grille />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>5</value>
      <scad:value>5</scad:value>
    </grilleCount>
    <grilleDepth type="type:Decimal(mbunit:MBU)">
      <documentation>
        Depth of the grille openings.
      </documentation>
      <examples>
        <example title="deeper" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock grilleDepth="1.25" />]]>
        </example>
        <scad:example title="deeper" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["grilleDepth", 1.25]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Grille />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>1</value>
      <scad:value>1</scad:value>
    </grilleDepth>
    <grilleInverted type="type:Boolean">
      <documentation>
        Whether the grille starts with an opening instead of a solid bar.
      </documentation>
      <examples>
        <example title="inverted" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock grilleInverted="true" />]]>
        </example>
        <scad:example title="inverted" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["grilleInverted", true]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Grille />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>false</value>
      <scad:value>false</scad:value>
    </grilleInverted>
    <holeX type="type:Boolean">
      <documentation>
        Whether LEGO Technic holes are drawn along the X-axis.
        Multiple rows possible depending on block height. Use holeXAreas for per-region
        overrides; later areas win on overlap.
      </documentation>
      <examples>
        <example title="enabled" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeX="true" />]]>
        </example>
        <scad:example title="enabled" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeX", true]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TechnicHolesX />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>false</value>
      <scad:value>false</scad:value>
    </holeX>
    <holeXAreas type="mbt:SelectiveGrid(type:Boolean | mbt:HoleType)[]">
      <documentation>
        Per-region overrides for holeX on the plate grid. Each entry is an inclusive
        rectangular range (start/end in GridUnitXY) with a Boolean or HoleType value. Later entries
        win on overlap.
      </documentation>
      <examples>
        <example title="one area" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeX="true" holeXAreas="[{start:{x:0,y:0}, end:{x:1,y:1}, value:false}]" />]]>
        </example>
        <scad:example title="one area" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeX", true],
          ["holeXAreas", [[[0,0],[1,1],false]]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TechnicHolesX />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>[]</value>
      <scad:value>[]</scad:value>
    </holeXAreas>
    <holeY type="type:Boolean">
      <documentation>
        Whether LEGO Technic holes are drawn along the Y-axis.
        Multiple rows possible depending on block height.
        Type, shift, diameter, inset, and grid parameters are shared with
        holeX and holeZ via the holeXYZ* and holeXY* unified parameters.
        Use holeYAreas for per-region overrides; later areas win on overlap.
      </documentation>
      <examples>
        <example title="enabled" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeY="true" />]]>
        </example>
        <scad:example title="enabled" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeY", true]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TechnicHolesY />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>false</value>
      <scad:value>false</scad:value>
    </holeY>
    <holeYAreas type="mbt:SelectiveGrid(type:Boolean | mbt:HoleType)[]">
      <documentation>
        Per-region overrides for holeY on the plate grid. Each entry is an inclusive
        rectangular range (start/end in GridUnitXY) with a Boolean or HoleType value. Later entries
        win on overlap.
      </documentation>
      <examples>
        <example title="one area" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeY="true" holeYAreas="[{start:{x:0,y:0}, end:{x:1,y:1}, value:false}]" />]]>
        </example>
        <scad:example title="one area" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeY", true],
          ["holeYAreas", [[[0,0],[1,1],false]]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TechnicHolesY />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>[]</value>
      <scad:value>[]</scad:value>
    </holeYAreas>
    <holeZ type="type:Boolean">
      <documentation>
        Whether LEGO Technic holes are drawn along the Z-axis.
        Type, shift, diameter, and inset parameters are shared with holeX
        and holeY via the holeXYZ* unified parameters.
        Z holes now also support insets (holeXYZInsetThickness/Depth).
        Use holeZAreas for per-region overrides; later areas win on overlap.
      </documentation>
      <examples>
        <example title="enabled" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeZ="true" />]]>
        </example>
        <scad:example title="enabled" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeZ", true]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TechnicHolesZ />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>false</value>
      <scad:value>false</scad:value>
    </holeZ>
    <holeZAreas type="mbt:SelectiveGrid(type:Boolean | mbt:HoleType)[]">
      <documentation>
        Per-region overrides for holeZ on the plate grid. Each entry is an inclusive
        rectangular range (start/end in GridUnitXY) with a Boolean or HoleType value. Later entries
        win on overlap.
      </documentation>
      <examples>
        <example title="one area" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeZ="true" holeZAreas="[{start:{x:0,y:0}, end:{x:1,y:1}, value:false}]" />]]>
        </example>
        <scad:example title="one area" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeZ", true],
          ["holeZAreas", [[[0,0],[1,1],false]]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TechnicHolesZ />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>[]</value>
      <scad:value>[]</scad:value>
    </holeZAreas>
    <holeXYGridOffsetZ type="type:Decimal(mbunit:MBU) | mbt:AxisXY(type:Decimal(mbunit:MBU))">
      <documentation>
        Per-axis scalar: distance from the block bottom to the center of the first
        row of Technic holes for X-holes and Y-holes (AxisXY in MBU — not OffsetXY;
        one independent scalar per hole axis, not a 2D translation).
        Each component can independently be a single value or a 2-element array.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="global" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYGridOffsetZ="3" />]]>
        </example>
        <scad:example title="global" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYGridOffsetZ", 3]
          ...
          ]]>
        </scad:example>
        <example title="per-axis" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYGridOffsetZ="{x: 3, y: 4}" />]]>
        </example>
        <scad:example title="per-axis" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYGridOffsetZ", [3, 4]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TechnicHoles />
        <mbgroup:RareAiUsage />
      </groups>
      <value>3.625</value>
      <scad:value>3.625</scad:value>
    </holeXYGridOffsetZ>
    <holeXYGridOffsetZAdjustment type="type:Decimal(unit:Millimeter) | mbt:AxisXY(type:Decimal(unit:Millimeter))">
      <documentation>
        Calibration adjustment for holeXYGridOffsetZ — per-axis scalar in mm
        (AxisXY, same convention as holeXYGridOffsetZ).
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="global" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYGridOffsetZAdjustment="0.1" />]]>
        </example>
        <scad:example title="global" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYGridOffsetZAdjustment", 0.1]
          ...
          ]]>
        </scad:example>
        <example title="per-axis" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYGridOffsetZAdjustment="{x: 0.1, y: -0.1}" />]]>
        </example>
        <scad:example title="per-axis" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYGridOffsetZAdjustment", [0.1, -0.1]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TechnicHoles />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <value>0</value>
      <scad:value>0</scad:value>
    </holeXYGridOffsetZAdjustment>
    <holeXYGridSizeZ type="type:Decimal(mbunit:MBU) | mbt:AxisXY(type:Decimal(mbunit:MBU))">
      <documentation>
        Per-axis scalar: center-to-center distance between two rows of Technic
        holes for X-holes and Y-holes (AxisXY in MBU — not SizeXY; one independent
        spacing scalar per hole axis, not a 2D footprint).
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="global" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYGridSizeZ="6" />]]>
        </example>
        <scad:example title="global" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYGridSizeZ", 6]
          ...
          ]]>
        </scad:example>
        <example title="per-axis" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYGridSizeZ="{x: 6, y: 8}" />]]>
        </example>
        <scad:example title="per-axis" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYGridSizeZ", [6, 8]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TechnicHoles />
        <mbgroup:RareAiUsage />
      </groups>
      <value>6</value>
      <scad:value>6</scad:value>
    </holeXYGridSizeZ>
    <holeXYGridSizeZAdjustment type="type:Decimal(unit:Millimeter) | mbt:AxisXY(type:Decimal(unit:Millimeter))">
      <documentation>
        Calibration adjustment for holeXYGridSizeZ — per-axis scalar in mm
        (AxisXY, same convention as holeXYGridSizeZ).
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="global" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYGridSizeZAdjustment="0.1" />]]>
        </example>
        <scad:example title="global" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYGridSizeZAdjustment", 0.1]
          ...
          ]]>
        </scad:example>
        <example title="per-axis" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYGridSizeZAdjustment="{x: 0.1, y: 0}" />]]>
        </example>
        <scad:example title="per-axis" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYGridSizeZAdjustment", [0.1, 0]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TechnicHoles />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <value>0</value>
      <scad:value>0</scad:value>
    </holeXYGridSizeZAdjustment>
    <holeXYMinTopMargin type="type:Decimal(mbunit:MBU) | mbt:AxisXY(type:Decimal(mbunit:MBU))">
      <documentation>
        Per-axis scalar: minimum distance between the block top and the topmost
        row of Technic holes for X-holes and Y-holes (AxisXY in MBU). Determines whether
        a row is drawn.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="global" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYMinTopMargin="1" />]]>
        </example>
        <scad:example title="global" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYMinTopMargin", 1]
          ...
          ]]>
        </scad:example>
        <example title="per-axis" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYMinTopMargin="{x: 1, y: 0.5}" />]]>
        </example>
        <scad:example title="per-axis" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYMinTopMargin", [1, 0.5]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TechnicHoles />
        <mbgroup:RareAiUsage />
      </groups>
      <value>0.5</value>
      <scad:value>0.5</scad:value>
    </holeXYMinTopMargin>
    <holeXYZAxleThickness type="type:Decimal(mbunit:MBU) | mbt:AxisXYZ(type:Decimal(mbunit:MBU))">
      <documentation>
        Thickness of one strut of the cross axle for holeXYZType="axle".
        Follows the 1/2/3-value array rule.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="global" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYZAxleThickness="1.2" />]]>
        </example>
        <scad:example title="global" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYZAxleThickness", 1.2]
          ...
          ]]>
        </scad:example>
        <example title="per-axis" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYZAxleThickness="{x: 1, y: 1, z: 1.2}" />]]>
        </example>
        <scad:example title="per-axis" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYZAxleThickness", [1, 1, 1.2]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TechnicHoles />
        <mbgroup:RareAiUsage />
      </groups>
      <value>1</value>
      <scad:value>1</scad:value>
    </holeXYZAxleThickness>
    <holeXYZAxleThicknessAdjustment type="type:Decimal(unit:Millimeter) | mbt:AxisXYZ(type:Decimal(unit:Millimeter))">
      <documentation>
        Calibration adjustment for holeXYZAxleThickness, in mm.
        Follows the 1/2/3-value array rule.
        Analog to other Adjustment parameters for printer compensation.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="global" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYZAxleThicknessAdjustment="0.05" />]]>
        </example>
        <scad:example title="global" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYZAxleThicknessAdjustment", 0.05]
          ...
          ]]>
        </scad:example>
        <example title="per-axis" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYZAxleThicknessAdjustment="{x: 0, y: 0, z: 0.05}" />]]>
        </example>
        <scad:example title="per-axis" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYZAxleThicknessAdjustment", [0, 0, 0.05]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TechnicHoles />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <value>0</value>
      <scad:value>0</scad:value>
    </holeXYZAxleThicknessAdjustment>
    <holeXYZDiameter type="mbt:Auto | type:Decimal(mbunit:MBU) | mbt:AxisXYZ(type:Decimal(mbunit:MBU))">
      <documentation>
        Diameter of Technic holes per axis. Automatically calculated.
        Follows the 1/2/3-value array rule.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="global" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYZDiameter="4" />]]>
        </example>
        <scad:example title="global" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYZDiameter", 4]
          ...
          ]]>
        </scad:example>
        <example title="per-axis" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYZDiameter="{x: 4, y: 4, z: 3.5}" />]]>
        </example>
        <scad:example title="per-axis" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYZDiameter", [4, 4, 3.5]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TechnicHoles />
        <mbgroup:RareAiUsage />
      </groups>
      <value>Auto</value>
      <scad:value>auto</scad:value>
    </holeXYZDiameter>
    <holeXYZDiameterAdjustment type="type:Decimal(unit:Millimeter) | mbt:AxisXYZ(type:Decimal(unit:Millimeter))">
      <documentation>
        Calibration adjustment for holeXYZDiameter per axis.
        Follows the 1/2/3-value array rule.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="global" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYZDiameterAdjustment="0.1" />]]>
        </example>
        <scad:example title="global" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYZDiameterAdjustment", 0.1]
          ...
          ]]>
        </scad:example>
        <example title="per-axis" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYZDiameterAdjustment="{x: 0.1, y: 0.1, z: 0}" />]]>
        </example>
        <scad:example title="per-axis" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYZDiameterAdjustment", [0.1, 0.1, 0]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TechnicHoles />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <value>0.3</value>
      <scad:value>0.3</scad:value>
    </holeXYZDiameterAdjustment>
    <holeXYZEdgeMode type="mbt:HoleEdgeMode | mbt:HoleEdgePair | mbt:HoleEdgeMap">
      <documentation>
        Controls whether partial (half) Technic holes are drawn at the edges
        of the block for X, Y, and Z direction holes.
        
        Type forms (SCAD 1:1):
        HoleEdgeMode — scalar broadcast to all hole axes ("none")
        HoleEdgePair — 2-element companion-edge pair (AxisAB)
        HoleEdgeMap — per hole-axis X/Y/Z map (AxisXYZ); each
        component is HoleEdgeMode or HoleEdgePair
        
        HoleEdgeMap axis entries resolve to an inner 2-element list [otherAxis1, otherAxis2]:
        X-entry: [Y-edge, Z-edge]
        Y-entry: [X-edge, Z-edge]
        Z-entry: [X-edge, Y-edge]
        
        Allowed values per position:
        "none" — no partial hole (default)
        "start" — half hole at the negative-direction edge
        "end" — half hole at the positive-direction edge
        "all" — half holes at both edges
        
        Restriction: The Z-edge position (2nd element) within X and Y inner
        list entries does not support "start". Allowed: "none", "end", "all".
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="all edges" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYZEdgeMode="All" />]]>
        </example>
        <scad:example title="all edges" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYZEdgeMode", "all"]
          ...
          ]]>
        </scad:example>
        <example title="pair" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYZEdgeMode="{a: Start, b: End}" />]]>
        </example>
        <scad:example title="pair" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYZEdgeMode", ["start", "end"]]
          ...
          ]]>
        </scad:example>
        <example title="per-axis map" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYZEdgeMode="{x: All, y: {a: Start, b: End}, z: None}" />]]>
        </example>
        <scad:example title="per-axis map" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYZEdgeMode", ["all", ["start", "end"], "none"]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TechnicHoles />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>None</value>
      <scad:value>none</scad:value>
    </holeXYZEdgeMode>
    <holeXYZInsetDepth type="type:Decimal(mbunit:MBU) | mbt:AxisXYZ(type:Decimal(mbunit:MBU))">
      <documentation>
        Depth of the inset ring around Technic holes, per axis.
        Follows the 1/2/3-value array rule.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="global" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYZInsetDepth="0.5" />]]>
        </example>
        <scad:example title="global" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYZInsetDepth", 0.5]
          ...
          ]]>
        </scad:example>
        <example title="per-axis" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYZInsetDepth="{x: 0.5, y: 0.5, z: 0.25}" />]]>
        </example>
        <scad:example title="per-axis" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYZInsetDepth", [0.5, 0.5, 0.25]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TechnicHoles />
        <mbgroup:RareAiUsage />
      </groups>
      <value>0.5</value>
      <scad:value>0.5</scad:value>
    </holeXYZInsetDepth>
    <holeXYZInsetDepthAdjustment type="type:Decimal(unit:Millimeter) | mbt:AxisXYZ(type:Decimal(unit:Millimeter))">
      <documentation>
        Calibration adjustment for holeXYZInsetDepth per axis.
        Follows the 1/2/3-value array rule.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="global" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYZInsetDepthAdjustment="0.05" />]]>
        </example>
        <scad:example title="global" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYZInsetDepthAdjustment", 0.05]
          ...
          ]]>
        </scad:example>
        <example title="per-axis" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYZInsetDepthAdjustment="{x: 0, y: 0, z: 0.05}" />]]>
        </example>
        <scad:example title="per-axis" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYZInsetDepthAdjustment", [0, 0, 0.05]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TechnicHoles />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <value>0</value>
      <scad:value>0</scad:value>
    </holeXYZInsetDepthAdjustment>
    <holeXYZInsetThickness type="type:Decimal(mbunit:MBU) | mbt:AxisXYZ(type:Decimal(mbunit:MBU))">
      <documentation>
        Width of the inset ring around Technic holes, per axis.
        In V2, insets existed only for x and y holes. Z holes now also
        support insets.
        Follows the 1/2/3-value array rule.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="global" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYZInsetThickness="0.3" />]]>
        </example>
        <scad:example title="global" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYZInsetThickness", 0.3]
          ...
          ]]>
        </scad:example>
        <example title="per-axis" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYZInsetThickness="{x: 0.3, y: 0.3, z: 0.2}" />]]>
        </example>
        <scad:example title="per-axis" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYZInsetThickness", [0.3, 0.3, 0.2]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TechnicHoles />
        <mbgroup:RareAiUsage />
      </groups>
      <value>0.375</value>
      <scad:value>0.375</scad:value>
    </holeXYZInsetThickness>
    <holeXYZInsetThicknessAdjustment type="type:Decimal(unit:Millimeter) | mbt:AxisXYZ(type:Decimal(unit:Millimeter))">
      <documentation>
        Calibration adjustment for holeXYZInsetThickness per axis.
        Follows the 1/2/3-value array rule.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="global" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYZInsetThicknessAdjustment="0.05" />]]>
        </example>
        <scad:example title="global" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYZInsetThicknessAdjustment", 0.05]
          ...
          ]]>
        </scad:example>
        <example title="per-axis" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYZInsetThicknessAdjustment="{x: 0.05, y: 0, z: 0}" />]]>
        </example>
        <scad:example title="per-axis" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYZInsetThicknessAdjustment", [0.05, 0, 0]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TechnicHoles />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <value>0</value>
      <scad:value>0</scad:value>
    </holeXYZInsetThicknessAdjustment>
    <holeXYZShift type="type:Boolean | mbt:AxisXYZ(type:Boolean)">
      <documentation>
        Whether Technic holes per axis are shifted by 1/2 stud.
        true: holes align with studs. false: holes sit between two studs.
        Follows the 1/2/3-value array rule.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="global" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYZShift="true" />]]>
        </example>
        <scad:example title="global" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYZShift", true]
          ...
          ]]>
        </scad:example>
        <example title="per-axis" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYZShift="{x: true, y: false, z: true}" />]]>
        </example>
        <scad:example title="per-axis" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYZShift", [true, false, true]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TechnicHoles />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>false</value>
      <scad:value>false</scad:value>
    </holeXYZShift>
    <holeXYZType type="mbt:HoleType | mbt:AxisXYZ(mbt:HoleType)">
      <documentation>
        Type of Technic holes per axis.
        pin: round holes. axle: cross-shaped holes.
        Follows the 1/2/3-value array rule.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="global" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYZType="Axle" />]]>
        </example>
        <scad:example title="global" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYZType", "axle"]
          ...
          ]]>
        </scad:example>
        <example title="per-axis" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock holeXYZType="{x: Pin, y: Pin, z: Axle}" />]]>
        </example>
        <scad:example title="per-axis" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["holeXYZType", ["pin", "pin", "axle"]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TechnicHoles />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>Pin</value>
      <scad:value>pin</scad:value>
    </holeXYZType>
    <id type="type:Text">
      <documentation>
        Unique identifier of the block or part within a block tree. Used primarily
        for debug output in mb_block() so that console messages can be clearly
        attributed to a specific block or part. May gain additional functions in
        the future.
        
        At undef, a random ID is generated.
        
        In composite blocks, blockId is resolved via mb_param_id() and then
        assigned to the wrapper block and all parts:
        
        blockId = mb_param_id(config, settings, "mm.my.package");
        // Wrapper block:
        ["id", blockId]
        // Part:
        ["id", mb_block_id(blockId, part_bottom)]
        
        mb_block_id(blockId, partName) produces a combined ID in the form
        "blockId/partName". Since blockId can be overridden from outside, this
        creates traceable, hierarchical ID chains across composite block trees.
        
        Example: if blockId = "mm.anyclosure.wall" and partName = "bottom",
        the resulting part ID is "mm.anyclosure.wall/bottom".
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="not set" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock />  <!-- id is not set — omit the property (runtime may generate a random ID) -->]]>
        </example>
        <scad:example title="not set" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["id", undef]
          ...
          ]]>
        </scad:example>
        <example title="explicit" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock id="mm.example.brick" />]]>
        </example>
        <scad:example title="explicit" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["id", "mm.example.brick"]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:System />
        <mbgroup:FrequentAiUsage />
      </groups>
    </id>
    <offset type="mbt:OffsetXYZ">
      <documentation>
        Final displacement of the brick. Applied last in the transformation
        chain. Same unit as size (grid units / multiples of a 1x1 plate).
        Origin depends on whether the brick is global or a child.
      </documentation>
      <examples>
        <example title="xyz offset" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock offset="{x: 1, y: 0, z: 0.5}" />]]>
        </example>
        <scad:example title="xyz offset" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["offset", [1, 0, 0.5]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Positioning />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>{x:0,y:0,z:0}</value>
      <scad:value>[0,0,0]</scad:value>
    </offset>
    <pcb type="type:Boolean | mbt:PcbMountingType">
      <documentation>
        PCB mounting mode. Combines the former pcb (bool) and pcbMountingType into one.
        false or "none": no PCB mounting features.
        "clips": frame for clipping in the PCB.
        "sockets": screw sockets for socket/screw mounting.
      </documentation>
      <changelog>
        <change version="3.0.0">
          Now accepts mounting type values directly: false/"none", "clips",
          "sockets".
          Merges the former pcb (bool) and pcbMountingType ("clips"|"screws") parameters.
        </change>
      </changelog>
      <examples>
        <example title="clips" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock pcb="Clips" />]]>
        </example>
        <scad:example title="clips" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["pcb", "clips"]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Pcb />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>false</value>
      <scad:value>false</scad:value>
    </pcb>
    <pcbDimensions type="mbt:SizeXYZ(type:Decimal(unit:Millimeter), type:Decimal(unit:Millimeter))">
      <documentation>
        Dimensions of the PCB in mm. Refers to the board size,
        especially relevant for pcb="clips".
      </documentation>
      <examples>
        <example title="board size" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock pcbDimensions="{x: 40, y: 60, z: 1.6}" />]]>
        </example>
        <scad:example title="board size" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["pcbDimensions", [40, 60, 1.6]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Pcb />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>{x:20,y:30,z:3}</value>
      <scad:value>[20,30,3]</scad:value>
    </pcbDimensions>
    <pcbOffset type="mbt:OffsetXY">
      <documentation>
        Offset of the entire PCB assembly (board and related features) from the
        brick center — not individual socket positions. For per-socket centers see pcbSockets.
      </documentation>
      <examples>
        <example title="shifted" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock pcbOffset="{x: 2, y: -1}" />]]>
        </example>
        <scad:example title="shifted" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["pcbOffset", [2, -1]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Pcb />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>{x:0,y:0}</value>
      <scad:value>[0,0]</scad:value>
    </pcbOffset>
    <pcbSocketDiameter type="type:Decimal(unit:Millimeter)">
      <documentation>
        Diameter of screw sockets.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="wider" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock pcbSocketDiameter="6" />]]>
        </example>
        <scad:example title="wider" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["pcbSocketDiameter", 6]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Pcb />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>5</value>
      <scad:value>5</scad:value>
    </pcbSocketDiameter>
    <pcbSocketHeight type="type:Decimal(unit:Millimeter)">
      <documentation>
        Height of the screw sockets.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="taller" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock pcbSocketHeight="4" />]]>
        </example>
        <scad:example title="taller" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["pcbSocketHeight", 4]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Pcb />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>3</value>
      <scad:value>3</scad:value>
    </pcbSocketHeight>
    <pcbSocketHoleDiameter type="type:Decimal(unit:Millimeter)">
      <documentation>
        Diameter of the screw hole inside the socket.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="wider hole" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock pcbSocketHoleDiameter="2.5" />]]>
        </example>
        <scad:example title="wider hole" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["pcbSocketHoleDiameter", 2.5]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Pcb />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>2.2</value>
      <scad:value>2.2</scad:value>
    </pcbSocketHoleDiameter>
    <pcbSockets type="mbt:PcbSocket[]">
      <documentation>
        List of individual screw-socket positions. Each PcbSocket { x, y } is one
        socket center from the brick center in mm (SCAD [x, y]). Distinct from pcbOffset, which
        shifts the entire PCB assembly as a whole.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="two sockets" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock pcbSockets="[{x: -5, y: -5}, {x: 5, y: 5}]" />]]>
        </example>
        <scad:example title="two sockets" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["pcbSockets", [[-5, -5], [5, 5]]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Pcb />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>[]</value>
      <scad:value>[]</scad:value>
    </pcbSockets>
    <pillarGapAutoConfig type="mbt:PillarGapAutoConfig">
      <documentation>
        Configures how pillars are placed when pillars = "auto". Used to
        avoid a full pillar grid on large plates, which would otherwise sit
        too tightly on other bricks — only the corners and a middle cross
        remain filled.
        
        cornerLength: length of the two legs of the pillar triangle at each
        corner (in grid units). The corner is filled with a triangular
        arrangement of pillars whose leg length is this value; the remaining
        corner pillars follow from the triangle shape.
        
        middleWidth: width of a pillar cross in the middle of the plate, in
        both X and Y direction. Each arm extends middleWidth / 2 from the
        center in both directions, forming a cross of pillars in the middle.
        
        Combines the V2 parameters pillarGapCornerLength and pillarGapMiddle
        into a single struct.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="wider gaps" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock pillarGapAutoConfig="{cornerLength: 2, middleWidth: 4}" />]]>
        </example>
        <scad:example title="wider gaps" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["pillarGapAutoConfig", [2, 4]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Pillars />
        <mbgroup:NeverAiUsage />
      </groups>
      <value>{cornerLength:2,middleWidth:10}</value>
      <scad:value>[2,10]</scad:value>
    </pillarGapAutoConfig>
    <pillarInnerClampThickness type="type:Decimal(unit:Millimeter)">
      <documentation>
        Thickness of the clamp inside Z-direction tubes.
        A constriction of the inner hole so studs grip inside the tube.
        Usually does not need adjustment.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="thicker" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock pillarInnerClampThickness="0.2" />]]>
        </example>
        <scad:example title="thicker" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["pillarInnerClampThickness", 0.2]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Tubes />
        <mbgroup:RareAiUsage />
      </groups>
      <value>0.1</value>
      <scad:value>0.1</scad:value>
    </pillarInnerClampThickness>
    <pillarOriginalWallThickness type="type:Decimal(mbunit:MBU)">
      <documentation>
        LEGO system constant used for automatic tube diameter calculation.
        Encodes the classic LEGO underside wall / tube proportion relative to the
        grid. Do not modify for printer calibration or ordinary brick design —
        change only when intentionally resizing the grid system itself (non-LEGO
        scale).
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="non-LEGO grid scale" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock pillarOriginalWallThickness="0.6" />]]>
        </example>
        <scad:example title="non-LEGO grid scale" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["pillarOriginalWallThickness", 0.6]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Tubes />
        <mbgroup:NeverAiUsage />
      </groups>
      <value>0.53125</value>
      <scad:value>0.53125</scad:value>
    </pillarOriginalWallThickness>
    <pillars type="type:Boolean">
      <documentation>
        Whether tubes/pins are drawn on the underside (baseCutoutType=standard).
        Use pillarAreas for per-region overrides; later areas win on overlap.
      </documentation>
      <examples>
        <example title="enabled" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock pillars="true" />]]>
        </example>
        <scad:example title="enabled" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["pillars", true]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Pillars />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>true</value>
      <scad:value>true</scad:value>
    </pillars>
    <pillarAreas type="mbt:SelectiveGrid(type:Boolean)[]">
      <documentation>
        Per-region overrides for pillars on the plate grid. Each entry is an inclusive
        rectangular range (start/end in GridUnitXY) with a Boolean value. Later entries win on
        overlap.
      </documentation>
      <examples>
        <example title="one area" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock pillars="true" pillarAreas="[{start:{x:0,y:0}, end:{x:1,y:1}, value:false}]" />]]>
        </example>
        <scad:example title="one area" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["pillars", true],
          ["pillarAreas", [[[0,0],[1,1],false]]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Pillars />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>[]</value>
      <scad:value>[]</scad:value>
    </pillarAreas>
    <pinDiameter type="mbt:Auto | type:Decimal(mbunit:MBU)">
      <documentation>
        Diameter of pins (small tubes) for bricks with size.x or size.y = 1.
        Automatically calculated.
      </documentation>
      <examples>
        <example title="explicit" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock pinDiameter="1.2" />]]>
        </example>
        <scad:example title="explicit" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["pinDiameter", 1.2]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Pins />
        <mbgroup:RareAiUsage />
      </groups>
      <value>Auto</value>
      <scad:value>auto</scad:value>
    </pinDiameter>
    <pinDiameterAdjustment type="type:Decimal(unit:Millimeter)">
      <documentation>
        Calibration adjustment for pin diameter.
      </documentation>
      <examples>
        <example title="tighter" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock pinDiameterAdjustment="-0.05" />]]>
        </example>
        <scad:example title="tighter" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["pinDiameterAdjustment", -0.05]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Pins />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <value>0</value>
      <scad:value>0</scad:value>
    </pinDiameterAdjustment>
    <ports type="type:Boolean | mbt:Port[]">
      <documentation>
        Cutouts on a face for connectors such as USB, screw terminals, etc.
        Each port is placed on a face using anchor + offset, then filled with
        one or more shapes (rect/circle) that are subtracted from the body.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="one port" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[
          <NativeBlock>
            <ports>
          [
            {
              face: YNeg, align: Center, offset: {a: 0, b: 0}, rotation: 0,
              shapes: [{
                type: Rect, offset: {a: 0, b: 0}, rotation: 0,
                setting: {size: {a: 8, b: 4}}
              }],
              depth: Auto
            }
          ]
            </ports>
          </NativeBlock>
          ]]>
        </example>
        <scad:example title="one port" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["ports", [["y-", "center", [0, 0], 0, [["rect", [0, 0], 0, [[8, 4]]]], "auto"]]]
          ...
          ]]>
        </scad:example>
        <example title="Raspberry Pi side ports (HDMI / power / headphone)" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[
          <NativeBlock>
            <ports>
          [
            {
              face: XNeg, align: Start, offset: {a: 4.35, b: 3.25}, rotation: 0,
              shapes: [{
                type: Circle, offset: {a: 0, b: 0}, rotation: 0,
                setting: {diameter: 7.1}
              }],
              depth: Auto
            },
            {
              face: XNeg, align: Start, offset: {a: 9.725, b: 2.6875}, rotation: 0,
              shapes: [{
                type: Rect, offset: {a: 0, b: 0}, rotation: 0,
                setting: {size: {a: 8.5, b: 3.9}, radius: 1.95}
              }],
              depth: Auto
            },
            {
              face: XNeg, align: Start, offset: {a: 7.0375, b: 3.5625}, rotation: 0,
              shapes: [
                {
                  type: Rect, offset: {a: 0, b: 0.575}, rotation: 0,
                  setting: {size: {a: 16.2, b: 5.2}, radius: 1.3}
                },
                {
                  type: Rect, offset: {a: 0, b: -1.425}, rotation: 0,
                  setting: {size: {a: 13.48, b: 3.5}, radius: 1.2}
                }
              ],
              depth: Auto
            },
            {
              face: YNeg, align: Start, offset: {a: 1.6125, b: 4.5}, rotation: 0,
              shapes: [{
                type: Rect, offset: {a: 0, b: 0}, rotation: 0,
                setting: {size: {a: 17, b: 14.4}, radius: 0.5}
              }],
              depth: Auto
            }
          ]
            </ports>
          </NativeBlock>
          ]]>
        </example>
        <scad:example title="Raspberry Pi side ports (HDMI / power / headphone)" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["ports", [
            ["x-", "start", [4.35, 3.25], 0, [ ["circle", [0, 0], 0, [7.1]] ], "auto"],
            ["x-", "start", [9.725, 2.6875], 0, [ ["rect", [0, 0], 0, [[8.5, 3.9], 1.95]] ], "auto"],
            ["x-", "start", [7.0375, 3.5625], 0, [
              ["rect", [0, 0.575], 0, [[16.2, 5.2], 1.3]],
              ["rect", [0, -1.425], 0, [[13.48, 3.5], 1.2]]
            ], "auto"],
            ["y-", "start", [1.6125, 4.5], 0, [ ["rect", [0, 0], 0, [[17, 14.4], 0.5]] ], "auto"]
          ]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:CoreGeometry />
        <mbgroup:NeverAiUsage />
      </groups>
      <value>false</value>
      <scad:value>false</scad:value>
    </ports>
    <printerLayerHeight type="type:Decimal(unit:Millimeter)">
      <documentation>
        Layer height of the 3D printer in mm. Typically set once in the
        global config. Used as the default value for other parameters when
        those parameters are set to "auto".
        
        Current auto-resolution rules:
        topPlateHelperHeight = "auto" → printerLayerHeight
        stabilizerLayerOffset = "auto" → printerLayerHeight
        screwHoleZHelperLayerOffset = "auto" → printerLayerHeight
        tongueGrooveDepthClearance = "auto" → printerLayerHeight
        tongueGrooveClampOffsetClearance = "auto" → printerLayerHeight
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="finer" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock printerLayerHeight="0.1" />]]>
        </example>
        <scad:example title="finer" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["printerLayerHeight", 0.1]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:System />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <value>0.2</value>
      <scad:value>0.2</scad:value>
    </printerLayerHeight>
    <printerNozzleDiameter type="type:Decimal(unit:Millimeter)">
      <documentation>
        Nozzle diameter of the 3D printer in mm. Typically set once in the
        global config. Used as the default value for other parameters when
        those parameters are set to "auto".
        
        Current auto-resolution rules:
        topPlateHelperThickness = "auto" → 0.5 * printerNozzleDiameter (min 0.1 mm)
        tongueGrooveThicknessClearance = "auto" → 0.25 * printerNozzleDiameter (min 0.1 mm)
        Any future *NozzleDiameter-based "auto" parameter follows the same min 0.1 mm rule.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="0.1 nozzle" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock printerNozzleDiameter="0.1" />]]>
        </example>
        <scad:example title="0.1 nozzle" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["printerNozzleDiameter", 0.1]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:System />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <value>0.4</value>
      <scad:value>0.4</scad:value>
    </printerNozzleDiameter>
    <quality type="mbt:QualityPreset">
      <documentation>
        User-level quality preset. Controls overall rendering quality
        independent of renderer implementation.
        "preview" — fast, reduced quality for interactive preview
        "normal" — balanced quality for general use
        "print" — high quality for 3D print export
        "render" — maximum quality for final renders
      </documentation>
      <examples>
        <example title="high" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock quality="High" />]]>
        </example>
        <scad:example title="high" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["quality", "high"]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Quality />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>Normal</value>
      <scad:value>normal</scad:value>
    </quality>
    <recess type="type:Boolean">
      <documentation>
        Whether a top-down cavity is created, forming a box with four walls
        and no lid. When active with baseCutoutType=standard, the baseCutout
        depth is reduced to minimum (1 mbu) if recessDepth=auto.
      </documentation>
      <examples>
        <example title="enabled" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock recess="true" />]]>
        </example>
        <scad:example title="enabled" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["recess", true]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Recess />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>false</value>
      <scad:value>false</scad:value>
    </recess>
    <recessAdjustment type="mbt:Auto | mbt:FaceMapXYZ(type:Decimal(unit:Millimeter))">
      <documentation>
        Per-side calibration adjustment for the inner recess walls and floor.
        Applied to the interior surfaces of the recess (the inner box).
        
        At "auto", uses the same values as baseAdjustment (except z+, which
        is not applicable to the recess).
        
        IMPORTANT — z- behaviour differs from baseAdjustment:
        The z- value is applied to the recess floor height (moves the floor).
        No downward shift or z+ extension occurs — it is a direct floor adjustment.
        
        Sign convention: negative values enlarge the recess (shrink the inner
        walls inward in x/y, and lower the floor in z-). Positive values
        shrink the recess.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="floor down" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock recessAdjustment="{xNeg: 0, xPos: 0, yNeg: 0, yPos: 0, zNeg: -0.1, zPos: 0}" />]]>
        </example>
        <scad:example title="floor down" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["recessAdjustment", [0, 0, 0, 0, -0.1, 0]]
          ...
          ]]>
        </scad:example>
        <example title="faces" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock recessAdjustment="{xNeg: 0, xPos: 0, yNeg: 0, yPos: 0, zNeg: 0, zPos: 0.1}" />]]>
        </example>
        <scad:example title="faces" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["recessAdjustment", [0, 0, 0, 0, 0, 0.1]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Calibration />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <value>Auto</value>
      <scad:value>auto</scad:value>
    </recessAdjustment>
    <recessDepth type="mbt:Auto | type:Decimal(mbunit:GridUnitZ)">
      <documentation>
        Depth of the recess cavity, expressed as multiples of one plate (unitGrid[1] =
        2 mbu).
        At "auto" depth is maximized.
        When set to an absolute value, the baseCutout (standard) goes up to
        baseCutoutMaxDepth and the remainder is filled with the top plate
        wall between baseCutout and recess.
      </documentation>
      <changelog>
        <change version="3.0.0">
          Unit clarified: unitGrid[1] (plates), not raw mbu.
        </change>
      </changelog>
      <examples>
        <example title="two plates" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock recessDepth="2" />]]>
        </example>
        <scad:example title="two plates" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["recessDepth", 2]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Recess />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>Auto</value>
      <scad:value>auto</scad:value>
    </recessDepth>
    <recessRoundingRadius type="mbt:Auto | type:Decimal(mbunit:GridUnitXY) | mbt:PlaneRoundingMap">
      <documentation>
        Rounding radius of the recess cavity corners on the horizontal (Z-face)
        plane only — not a full BaseRoundingMap like baseRoundingRadius. Expanded form is
        PlaneRoundingMap (CornerMap with GridUnitXY). Auto derives from the block's
        baseRoundingRadius. Usually does not need adjustment.
      </documentation>
      <examples>
        <example title="rounded" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock recessRoundingRadius="0.5" />]]>
        </example>
        <scad:example title="rounded" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["recessRoundingRadius", 0.5]
          ...
          ]]>
        </scad:example>
        <example title="per-corner" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock recessRoundingRadius="{sw: 0.5, nw: 0.5, ne: 0.5, se: 0.5}" />]]>
        </example>
        <scad:example title="per-corner" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["recessRoundingRadius", [0.5, 0.5, 0.5, 0.5]]
          ...
          ]]>
        </scad:example>
        <example title="anisotropic corner" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock recessRoundingRadius="{sw: {a: 0.5, b: 0.25}, nw: 0.5, ne: 0.5, se: {a: 0.5, b: 0.25}}" />]]>
        </example>
        <scad:example title="anisotropic corner" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["recessRoundingRadius", [[0.5, 0.25], 0.5, 0.5, [0.5, 0.25]]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Recess />
        <mbgroup:RareAiUsage />
      </groups>
      <value>Auto</value>
      <scad:value>auto</scad:value>
    </recessRoundingRadius>
    <recessStudPadding type="mbt:FaceMapXY(type:Decimal(mbunit:GridUnitXY))">
      <documentation>
        Padding from the recess wall inward. Determines whether outer studs
        in the recess are hidden. Studs whose center is closer to the recess
        wall than this padding value are not drawn.
      </documentation>
      <examples>
        <example title="more padding" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock recessStudPadding="{xNeg: 0.4, xPos: 0.4, yNeg: 0.4, yPos: 0.4}" />]]>
        </example>
        <scad:example title="more padding" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["recessStudPadding", [0.4, 0.4, 0.4, 0.4]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Recess />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>0.2</value>
      <scad:value>0.2</scad:value>
    </recessStudPadding>
    <recessStudShift type="type:Boolean">
      <documentation>
        Whether recess floor studs are shifted by 1/2 stud in X and Y.
        false: studs sit at standard positions.
        true: studs are shifted by half a stud in both directions.
      </documentation>
      <examples>
        <example title="shifted" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock recessStudShift="true" />]]>
        </example>
        <scad:example title="shifted" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["recessStudShift", true]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Recess />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>false</value>
      <scad:value>false</scad:value>
    </recessStudShift>
    <recessStudType type="mbt:StudType">
      <documentation>
        Type of studs on the recess floor.
        solid: massive studs. hollow: studs with a hole in the center.
      </documentation>
      <examples>
        <example title="hollow" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock recessStudType="Hollow" />]]>
        </example>
        <scad:example title="hollow" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["recessStudType", "hollow"]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Recess />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>Solid</value>
      <scad:value>solid</scad:value>
    </recessStudType>
    <recessStuds type="type:Boolean">
      <documentation>
        Whether studs are drawn on the recess floor. Studs are at the same
        X/Y position as without recess. Only drawn if a 1x1 brick fits —
        studs too close to the recess wall are hidden.
      </documentation>
      <examples>
        <example title="enabled" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock recessStuds="true" />]]>
        </example>
        <scad:example title="enabled" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["recessStuds", true]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Recess />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>true</value>
      <scad:value>true</scad:value>
    </recessStuds>
    <recessWallGapStuds type="type:Boolean">
      <documentation>
        Whether studs are shown inside openings created by recessWallGaps.
        Only effective in combination with recessStuds = true.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="enabled" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock recessWallGapStuds="true" />]]>
        </example>
        <scad:example title="enabled" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["recessWallGapStuds", true]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Recess />
        <mbgroup:NeverAiUsage />
      </groups>
      <value>false</value>
      <scad:value>false</scad:value>
    </recessWallGapStuds>
    <recessWallGaps type="mbt:RecessWallGap[]">
      <documentation>
        Openings in recess walls. Each entry specifies a side and optional
        left/right offsets to create partial or full wall openings.
        Also creates matching openings in tongue and groove.
      </documentation>
      <changelog>
        <change version="3.0.0">
          Short form input added; sides can now be specified as strings.
        </change>
      </changelog>
      <examples>
        <example title="one gap" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock recessWallGaps="[{face: YPos, pos: 0, len: 1}]" />]]>
        </example>
        <scad:example title="one gap" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["recessWallGaps", [["y+", 0, 1]]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Recess />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>[]</value>
      <scad:value>[]</scad:value>
    </recessWallGaps>
    <recessWallStuds type="type:Boolean">
      <documentation>
        Whether studs are drawn on the recess wall (the vertical wall of the
        recess cavity). Only active when studs = true and the recess wall is
        thick enough to fit studs.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="enabled" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock recessWallStuds="true" />]]>
        </example>
        <scad:example title="enabled" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["recessWallStuds", true]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Recess />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>true</value>
      <scad:value>true</scad:value>
    </recessWallStuds>
    <recessWallThickness type="mbt:FaceMapXY(type:Decimal(mbunit:GridUnitXY))">
      <documentation>
        Wall thickness of the recess cavity (box wall thickness).
      </documentation>
      <examples>
        <example title="thicker sides" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock recessWallThickness="{xNeg: 1, xPos: 1, yNeg: 1, yPos: 1}" />]]>
        </example>
        <scad:example title="thicker sides" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["recessWallThickness", [1, 1, 1, 1]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Recess />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>0.333</value>
      <scad:value>0.333</scad:value>
    </recessWallThickness>
    <reliefCut type="type:Boolean">
      <documentation>
        Whether a relief cut is applied at the outer bottom edge of the block.
        Cuts a portion of the outer wall, resulting in a thinner outer wall
        in the lower area. The inner wall is not affected (baseCutoutType=standard).
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="enabled" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock reliefCut="true" />]]>
        </example>
        <scad:example title="enabled" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["reliefCut", true]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:ReliefCut />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>false</value>
      <scad:value>false</scad:value>
    </reliefCut>
    <reliefCutHeight type="type:Decimal(mbunit:MBU)">
      <documentation>
        Height of the relief cut.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="taller" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock reliefCutHeight="0.75" />]]>
        </example>
        <scad:example title="taller" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["reliefCutHeight", 0.75]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:ReliefCut />
        <mbgroup:RareAiUsage />
      </groups>
      <value>0.375</value>
      <scad:value>0.375</scad:value>
    </reliefCutHeight>
    <reliefCutThickness type="type:Decimal(mbunit:MBU)">
      <documentation>
        Thickness of the cut-away portion.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="thicker" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock reliefCutThickness="0.5" />]]>
        </example>
        <scad:example title="thicker" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["reliefCutThickness", 0.5]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:ReliefCut />
        <mbgroup:RareAiUsage />
      </groups>
      <value>0.375</value>
      <scad:value>0.375</scad:value>
    </reliefCutThickness>
    <render type="type:Boolean">
      <documentation>
        Whether the block is rendered at all. When false, the block and all
        its children produce no geometry. Used in composite blocks to
        conditionally show or hide individual parts based on assemblyParts.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="off" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock render="false" />]]>
        </example>
        <scad:example title="off" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["render", false]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:System />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>true</value>
      <scad:value>true</scad:value>
    </render>
    <rotation type="mbt:RotationXYZ">
      <documentation>
        Free geometric rotation applied after align. Not grid-safe —
        can break alignment and connectivity. The pivot is the relative
        zero point which varies depending on align. Children are rotated
        along with the parent.
      </documentation>
      <examples>
        <example title="tilt" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock rotation="{x: 0, y: 0, z: 45}" />]]>
        </example>
        <scad:example title="tilt" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["rotation", [0, 0, 45]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Positioning />
        <mbgroup:RareAiUsage />
      </groups>
      <value>[0,0,0]</value>
      <scad:value>[0,0,0]</scad:value>
    </rotation>
    <rotationOffset type="mbt:OffsetXYZ">
      <documentation>
        Shifts the rotation pivot before rotation is applied.
      </documentation>
      <examples>
        <example title="pivot shift" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock rotationOffset="{x: 1, y: 0, z: 0}" />]]>
        </example>
        <scad:example title="pivot shift" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["rotationOffset", [1, 0, 0]]
          ...
          ]]>
        </scad:example>
        <example title="xy pair" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock rotationOffset="{x: 0.5, y: -0.25}" />]]>
        </example>
        <scad:example title="xy pair" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["rotationOffset", [0.5, -0.25]]
          ...
          ]]>
        </scad:example>
        <example title="xyz offset" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock rotationOffset="{x: 1, y: 0, z: 0.5}" />]]>
        </example>
        <scad:example title="xyz offset" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["rotationOffset", [1, 0, 0.5]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Positioning />
        <mbgroup:RareAiUsage />
      </groups>
      <value>[0,0,0]</value>
      <scad:value>[0,0,0]</scad:value>
    </rotationOffset>
    <rotationOffsetRevert type="type:Boolean">
      <documentation>
        Whether the rotationOffset is reversed after rotation.
      </documentation>
      <examples>
        <example title="revert" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock rotationOffsetRevert="true" />]]>
        </example>
        <scad:example title="revert" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["rotationOffsetRevert", true]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Positioning />
        <mbgroup:RareAiUsage />
      </groups>
      <value>true</value>
      <scad:value>true</scad:value>
    </rotationOffsetRevert>
    <scadPreviewMaxMult type="type:Decimal">
      <documentation>
        Maximum preview segment length multiplier.
        Used together with scadPreviewQuality.
        Higher values allow more aggressive quality reduction during preview.
      </documentation>
      <examples>
        <example title="higher" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock scadPreviewMaxMult="2" />]]>
        </example>
        <scad:example title="higher" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["scadPreviewMaxMult", 2]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Quality />
        <mbgroup:RareAiUsage />
      </groups>
      <value>2.5</value>
      <scad:value>2.5</scad:value>
    </scadPreviewMaxMult>
    <scadPreviewPreRender type="type:Boolean">
      <documentation>
        Whether the block is rendered as mesh in OpenSCAD preview mode
        instead of CSG.
      </documentation>
      <examples>
        <example title="on" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock scadPreviewPreRender="true" />]]>
        </example>
        <scad:example title="on" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["scadPreviewPreRender", true]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Quality />
        <mbgroup:RareAiUsage />
      </groups>
      <value>true</value>
      <scad:value>true</scad:value>
    </scadPreviewPreRender>
    <scadPreviewPreRenderConvexity type="type:Integer">
      <documentation>
        Convexity parameter passed to OpenSCAD render() function.
        Used with scadPreviewPreRender.
      </documentation>
      <examples>
        <example title="higher" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock scadPreviewPreRenderConvexity="4" />]]>
        </example>
        <scad:example title="higher" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["scadPreviewPreRenderConvexity", 4]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Quality />
        <mbgroup:RareAiUsage />
      </groups>
      <value>25</value>
      <scad:value>25</scad:value>
    </scadPreviewPreRenderConvexity>
    <scadPreviewQuality type="type:Decimal">
      <documentation>
        Additional OpenSCAD preview quality reduction factor.
        1.0 = disabled. 0.0 = strongest preview reduction.
        Only applied when $preview is true.
      </documentation>
      <examples>
        <example title="finer" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock scadPreviewQuality="0.5" />]]>
        </example>
        <scad:example title="finer" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["scadPreviewQuality", 0.5]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Quality />
        <mbgroup:RareAiUsage />
      </groups>
      <value>1</value>
      <scad:value>1</scad:value>
    </scadPreviewQuality>
    <scadQualityClassFactors type="mbt:ScadQualityClassFactors">
      <documentation>
        Per quality-class segment length multipliers.
        Higher values reduce quality and improve render performance.
      </documentation>
      <examples>
        <example title="higher visual" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[
          <NativeBlock>
            <scadQualityClassFactors>
          {
            functional: 1.0,
            visual: 1.5,
            hidden: 2.0
          }
            </scadQualityClassFactors>
          </NativeBlock>
          ]]>
        </example>
        <scad:example title="higher visual" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["scadQualityClassFactors", [1.0, 1.5, 2.0]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Quality />
        <mbgroup:RareAiUsage />
      </groups>
      <value>{functional:1,visual:1.35,hidden:2.25}</value>
      <scad:value>[1,1.35,2.25]</scad:value>
    </scadQualityClassFactors>
    <scadQualityClassMinSegments type="mbt:ScadQualityClassMinSegments">
      <documentation>
        Minimum full-circle segment count per quality class.
        Prevents small radii from becoming overly coarse.
      </documentation>
      <examples>
        <example title="more segments" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[
          <NativeBlock>
            <scadQualityClassMinSegments>
          {
            functional: 24,
            visual: 16,
            hidden: 8
          }
            </scadQualityClassMinSegments>
          </NativeBlock>
          ]]>
        </example>
        <scad:example title="more segments" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["scadQualityClassMinSegments", [24, 16, 8]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Quality />
        <mbgroup:RareAiUsage />
      </groups>
      <value>{functional:16,visual:12,hidden:8}</value>
      <scad:value>[16,12,8]</scad:value>
    </scadQualityClassMinSegments>
    <scadQualityProfile type="mbt:ScadQualityProfile">
      <documentation>
        OpenSCAD quality profile mapping. Maps each quality preset to
        segment length (mm) and maximum segment count.
        Smaller segmentLengthMm increases quality.
        maxSegments limits the maximum full-circle resolution.
      </documentation>
      <examples>
        <example title="finer preview" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[
          <NativeBlock>
            <scadQualityProfile>
          {
            preview: { length: 0.4, segments: 24 },
            normal: { length: 0.3, segments: 32 },
            print: { length: 0.2, segments: 48 },
            render: { length: 0.12, segments: 96 }
          }
            </scadQualityProfile>
          </NativeBlock>
          ]]>
        </example>
        <scad:example title="finer preview" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["scadQualityProfile", [[0.4, 24], [0.3, 32], [0.2, 48], [0.12, 96]]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Quality />
        <mbgroup:RareAiUsage />
      </groups>
      <value>{preview:{length:0.55,segments:32},normal:{length:0.38,segments:48},print:{length:0.28,segments:64},render:{length:0.16,segments:120}}</value>
      <scad:value>[[0.55,32],[0.38,48],[0.28,64],[0.16,120]]</scad:value>
    </scadQualityProfile>
    <scadQualitySegmentMultiplier type="type:Decimal">
      <documentation>
        Global segment length multiplier. Applied after quality preset
        and class factor calculation.
        > 1.0: lower quality, faster rendering.
        &lt; 1.0: higher quality, slower rendering.
        Useful for global tuning without modifying quality profiles.
      </documentation>
      <examples>
        <example title="higher" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock scadQualitySegmentMultiplier="1.5" />]]>
        </example>
        <scad:example title="higher" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["scadQualitySegmentMultiplier", 1.5]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Quality />
        <mbgroup:RareAiUsage />
      </groups>
      <value>1</value>
      <scad:value>1</scad:value>
    </scadQualitySegmentMultiplier>
    <scale type="type:Decimal">
      <documentation>
        Global scaling factor. Scales all mbu-based values.
        mbu values themselves remain unchanged; only the resulting
        physical dimensions change. Adjustments (mm) do NOT scale.
      </documentation>
      <examples>
        <example title="double" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock scale="2" />]]>
        </example>
        <scad:example title="double" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["scale", 2]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:System />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>1</value>
      <scad:value>1</scad:value>
    </scale>
    <screwHoleDepth type="type:Decimal(unit:Millimeter)">
      <documentation>
        Default depth of screw holes. Can be overridden per hole in screwHoles.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="deeper" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock screwHoleDepth="8" />]]>
        </example>
        <scad:example title="deeper" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["screwHoleDepth", 8]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:ScrewHoles />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>4</value>
      <scad:value>4</scad:value>
    </screwHoleDepth>
    <screwHoleDiameter type="type:Decimal(unit:Millimeter)">
      <documentation>
        Default diameter of screw holes. Can be overridden per hole in screwHoles.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="M3" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock screwHoleDiameter="3.2" />]]>
        </example>
        <scad:example title="M3" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["screwHoleDiameter", 3.2]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:ScrewHoles />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>1.6</value>
      <scad:value>1.6</scad:value>
    </screwHoleDiameter>
    <screwHoleInsetDepth type="type:Decimal(unit:Millimeter)">
      <documentation>
        Default inset ring depth for screw holes. 0 = no inset.
        Can be overridden per hole in screwHoles.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="inset" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock screwHoleInsetDepth="1" />]]>
        </example>
        <scad:example title="inset" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["screwHoleInsetDepth", 1]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:ScrewHoles />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>0.8</value>
      <scad:value>0.8</scad:value>
    </screwHoleInsetDepth>
    <screwHoleInsetThickness type="type:Decimal(unit:Millimeter)">
      <documentation>
        Default inset ring thickness around screw holes. 0 = no inset.
        Can be overridden per hole in screwHoles.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="inset ring" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock screwHoleInsetThickness="0.5" />]]>
        </example>
        <scad:example title="inset ring" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["screwHoleInsetThickness", 0.5]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:ScrewHoles />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>0.6</value>
      <scad:value>0.6</scad:value>
    </screwHoleInsetThickness>
    <screwHoleZHelperHeight type="type:Decimal(unit:Millimeter)">
      <documentation>
        Height of the helper layers for Z-face screw holes.
      </documentation>
      <examples>
        <example title="taller helper" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock screwHoleZHelperHeight="0.4" />]]>
        </example>
        <scad:example title="taller helper" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["screwHoleZHelperHeight", 0.4]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:ScrewHoles />
        <mbgroup:RareAiUsage />
      </groups>
      <value>0.2</value>
      <scad:value>0.2</scad:value>
    </screwHoleZHelperHeight>
    <screwHoleZHelperLayerOffset type="type:Decimal(unit:Millimeter)">
      <documentation>
        Offset between the two helper layers for Z-face screw holes.
        "auto" uses printerLayerHeight.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="larger offset" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock screwHoleZHelperLayerOffset="0.3" />]]>
        </example>
        <scad:example title="larger offset" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["screwHoleZHelperLayerOffset", 0.3]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:ScrewHoles />
        <mbgroup:RareAiUsage />
      </groups>
      <value>0.2</value>
      <scad:value>0.2</scad:value>
    </screwHoleZHelperLayerOffset>
    <screwHoleZHelperThickness type="type:Decimal(unit:Millimeter)">
      <documentation>
        Thickness of print helpers for Z-face screw holes on the underside.
        Required for baseCutoutType=standard to avoid needing print support.
      </documentation>
      <examples>
        <example title="thicker helper" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock screwHoleZHelperThickness="1.0" />]]>
        </example>
        <scad:example title="thicker helper" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["screwHoleZHelperThickness", 1.0]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:ScrewHoles />
        <mbgroup:RareAiUsage />
      </groups>
      <value>0.8</value>
      <scad:value>0.8</scad:value>
    </screwHoleZHelperThickness>
    <screwHoles type="mbt:ScrewHole[]">
      <documentation>
        Mounting screw holes on any face of the brick. Each entry defines one hole
        with a face, a grid position, and optional per-hole size overrides.
        Global defaults for diameter, depth, and inset are set via the
        screwHoleDiameter, screwHoleDepth, screwHoleInsetThickness, screwHoleInsetDepth
        parameters.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="one hole" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock screwHoles="[{face: ZPos, offset: {a: 1, b: 2}}]" />]]>
        </example>
        <scad:example title="one hole" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["screwHoles", [["z+", [1, 2]]]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:ScrewHoles />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>[]</value>
      <scad:value>[]</scad:value>
    </screwHoles>
    <size type="mbt:SizeXYZ">
      <documentation>
        Size of the bounding box in grid units. Defines the brick body;
        studs are excluded from the bounding box. For simple bricks the
        bounding box matches the body exactly.
        X/Y count in studs, Z counts in plates.
        Must contain integer values only. Fractional values are not permitted.
      </documentation>
      <changelog>
        <change version="3.0.0">
          Values must be integers. Fractional values are no longer permitted.
        </change>
      </changelog>
      <examples>
        <example title="2x4 plate" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock size="{x: 2, y: 4, z: 1}" />]]>
        </example>
        <scad:example title="2x4 plate" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["size", [2, 4, 1]]
          ...
          ]]>
        </scad:example>
        <example title="xyz size" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock size="{x: 2, y: 4, z: 3}" />]]>
        </example>
        <scad:example title="xyz size" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["size", [2, 4, 3]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:CoreGeometry />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>[1,1,1]</value>
      <scad:value>[1,1,1]</scad:value>
    </size>
    <sizeAdjustment type="mbt:FaceMapXYZ(type:Decimal(unit:Millimeter))">
      <documentation>
        Global calibration adjustment for block size, applied uniformly.
        sideXYAdj is applied to all four horizontal sides (x-, x+, y-, y+).
        heightAdj is applied to the top face (z+) only.
        
        Typically set once in the global config and applies to all blocks.
        For per-block or per-side overrides, use baseAdjustment.
        
        Example: [-0.1, 0] reduces x-, x+, y-, y+ by 0.1mm each, no height change.
        
        Never scales with the scale parameter.
      </documentation>
      <since>
        3.0.0
      </since>
      <changelog>
        <change version="3.0.0">
          Now also accepts a single number (applies to XY only, Z = 0), in
          addition
          to the previous 2-element array [XYAdj, ZAdj].
        </change>
      </changelog>
      <examples>
        <example title="xy shrink" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock sizeAdjustment="[-0.2, 0]" />]]>
        </example>
        <scad:example title="xy shrink" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["sizeAdjustment", [-0.2, 0]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Calibration />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <value>[-0.1,0]</value>
      <scad:value>[-0.1,0]</scad:value>
    </sizeAdjustment>
    <sizeMod type="mbt:FaceMapXYZ(type:Decimal(mbunit:GridUnitXY))">
      <documentation>
        Semantic size modification per side, in grid units. Adjusts the
        brick geometry while keeping it structurally intact (walls, studs,
        connectors remain consistent). Unlike crop, sizeMod does not brutally
        cut geometry — it semantically shifts where the brick starts/ends on
        each side.
        
        Example: sizeMod = [0.5, 0, 0, 0, 0, 0] shifts the x- side inward
        by 0.5 grid units, producing a half-brick that starts at 0.5 grid
        units from the original x- edge.
        
        z- behaviour: negative z- values shift the brick downward by the
        same amount (like a downward offset), independent of the regular
        offset parameter. The z+ side is extended correspondingly.
        
        Difference to baseAdjustment: sizeMod is a semantic geometry change
        (half-bricks, partial bricks). baseAdjustment is for printer
        calibration and gap closing in composite blocks.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="half brick" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock sizeMod="{xNeg: 0, xPos: 0, yNeg: 0, yPos: 0, zNeg: 0, zPos: -0.5}" />]]>
        </example>
        <scad:example title="half brick" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["sizeMod", [0, 0, 0, 0, 0, -0.5]]
          ...
          ]]>
        </scad:example>
        <example title="faces" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock sizeMod="{xNeg: 0, xPos: 0, yNeg: 0, yPos: 0, zNeg: 0, zPos: 0.1}" />]]>
        </example>
        <scad:example title="faces" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["sizeMod", [0, 0, 0, 0, 0, 0.1]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:CoreGeometry />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>{xNeg:0,xPos:0,yNeg:0,yPos:0,zNeg:0,zPos:0}</value>
      <scad:value>[0,0,0,0,0,0]</scad:value>
    </sizeMod>
    <slope type="type:Boolean | mbt:FaceMapXY(type:Decimal(mbunit:GridUnitXY))">
      <documentation>
        Defines slopes per side (0-3).
        Positive values: slope on top surface (z+), starting at slopeBaseHeightBottom
        and going the specified number of plates toward the center upward.
        Negative values: inverted slope on bottom surface (z-), starting at
        blockHeight - slopeBaseHeightTop going down to the floor.
        Slope and bevel can be used together.
      </documentation>
      <changelog>
        <change version="3.0.0">
          Can now be combined with bevel. The conflicts_with constraint has
          been removed.
        </change>
      </changelog>
      <examples>
        <example title="no slope (boolean)" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock slope="false" />]]>
        </example>
        <scad:example title="no slope (boolean)" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["slope", false]
          ...
          ]]>
        </scad:example>
        <example title="no slope (zero map)" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock slope="{xNeg: 0, xPos: 0, yNeg: 0, yPos: 0}" />]]>
        </example>
        <scad:example title="no slope (zero map)" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["slope", [0, 0, 0, 0]]
          ...
          ]]>
        </scad:example>
        <example title="positive slope" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock slope="{xNeg: 1, xPos: 1, yNeg: 0, yPos: 0}" />]]>
        </example>
        <scad:example title="positive slope" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["slope", [1, 1, 0, 0]]
          ...
          ]]>
        </scad:example>
        <example title="inverted slope" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock slope="{xNeg: 0, xPos: 2, yNeg: -2, yPos: 0}" />]]>
        </example>
        <scad:example title="inverted slope" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["slope", [0, 2, -2, 0]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:CoreGeometry />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>false</value>
      <scad:value>false</scad:value>
    </slope>
    <slopeBaseHeightBottom type="type:Decimal(mbunit:MBU)">
      <documentation>
        Start height of the slope on the respective side for positive slopes.
        Usually does not need adjustment.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="higher base" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock slopeBaseHeightBottom="1.5" />]]>
        </example>
        <scad:example title="higher base" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["slopeBaseHeightBottom", 1.5]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:CoreGeometry />
        <mbgroup:RareAiUsage />
      </groups>
      <value>1.333</value>
      <scad:value>1.333</scad:value>
    </slopeBaseHeightBottom>
    <slopeBaseHeightInner type="type:Decimal(mbunit:MBU)">
      <documentation>
        Start height of the slope on the inner wall of the brick.
        Usually does not need adjustment.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="higher inner" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock slopeBaseHeightInner="1.25" />]]>
        </example>
        <scad:example title="higher inner" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["slopeBaseHeightInner", 1.25]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:CoreGeometry />
        <mbgroup:RareAiUsage />
      </groups>
      <value>1.125</value>
      <scad:value>1.125</scad:value>
    </slopeBaseHeightInner>
    <slopeBaseHeightTop type="type:Decimal(mbunit:MBU)">
      <documentation>
        Height subtracted from block height for inverted (negative) slopes.
        Usually does not need adjustment.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="higher top" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock slopeBaseHeightTop="1.25" />]]>
        </example>
        <scad:example title="higher top" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["slopeBaseHeightTop", 1.25]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:CoreGeometry />
        <mbgroup:RareAiUsage />
      </groups>
      <value>1</value>
      <scad:value>1</scad:value>
    </slopeBaseHeightTop>
    <stabilizerExpansion type="type:Integer">
      <documentation>
        If > 0, every n-th grid element is taller and extends down to
        stabilizerExpansionOffset from the bottom edge.
      </documentation>
      <examples>
        <example title="wider" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock stabilizerExpansion="3" />]]>
        </example>
        <scad:example title="wider" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["stabilizerExpansion", 3]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:PrintHelpers />
        <mbgroup:RareAiUsage />
      </groups>
      <value>2</value>
      <scad:value>2</scad:value>
    </stabilizerExpansion>
    <stabilizerExpansionOffset type="type:Decimal(mbunit:MBU)">
      <documentation>
        Distance of expanded grid elements from the bottom edge.
      </documentation>
      <examples>
        <example title="larger offset" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock stabilizerExpansionOffset="1.5" />]]>
        </example>
        <scad:example title="larger offset" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["stabilizerExpansionOffset", 1.5]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:PrintHelpers />
        <mbgroup:RareAiUsage />
      </groups>
      <value>1</value>
      <scad:value>1</scad:value>
    </stabilizerExpansionOffset>
    <stabilizerHeight type="type:Decimal(mbunit:MBU)">
      <documentation>
        Height of the stabilizer grid.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="taller" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock stabilizerHeight="0.75" />]]>
        </example>
        <scad:example title="taller" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["stabilizerHeight", 0.75]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:PrintHelpers />
        <mbgroup:RareAiUsage />
      </groups>
      <value>0.5</value>
      <scad:value>0.5</scad:value>
    </stabilizerHeight>
    <stabilizerLayerOffset type="mbt:Auto | type:Decimal(unit:Millimeter)">
      <documentation>
        Offset between the first and subsequent grid layers.
        Ensures subsequent layers have a surface to print on.
        "auto" uses printerLayerHeight.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="explicit mm" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock stabilizerLayerOffset="0.2" />]]>
        </example>
        <scad:example title="explicit mm" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["stabilizerLayerOffset", 0.2]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:PrintHelpers />
        <mbgroup:RareAiUsage />
      </groups>
      <value>Auto</value>
      <scad:value>auto</scad:value>
    </stabilizerLayerOffset>
    <stabilizerThickness type="type:Decimal(mbunit:MBU)">
      <documentation>
        Width of a single grid strut.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="thicker" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock stabilizerThickness="0.75" />]]>
        </example>
        <scad:example title="thicker" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["stabilizerThickness", 0.75]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:PrintHelpers />
        <mbgroup:RareAiUsage />
      </groups>
      <value>0.5</value>
      <scad:value>0.5</scad:value>
    </stabilizerThickness>
    <stabilizers type="type:Boolean">
      <documentation>
        Whether a stabilizer grid connecting tubes to side walls is printed
        (baseCutoutType=standard). Provides stability and improves
        printability of the top plate. Usually does not need adjustment.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="disabled" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock stabilizers="false" />]]>
        </example>
        <scad:example title="disabled" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["stabilizers", false]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:PrintHelpers />
        <mbgroup:RareAiUsage />
      </groups>
      <value>true</value>
      <scad:value>true</scad:value>
    </stabilizers>
    <studBaseOverlap type="type:Decimal(mbunit:MBU)">
      <documentation>
        How deeply the stud is sunk into the block body (overlap with base).
        Ensures the stud is geometrically connected to the body (no floating geometry).
        Also prevents gaps when grille or surfacePattern is active.
        Can be set to 0 when a block has base=false but still renders studs
        (e.g. stud-only decorative layers in composite blocks).
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="more overlap" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studBaseOverlap="0.4" />]]>
        </example>
        <scad:example title="more overlap" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studBaseOverlap", 0.4]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Studs />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>0.25</value>
      <scad:value>0.25</scad:value>
    </studBaseOverlap>
    <studClampHeight type="type:Decimal(mbunit:MBU)">
      <documentation>
        Height of the stud clamp ring at the upper stud edge.
        Creates a near-permanent connection between two bricks.
        Only active when studClampThickness > 0.
      </documentation>
      <examples>
        <example title="taller clamp" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studClampHeight="0.75" />]]>
        </example>
        <scad:example title="taller clamp" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studClampHeight", 0.75]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Studs />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>0.5</value>
      <scad:value>0.5</scad:value>
    </studClampHeight>
    <studClampOffset type="mbt:Auto | type:Decimal(mbunit:MBU)">
      <documentation>
        Distance from the stud clamp ring to the base body.
        "auto" = studHeight - studClampHeight, so the clamp sits as high
        as possible, flush with the top of the stud.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="explicit" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studClampOffset="0.5" />]]>
        </example>
        <scad:example title="explicit" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studClampOffset", 0.5]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Studs />
        <mbgroup:RareAiUsage />
      </groups>
      <value>Auto</value>
      <scad:value>auto</scad:value>
    </studClampOffset>
    <studClampThickness type="type:Decimal(mbunit:MBU)">
      <documentation>
        Thickness of the stud clamp ring. At 0 no clamp is active.
      </documentation>
      <examples>
        <example title="with clamp" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studClampThickness="0.15" />]]>
        </example>
        <scad:example title="with clamp" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studClampThickness", 0.15]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Studs />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>0</value>
      <scad:value>0</scad:value>
    </studClampThickness>
    <studCutoutDiameterAdjustment type="type:Decimal(unit:Millimeter)">
      <documentation>
        Calibration adjustment for stud cutout diameter.
        Affects cutouts for studs in baseCutoutType=studs and outer wall
        cutouts in round bricks for grid compatibility. Calibration only.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="looser" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studCutoutDiameterAdjustment="0.3" />]]>
        </example>
        <scad:example title="looser" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studCutoutDiameterAdjustment", 0.3]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Studs />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <value>0.2</value>
      <scad:value>0.2</scad:value>
    </studCutoutDiameterAdjustment>
    <studCutoutHeightAdjustment type="type:Decimal(unit:Millimeter)">
      <documentation>
        Calibration adjustment for stud cutout height.
        Affects cutouts for studs in baseCutoutType=studs and outer wall
        cutouts in round bricks for grid compatibility. Calibration only.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="taller cutout" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studCutoutHeightAdjustment="0.5" />]]>
        </example>
        <scad:example title="taller cutout" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studCutoutHeightAdjustment", 0.5]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Studs />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <value>0.4</value>
      <scad:value>0.4</scad:value>
    </studCutoutHeightAdjustment>
    <studDiameter type="type:Decimal(mbunit:MBU)">
      <documentation>
        Diameter of studs. Usually does not need adjustment.
      </documentation>
      <examples>
        <example title="wider stud" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studDiameter="3.2" />]]>
        </example>
        <scad:example title="wider stud" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studDiameter", 3.2]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Studs />
        <mbgroup:RareAiUsage />
      </groups>
      <value>3</value>
      <scad:value>3</scad:value>
    </studDiameter>
    <studDiameterAdjustment type="type:Decimal(unit:Millimeter)">
      <documentation>
        Calibration adjustment for studDiameter.
      </documentation>
      <examples>
        <example title="tighter" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studDiameterAdjustment="0.1" />]]>
        </example>
        <scad:example title="tighter" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studDiameterAdjustment", 0.1]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Studs />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <value>0.2</value>
      <scad:value>0.2</scad:value>
    </studDiameterAdjustment>
    <studHeight type="type:Decimal(mbunit:MBU)">
      <documentation>
        Height of studs. Usually does not need adjustment.
      </documentation>
      <examples>
        <example title="taller stud" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studHeight="1.2" />]]>
        </example>
        <scad:example title="taller stud" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studHeight", 1.2]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Studs />
        <mbgroup:RareAiUsage />
      </groups>
      <value>1</value>
      <scad:value>1</scad:value>
    </studHeight>
    <studHeightAdjustment type="type:Decimal(unit:Millimeter)">
      <documentation>
        Calibration adjustment for studHeight.
      </documentation>
      <examples>
        <example title="taller mm" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studHeightAdjustment="0.1" />]]>
        </example>
        <scad:example title="taller mm" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studHeightAdjustment", 0.1]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Studs />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <value>0</value>
      <scad:value>0</scad:value>
    </studHeightAdjustment>
    <studHoleClampThickness type="type:Decimal(unit:Millimeter)">
      <documentation>
        Thickness of the clamp inside the stud hole (studType=hollow).
        A constriction of the inner hole so pins/axles grip in the stud.
      </documentation>
      <examples>
        <example title="thicker" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studHoleClampThickness="0.15" />]]>
        </example>
        <scad:example title="thicker" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studHoleClampThickness", 0.15]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Studs />
        <mbgroup:RareAiUsage />
      </groups>
      <value>0.1</value>
      <scad:value>0.1</scad:value>
    </studHoleClampThickness>
    <studHoleDiameter type="mbt:Auto | type:Decimal(mbunit:MBU)">
      <documentation>
        Diameter of the hole in studs (studType=hollow).
        Automatically calculated.
      </documentation>
      <examples>
        <example title="explicit" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studHoleDiameter="2.5" />]]>
        </example>
        <scad:example title="explicit" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studHoleDiameter", 2.5]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Studs />
        <mbgroup:RareAiUsage />
      </groups>
      <value>Auto</value>
      <scad:value>auto</scad:value>
    </studHoleDiameter>
    <studHoleDiameterAdjustment type="type:Decimal(unit:Millimeter)">
      <documentation>
        Calibration adjustment for studHoleDiameter.
      </documentation>
      <examples>
        <example title="looser" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studHoleDiameterAdjustment="0.4" />]]>
        </example>
        <scad:example title="looser" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studHoleDiameterAdjustment", 0.4]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Studs />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <value>0.3</value>
      <scad:value>0.3</scad:value>
    </studHoleDiameterAdjustment>
    <studIcon type="type:Boolean | type:FilePath">
      <documentation>
        SVG file engraved into each stud.
        OpenSCAD resolves relative SVG paths against the .scad file that uses the path
        (the file that passes studIcon / import()), not against NativeBlock, the library
        root, or the FQN package folder. The same relative string therefore resolves
        differently from bricks/ vs examples/ vs a consumer project file — choose the
        path relative to the consuming .scad file. Absolute paths and paths relative to
        the OpenSCAD working directory follow normal OpenSCAD rules.
      </documentation>
      <examples>
        <example title="bolt icon" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studIcon="../../pattern/bolt-solid-full.svg" />]]>
        </example>
        <scad:example title="bolt icon" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studIcon", "../../pattern/bolt-solid-full.svg"]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:StudIcon />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>../../pattern/bolt-solid-full.svg</value>
      <scad:value>../../pattern/bolt-solid-full.svg</scad:value>
    </studIcon>
    <studIconColor type="mbt:Inherit | type:Color">
      <documentation>
        Color of the stud icon. "inherit" uses baseColor.
        Only visually relevant when studIconDepth > 0.
      </documentation>
      <examples>
        <example title="red" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studIconColor="#FF0000" />]]>
        </example>
        <scad:example title="red" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studIconColor", "#FF0000"]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:StudIcon />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>Inherit</value>
      <scad:value>"inherit"</scad:value>
    </studIconColor>
    <studIconDepth type="type:Decimal(mbunit:MBU)">
      <documentation>
        Depth of the icon engraving. Negative = engraved into the stud.
        Positive = raised above the stud.
      </documentation>
      <examples>
        <example title="deeper icon" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studIconDepth="-0.3" />]]>
        </example>
        <scad:example title="deeper icon" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studIconDepth", -0.3]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:StudIcon />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>-0.2</value>
      <scad:value>-0.2</scad:value>
    </studIconDepth>
    <studIconDimensions type="mbt:SizeXY(type:Decimal(unit:Millimeter))">
      <documentation>
        Size of the stud icon SVG in mm (from the SVG file).
        Default values match all standard icons in the /patterns directory.
      </documentation>
      <examples>
        <example title="custom svg size" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studIconDimensions="{x: 200, y: 200}" />]]>
        </example>
        <scad:example title="custom svg size" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studIconDimensions", [200, 200]]
          ...
          ]]>
        </scad:example>
        <example title="xy size" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studIconDimensions="{x: 100, y: 50}" />]]>
        </example>
        <scad:example title="xy size" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studIconDimensions", [100, 50]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:StudIcon />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>{x:169.333,y:169.333}</value>
      <scad:value>[169.333,169.333]</scad:value>
    </studIconDimensions>
    <studIconScale type="type:Decimal">
      <documentation>
        Effective scale factor for the stud icon.
      </documentation>
      <examples>
        <example title="larger" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studIconScale="1" />]]>
        </example>
        <scad:example title="larger" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studIconScale", 1]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:StudIcon />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>0.8</value>
      <scad:value>0.8</scad:value>
    </studIconScale>
    <studMaxOverhang type="type:Decimal(mbunit:MBU)">
      <documentation>
        Maximum allowed stud overhang beyond the outer edge.
        Studs exceeding this are not drawn.
      </documentation>
      <examples>
        <example title="more overhang" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studMaxOverhang="1.5" />]]>
        </example>
        <scad:example title="more overhang" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studMaxOverhang", 1.5]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Studs />
        <mbgroup:RareAiUsage />
      </groups>
      <value>0.3</value>
      <scad:value>0.3</scad:value>
    </studMaxOverhang>
    <studPadding type="mbt:FaceMapXY(type:Decimal(mbunit:GridUnitXY))">
      <documentation>
        Padding from sides 0-3 inward. Shifts the outer wall for the decision
        whether studs are drawn, allowing outer studs to be hidden.
      </documentation>
      <examples>
        <example title="inset studs" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studPadding="{xNeg: 0.5, xPos: 0.5, yNeg: 0.5, yPos: 0.5}" />]]>
        </example>
        <scad:example title="inset studs" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studPadding", [0.5, 0.5, 0.5, 0.5]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Studs />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>{XNeg:0,XPos:0,YNeg:0,YPos:0}</value>
      <scad:value>[0,0,0,0]</scad:value>
    </studPadding>
    <studRounding type="type:Decimal(mbunit:MBU)">
      <documentation>
        Rounding radius of the upper stud edge.
      </documentation>
      <examples>
        <example title="more round" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studRounding="0.125" />]]>
        </example>
        <scad:example title="more round" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studRounding", 0.125]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Studs />
        <mbgroup:RareAiUsage />
      </groups>
      <value>0.0625</value>
      <scad:value>0.0625</scad:value>
    </studRounding>
    <studShift type="type:Boolean">
      <documentation>
        Whether studs are shifted by 1/2 stud in X and Y.
        false: studs sit between pillars.
        true: studs sit directly above pillars.
      </documentation>
      <examples>
        <example title="shifted" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studShift="true" />]]>
        </example>
        <scad:example title="shifted" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studShift", true]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Studs />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>false</value>
      <scad:value>false</scad:value>
    </studShift>
    <studType type="mbt:StudType">
      <documentation>
        Type of studs. solid: massive. hollow: with a hole in the center.
      </documentation>
      <examples>
        <example title="hollow" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studType="Hollow" />]]>
        </example>
        <scad:example title="hollow" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studType", "hollow"]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Studs />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>Solid</value>
      <scad:value>solid</scad:value>
    </studType>
    <studs type="type:Boolean">
      <documentation>
        Whether studs are drawn. Use studAreas for per-region control including stud
        type override; later areas win on overlap.
      </documentation>
      <examples>
        <example title="enabled" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studs="true" />]]>
        </example>
        <scad:example title="enabled" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studs", true]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Studs />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>true</value>
      <scad:value>true</scad:value>
    </studs>
    <studAreas type="mbt:SelectiveGrid(type:Boolean | mbt:StudType)[]">
      <documentation>
        Per-region overrides for studs on the plate grid. Each entry is an inclusive
        rectangular range (start/end in GridUnitXY) with a Boolean or StudType value. Later entries
        win on overlap.
      </documentation>
      <examples>
        <example title="hollow region" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock studs="true" studAreas="[{start:{x:0,y:0}, end:{x:3,y:0}, value:Hollow}]" />]]>
        </example>
        <scad:example title="hollow region" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["studs", true],
          ["studAreas", [[[0,0],[3,0],"hollow"]]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Studs />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>[]</value>
      <scad:value>[]</scad:value>
    </studAreas>
    <surfacePattern type="type:Boolean | type:FilePath">
      <documentation>
        SVG file for a pattern on the brick surface. Applied to the brick
        body surface as a repeating or single pattern.
        OpenSCAD resolves relative SVG paths against the .scad file that uses the path
        (the file that passes surfacePattern / import()), not against NativeBlock, the
        library root, or the FQN package folder. Pick the path relative to the consuming
        .scad file — the same string is not portable across different file depths.
      </documentation>
      <examples>
        <example title="pattern file" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock surfacePattern="patterns/hex.svg" />]]>
        </example>
        <scad:example title="pattern file" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["surfacePattern", "patterns/hex.svg"]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:SurfacePattern />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>false</value>
      <scad:value>false</scad:value>
    </surfacePattern>
    <surfacePatternColor type="mbt:Inherit | type:Color">
      <documentation>
        Color of the surface pattern. "inherit" uses baseColor.
        Only visually relevant when surfacePatternDepth > 0.
      </documentation>
      <examples>
        <example title="blue" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock surfacePatternColor="#0066CC" />]]>
        </example>
        <scad:example title="blue" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["surfacePatternColor", "#0066CC"]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:SurfacePattern />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>Inherit</value>
      <scad:value>"inherit"</scad:value>
    </surfacePatternColor>
    <surfacePatternDepth type="type:Decimal(mbunit:MBU)">
      <documentation>
        Depth of the surface pattern. Negative = engraved. Positive = raised.
      </documentation>
      <examples>
        <example title="emboss" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock surfacePatternDepth="0.2" />]]>
        </example>
        <scad:example title="emboss" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["surfacePatternDepth", 0.2]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:SurfacePattern />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>-0.0625</value>
      <scad:value>-0.0625</scad:value>
    </surfacePatternDepth>
    <surfacePatternDimensions type="mbt:SizeXY(type:Decimal(unit:Millimeter))">
      <documentation>
        Size of the surface pattern SVG in mm (from the SVG file).
      </documentation>
      <examples>
        <example title="custom svg size" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock surfacePatternDimensions="{x: 500, y: 500}" />]]>
        </example>
        <scad:example title="custom svg size" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["surfacePatternDimensions", [500, 500]]
          ...
          ]]>
        </scad:example>
        <example title="xy size" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock surfacePatternDimensions="{x: 100, y: 50}" />]]>
        </example>
        <scad:example title="xy size" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["surfacePatternDimensions", [100, 50]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:SurfacePattern />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>{x:451.556,y:451.556}</value>
      <scad:value>[451.556,451.556]</scad:value>
    </surfacePatternDimensions>
    <surfacePatternOffset type="mbt:OffsetXY">
      <documentation>
        Offset of the surface pattern on the horizontal (Z-face) plane only
        (OffsetXY, default GridUnitXY). World XY — not AxisAB — because the pattern
        lies on the brick Z-face / GridUnitXY plane.
      </documentation>
      <examples>
        <example title="shifted" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock surfacePatternOffset="{x: 0.5, y: 0.25}" />]]>
        </example>
        <scad:example title="shifted" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["surfacePatternOffset", [0.5, 0.25]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:SurfacePattern />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>{x:0,y:0}</value>
      <scad:value>[0,0]</scad:value>
    </surfacePatternOffset>
    <surfacePatternPadding type="mbt:FaceMapXY(type:Decimal(mbunit:GridUnitXY))">
      <documentation>
        Distance from the edges of the surface pattern area, forming a smooth
        (pattern-free) border around the structure. At 0, the pattern extends
        to the edges. Each edge can be configured individually via the
        4-element array form.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="border" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock surfacePatternPadding="{xNeg: 0.5, xPos: 0.5, yNeg: 0.5, yPos: 0.5}" />]]>
        </example>
        <scad:example title="border" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["surfacePatternPadding", [0.5, 0.5, 0.5, 0.5]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:SurfacePattern />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>{XNeg:0,XPos:0,YNeg:0,YPos:0}</value>
      <scad:value>[0,0,0,0]</scad:value>
    </surfacePatternPadding>
    <surfacePatternScale type="type:Decimal">
      <documentation>
        Scale factor for the surface pattern.
      </documentation>
      <examples>
        <example title="larger" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock surfacePatternScale="1.5" />]]>
        </example>
        <scad:example title="larger" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["surfacePatternScale", 1.5]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:SurfacePattern />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>1</value>
      <scad:value>1</scad:value>
    </surfacePatternScale>
    <svg type="type:Boolean | type:FilePath">
      <documentation>
        SVG file to draw on a brick side. Placed on the side specified
        by svgFace.
      </documentation>
      <examples>
        <example title="icon" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock svg="icons/logo.svg" />]]>
        </example>
        <scad:example title="icon" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["svg", "icons/logo.svg"]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Svg />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>false</value>
      <scad:value>false</scad:value>
    </svg>
    <svgColor type="type:Color">
      <documentation>
        Color of the SVG.
      </documentation>
      <examples>
        <example title="dark" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock svgColor="#2c3e50" />]]>
        </example>
        <scad:example title="dark" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["svgColor", "#2c3e50"]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Svg />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>#2c3e50</value>
      <scad:value>"#2c3e50"</scad:value>
    </svgColor>
    <svgDepth type="type:Decimal(mbunit:MBU)">
      <documentation>
        Depth/height of the SVG. Negative = engraved. Positive = raised.
      </documentation>
      <examples>
        <example title="deeper svg" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock svgDepth="0.6" />]]>
        </example>
        <scad:example title="deeper svg" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["svgDepth", 0.6]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Svg />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>0.4</value>
      <scad:value>0.4</scad:value>
    </svgDepth>
    <svgDimensions type="mbt:SizeXY(type:Decimal(unit:Millimeter))">
      <documentation>
        Size of the SVG in mm (from the SVG file).
      </documentation>
      <examples>
        <example title="custom size" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock svgDimensions="{x: 120, y: 80}" />]]>
        </example>
        <scad:example title="custom size" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["svgDimensions", [120, 80]]
          ...
          ]]>
        </scad:example>
        <example title="xy size" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock svgDimensions="{x: 100, y: 50}" />]]>
        </example>
        <scad:example title="xy size" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["svgDimensions", [100, 50]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Svg />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>{x:100,y:100}</value>
      <scad:value>[100,100]</scad:value>
    </svgDimensions>
    <svgFace type="mbt:Face">
      <documentation>
        Side on which the SVG is drawn (0-5 or string "x-" etc.).
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="front" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock svgFace="YPos" />]]>
        </example>
        <scad:example title="front" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["svgFace", "y+"]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Svg />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>ZPos</value>
      <scad:value>z+</scad:value>
    </svgFace>
    <svgOffset type="mbt:OffsetXY">
      <documentation>
        Offset of the SVG from its default position (OffsetXY, default GridUnitXY).
      </documentation>
      <examples>
        <example title="shifted" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock svgOffset="{x: 0.5, y: 0}" />]]>
        </example>
        <scad:example title="shifted" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["svgOffset", [0.5, 0]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Svg />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>{x:0,y:0}</value>
      <scad:value>[0,0]</scad:value>
    </svgOffset>
    <svgScale type="type:Decimal">
      <documentation>
        Scale factor for the SVG.
      </documentation>
      <examples>
        <example title="larger" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock svgScale="1.5" />]]>
        </example>
        <scad:example title="larger" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["svgScale", 1.5]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Svg />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>1</value>
      <scad:value>1</scad:value>
    </svgScale>
    <text type="type:Boolean | type:Text">
      <documentation>
        Text to draw on the brick. If not empty, rendered on the side
        specified by textFace.
      </documentation>
      <examples>
        <example title="label" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock text="MB" />]]>
        </example>
        <scad:example title="label" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["text", "MB"]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Text />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>false</value>
      <scad:value>false</scad:value>
    </text>
    <textAlign type="mbt:Align">
      <documentation>
        Alignment of the text on the brick surface, using the same
        format as align and alignChildren.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="center" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock textAlign="Center" />]]>
        </example>
        <scad:example title="center" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["textAlign", "center"]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Text />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>Center</value>
      <scad:value>center</scad:value>
    </textAlign>
    <textColor type="type:Color">
      <documentation>
        Color of the text. Independent from baseColor.
      </documentation>
      <examples>
        <example title="dark" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock textColor="#2c3e50" />]]>
        </example>
        <scad:example title="dark" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["textColor", "#2c3e50"]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Text />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>#2c3e50</value>
      <scad:value>"#2c3e50"</scad:value>
    </textColor>
    <textDepth type="type:Decimal(mbunit:MBU)">
      <documentation>
        Depth/height of the text. Negative = engraved. Positive = raised.
      </documentation>
      <examples>
        <example title="raised text" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock textDepth="0.2" />]]>
        </example>
        <scad:example title="raised text" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["textDepth", 0.2]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Text />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>-0.25</value>
      <scad:value>-0.25</scad:value>
    </textDepth>
    <textFace type="mbt:Face">
      <documentation>
        Side of the brick on which text is displayed (0-5 or string "x-" etc.).
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="top face" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock textFace="ZPos" />]]>
        </example>
        <scad:example title="top face" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["textFace", "z+"]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Text />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>XNeg</value>
      <scad:value>x-</scad:value>
    </textFace>
    <textFont type="type:Text">
      <documentation>
        Font family for the text.
      </documentation>
      <examples>
        <example title="font" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock textFont="RBNo3.1 Black" />]]>
        </example>
        <scad:example title="font" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["textFont", "RBNo3.1 Black"]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Text />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>Liberation Sans</value>
      <scad:value>Liberation Sans</scad:value>
    </textFont>
    <textOffset type="mbt:OffsetXY">
      <documentation>
        Offset of the text from its normal position (OffsetXY, default GridUnitXY).
      </documentation>
      <examples>
        <example title="shifted" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock textOffset="{x: 0.5, y: 0}" />]]>
        </example>
        <scad:example title="shifted" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["textOffset", [0.5, 0]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Text />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>[0,0]</value>
      <scad:value>[0,0]</scad:value>
    </textOffset>
    <textSize type="type:Decimal(unit:Millimeter)">
      <documentation>
        Font size of the text.
      </documentation>
      <examples>
        <example title="larger" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock textSize="6" />]]>
        </example>
        <scad:example title="larger" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["textSize", 6]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Text />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>4</value>
      <scad:value>4</scad:value>
    </textSize>
    <textSpacing type="type:Decimal">
      <documentation>
        Letter spacing of the text.
      </documentation>
      <examples>
        <example title="looser" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock textSpacing="1.2" />]]>
        </example>
        <scad:example title="looser" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["textSpacing", 1.2]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Text />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>1</value>
      <scad:value>1</scad:value>
    </textSpacing>
    <tongue type="type:Boolean">
      <documentation>
        Whether a tongue (ridge) is drawn. Counterpart to baseCutoutType=groove.
        Tongue and groove are an alternative attachment system for joining two
        bricks, typically to create a solid block from two separate parts.
        The tongue wraps around the outermost ring of studs and is compatible
        with a plate of the same size, but typically used with a groove brick.
        Can be used with or without recess.
      </documentation>
      <examples>
        <example title="enabled" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock tongue="true" />]]>
        </example>
        <scad:example title="enabled" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["tongue", true]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TongueGroove />
        <mbgroup:FrequentAiUsage />
      </groups>
      <value>false</value>
      <scad:value>false</scad:value>
    </tongue>
    <tongueClampHeight type="type:Decimal(mbunit:MBU)">
      <documentation>
        Height of the tongue clamp lip. Affects both the lip on the tongue
        and the matching recess in the groove for snapping together.
      </documentation>
      <examples>
        <example title="taller" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock tongueClampHeight="0.75" />]]>
        </example>
        <scad:example title="taller" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["tongueClampHeight", 0.75]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TongueGroove />
        <mbgroup:RareAiUsage />
      </groups>
      <value>0.5</value>
      <scad:value>0.5</scad:value>
    </tongueClampHeight>
    <tongueClampOffset type="type:Decimal(mbunit:MBU)">
      <documentation>
        Distance from the lower edge of the tongue to the lower edge of
        the tongue clamp lip. Also affects the groove's clamp recess position.
      </documentation>
      <changelog>
        <change version="3.0.0">
          Measurement changed from upper-edge-to-upper-edge to
          lower-edge-to-lower-edge.
          This avoids needing to calculate groove depth when positioning the clamp.
        </change>
      </changelog>
      <examples>
        <example title="larger offset" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock tongueClampOffset="0.75" />]]>
        </example>
        <scad:example title="larger offset" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["tongueClampOffset", 0.75]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TongueGroove />
        <mbgroup:RareAiUsage />
      </groups>
      <value>0.5</value>
      <scad:value>0.5</scad:value>
    </tongueClampOffset>
    <tongueClampThickness type="type:Decimal(mbunit:MBU)">
      <documentation>
        Thickness of the tongue clamp lip / groove recess.
      </documentation>
      <examples>
        <example title="thicker" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock tongueClampThickness="0.15" />]]>
        </example>
        <scad:example title="thicker" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["tongueClampThickness", 0.15]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TongueGroove />
        <mbgroup:RareAiUsage />
      </groups>
      <value>0.1</value>
      <scad:value>0.1</scad:value>
    </tongueClampThickness>
    <!--TODO: implement in SCAD-->
    <tongueGrooveClampOffsetClearance type="type:Decimal(unit:Millimeter)">
      <documentation>
        Extra clearance in the groove before the clamp recess. In the groove,
        both tongueClampOffset and tongueClampHeight are increased by this value,
        so the clamp snaps more easily into the groove recess.
        "auto" uses printerLayerHeight.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="more clearance" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock tongueGrooveClampOffsetClearance="0.05" />]]>
        </example>
        <scad:example title="more clearance" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["tongueGrooveClampOffsetClearance", 0.05]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TongueGroove />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <value>0</value>
      <scad:value>0</scad:value>
    </tongueGrooveClampOffsetClearance>
    <tongueGrooveDepthClearance type="mbt:Auto | type:Decimal(unit:Millimeter)">
      <documentation>
        Additional depth clearance above the tongue inside the groove.
        The effective groove depth = tongueHeight + tongueGrooveDepthClearance.
        Replaces the old tongueGrooveDepth parameter.
        "auto" uses printerLayerHeight.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="explicit" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock tongueGrooveDepthClearance="0.1" />]]>
        </example>
        <scad:example title="explicit" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["tongueGrooveDepthClearance", 0.1]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TongueGroove />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <value>Auto</value>
      <scad:value>auto</scad:value>
    </tongueGrooveDepthClearance>
    <!--TODO: implement in SCAD-->
    <tongueGrooveThicknessClearance type="type:Decimal(unit:Millimeter)">
      <documentation>
        Clearance added to the groove width to allow the tongue to fit.
        Applied to both the groove wall thickness and tongueClampThickness
        inside the groove. Unlike tongueThicknessAdjustment (which only adjusts
        the tongue itself and not the clamp), this parameter adjusts the groove side
        including the clamp recess.
        "auto" uses 0.25 * printerNozzleDiameter (minimum 0.1 mm).
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="more clearance" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock tongueGrooveThicknessClearance="0.15" />]]>
        </example>
        <scad:example title="more clearance" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["tongueGrooveThicknessClearance", 0.15]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TongueGroove />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <value>0.1</value>
      <scad:value>0.1</scad:value>
    </tongueGrooveThicknessClearance>
    <tongueHeight type="type:Decimal(mbunit:MBU)">
      <documentation>
        Height of the tongue.
      </documentation>
      <examples>
        <example title="taller tongue" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock tongueHeight="1.5" />]]>
        </example>
        <scad:example title="taller tongue" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["tongueHeight", 1.5]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TongueGroove />
        <mbgroup:RareAiUsage />
      </groups>
      <value>1.25</value>
      <scad:value>1.25</scad:value>
    </tongueHeight>
    <tongueOffset type="type:Decimal(mbunit:MBU)">
      <documentation>
        Distance of the tongue from the side edge.
        Corresponds to the distance of studs from the side edge.
      </documentation>
      <examples>
        <example title="inset" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock tongueOffset="1.5" />]]>
        </example>
        <scad:example title="inset" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["tongueOffset", 1.5]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TongueGroove />
        <mbgroup:RareAiUsage />
      </groups>
      <value>1</value>
      <scad:value>1</scad:value>
    </tongueOffset>
    <tongueRoundingRadius type="mbt:Auto | type:Decimal(mbunit:GridUnitXY) | mbt:PlaneRoundingMap">
      <documentation>
        Rounding radius of the tongue corners on the horizontal (Z-face) plane
        only — not a full BaseRoundingMap like baseRoundingRadius. Expanded form is
        PlaneRoundingMap (CornerMap with GridUnitXY). Auto typically derives from the block's
        baseRoundingRadius. Usually does not need adjustment.
      </documentation>
      <examples>
        <example title="rounded" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock tongueRoundingRadius="0.5" />]]>
        </example>
        <scad:example title="rounded" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["tongueRoundingRadius", 0.5]
          ...
          ]]>
        </scad:example>
        <example title="per-corner" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock tongueRoundingRadius="{sw: 0.5, nw: 0.5, ne: 0.5, se: 0.5}" />]]>
        </example>
        <scad:example title="per-corner" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["tongueRoundingRadius", [0.5, 0.5, 0.5, 0.5]]
          ...
          ]]>
        </scad:example>
        <example title="anisotropic corner" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock tongueRoundingRadius="{sw: {a: 0.5, b: 0.25}, nw: 0.5, ne: 0.5, se: {a: 0.5, b: 0.25}}" />]]>
        </example>
        <scad:example title="anisotropic corner" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["tongueRoundingRadius", [[0.5, 0.25], 0.5, 0.5, [0.5, 0.25]]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TongueGroove />
        <mbgroup:RareAiUsage />
      </groups>
      <value>Auto</value>
      <scad:value>auto</scad:value>
    </tongueRoundingRadius>
    <tongueThickness type="type:Decimal(mbunit:MBU)">
      <documentation>
        Thickness of the tongue.
      </documentation>
      <examples>
        <example title="thicker" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock tongueThickness="1.2" />]]>
        </example>
        <scad:example title="thicker" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["tongueThickness", 1.2]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TongueGroove />
        <mbgroup:RareAiUsage />
      </groups>
      <value>0.666</value>
      <scad:value>0.666</scad:value>
    </tongueThickness>
    <tongueThicknessAdjustment type="type:Decimal(unit:Millimeter)">
      <documentation>
        Calibration adjustment for tongue thickness. Adjusts the thickness
        of the tongue only (not the groove). Used when using a tongue with
        a non-groove partner brick. Does not affect tongueClampThickness.
        For groove clearance, use tongueGrooveThicknessClearance instead.
      </documentation>
      <examples>
        <example title="thicker mm" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock tongueThicknessAdjustment="0.1" />]]>
        </example>
        <scad:example title="thicker mm" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["tongueThicknessAdjustment", 0.1]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TongueGroove />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <value>0</value>
      <scad:value>0</scad:value>
    </tongueThicknessAdjustment>
    <topPlateHeight type="type:Decimal(mbunit:MBU)">
      <documentation>
        Preferred height of the top plate (upper ceiling of the base body).
        Actual height may differ depending on baseCutoutMaxDepth and
        recess depth. Usually does not need adjustment.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="thicker plate" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock topPlateHeight="1.5" />]]>
        </example>
        <scad:example title="thicker plate" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["topPlateHeight", 1.5]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TopPlate />
        <mbgroup:RareAiUsage />
      </groups>
      <value>1</value>
      <scad:value>1</scad:value>
    </topPlateHeight>
    <topPlateHeightAdjustment type="type:Decimal(unit:Millimeter)">
      <documentation>
        Calibration adjustment for topPlateHeight.
        Only for calibration/printer compensation.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="taller mm" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock topPlateHeightAdjustment="-0.4" />]]>
        </example>
        <scad:example title="taller mm" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["topPlateHeightAdjustment", -0.4]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:TopPlate />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <value>-0.6</value>
      <scad:value>-0.6</scad:value>
    </topPlateHeightAdjustment>
    <topPlateHelperHeight type="mbt:Auto | type:Decimal(unit:Millimeter)">
      <documentation>
        Height of one top plate helper layer. Typically matches the 3D print
        layer height. The horizontal layer is effectively 2× this value as
        it is printed first.
        "auto" uses printerLayerHeight.
      </documentation>
      <examples>
        <example title="explicit" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock topPlateHelperHeight="0.2" />]]>
        </example>
        <scad:example title="explicit" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["topPlateHelperHeight", 0.2]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:PrintHelpers />
        <mbgroup:RareAiUsage />
      </groups>
      <value>Auto</value>
      <scad:value>auto</scad:value>
    </topPlateHelperHeight>
    <topPlateHelperThickness type="mbt:Auto | type:Decimal(unit:Millimeter)">
      <documentation>
        Thickness of the top plate helpers in X/Y direction.
        "auto" uses 0.5 * printerNozzleDiameter (minimum 0.1 mm).
      </documentation>
      <examples>
        <example title="explicit" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock topPlateHelperThickness="0.4" />]]>
        </example>
        <scad:example title="explicit" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["topPlateHelperThickness", 0.4]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:PrintHelpers />
        <mbgroup:RareAiUsage />
      </groups>
      <value>Auto</value>
      <scad:value>auto</scad:value>
    </topPlateHelperThickness>
    <topPlateHelpers type="type:Boolean">
      <documentation>
        Whether top plate helpers are active. A small frame that slightly
        widens the inner walls of the underside opening (baseCutoutType=standard).
        Improves adhesion when printing the ceiling (top plate).
        Two layers: horizontal (X-axis) then vertical (Y-axis).
        Usually active, does not need adjustment.
      </documentation>
      <examples>
        <example title="on" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock topPlateHelpers="true" />]]>
        </example>
        <scad:example title="on" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["topPlateHelpers", true]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:PrintHelpers />
        <mbgroup:RareAiUsage />
      </groups>
      <value>true</value>
      <scad:value>true</scad:value>
    </topPlateHelpers>
    <tubeDiameter type="mbt:Auto | type:Decimal(mbunit:MBU)">
      <documentation>
        Diameter of outer tubes for LEGO Technic holes.
        Automatically calculated per axis.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="explicit" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock tubeDiameter="4" />]]>
        </example>
        <scad:example title="explicit" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["tubeDiameter", 4]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Tubes />
        <mbgroup:NeverAiUsage />
      </groups>
      <value>Auto</value>
      <scad:value>auto</scad:value>
    </tubeDiameter>
    <tubeDiameterAdjustment type="type:Decimal(unit:Millimeter)">
      <documentation>
        Calibration adjustment for tubeDiameter.
      </documentation>
      <since>
        3.0.0
      </since>
      <examples>
        <example title="tighter" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock tubeDiameterAdjustment="-0.15" />]]>
        </example>
        <scad:example title="tighter" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["tubeDiameterAdjustment", -0.15]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:Tubes />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <value>-0.1</value>
      <scad:value>-0.1</scad:value>
    </tubeDiameterAdjustment>
    <!--TODO: use XYZ in scad-->
    <unitGridToMbu type="mbt:SizeXYZ(type:Integer)">
      <documentation>
        Grid size in mbu, representing a 1x1 plate.
        X and Y share the first value, Z uses the second.
        A 1x1 plate = 5×5×2 mbu = 8×8×3.2 mm at default settings.
      </documentation>
      <examples>
        <example title="custom grid" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock unitGridToMbu="{x: 8, y: 8, z: 3.2}" />]]>
        </example>
        <scad:example title="custom grid" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["unitGridToMbu", [8, 8, 3.2]]
          ...
          ]]>
        </scad:example>
        <example title="xyz size" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock unitGridToMbu="{x: 2, y: 4, z: 3}" />]]>
        </example>
        <scad:example title="xyz size" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["unitGridToMbu", [2, 4, 3]]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:System />
        <mbgroup:RareAiUsage />
      </groups>
      <value>{x:5,y:5,z:2}</value>
      <scad:value>[5,5,2]</scad:value>
    </unitGridToMbu>
    <unitMbuToMm type="type:Decimal(unit:Millimeter)">
      <documentation>
        Base unit of the MachineBlocks system in millimeters.
        All grid-based size values are multiples of this unit.
        Adjustment parameters are exempt (always in mm).
      </documentation>
      <examples>
        <example title="custom scale" language="org.blockml.bml.language.BML" snippet="true">
          <![CDATA[<NativeBlock unitMbuToMm="1.5" />]]>
        </example>
        <scad:example title="custom scale" language="org.blockml.bml.language.OpenSCAD" snippet="true">
          <![CDATA[
          ...
          ["unitMbuToMm", 1.5]
          ...
          ]]>
        </scad:example>
      </examples>
      <groups>
        <mbgroup:System />
        <mbgroup:RareAiUsage />
      </groups>
      <value>1.6</value>
      <scad:value>1.6</scad:value>
    </unitMbuToMm>
  </properties>
  <aggregations>
    <children type="mbcore:Block[]" default="true">
      <documentation>
        Defines the child blocks of the current block.
      </documentation>
    </children>
    <cutouts type="mbcore:NativeBlock[]">
      <documentation>
        Void volumes subtracted from the block body. Unlike ports / connectors /
        screwHoles (ValueType structs), each cutout is a full NativeBlock instance — a complete
        block description limited to the parameters that determine shape (size, offset, bevel,
        slope, rounding, etc.). Aggregation (not a property) because cutouts are composition
        children of geometry, not scalar/struct values. A future split of NativeBlock will
        extract a dedicated shape-only Block type for this role. The subtraction is applied
        brutally — it ignores walls, recess, tongue, and all structural features.
      </documentation>
      <since>
        3.0.0
      </since>
      <groups>
        <mbgroup:CoreGeometry />
        <mbgroup:NeverAiUsage />
      </groups>
    </cutouts>
  </aggregations>
</mbcore:NativeBlock>

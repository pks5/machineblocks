    <pillarGapAutoConfig type="mbt:PillarGapAutoConfig">
      <groups>
        <mbgroup:Pillars />
        <mbgroup:NeverAiUsage />
      </groups>
      <documentation>Configures how pillars are placed when pillars = "auto". Used to
        avoid a full pillar grid on large plates, which would otherwise sit
        too tightly on other bricks — only the corners and a middle cross
        remain filled.

        cornerLength: length of the two legs of the pillar triangle at each
        corner (in grid units). The corner is filled with a triangular
        arrangement of pillars whose leg length is this value; the remaining
        corner pillars follow from the triangle shape.

        middleWidth: width of a pillar cross in the middle of the plate, in
        both X and Y direction. Each arm extends middleWidth / 2 from the
        center in both directions, forming a cross of pillars in the middle.

        Combines the V2 parameters pillarGapCornerLength and pillarGapMiddle
        into a single struct.
      </documentation>
      <since>3.0.0</since>
      <value>{ cornerLength: 2, middleWidth: 10 }</value>
      <scad:value>[2, 10]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="wider gaps">
          <![CDATA[
<NativeBlock pillarGapAutoConfig="{cornerLength: 2, middleWidth: 4}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="wider gaps">
          <![CDATA[
          ...
          ["pillarGapAutoConfig", [2, 4]]
          ...
          ]]>
        </scad:example>
      </examples>
    </pillarGapAutoConfig>

    <pillarInnerClampThickness type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:Tubes />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Thickness of the clamp inside Z-direction tubes.
        A constriction of the inner hole so studs grip inside the tube.
        Usually does not need adjustment.
      </documentation>
      <since>3.0.0</since>
      <value>0.1</value>
      <scad:value>0.1</scad:value>
      <examples>
        <example language="BML" snippet="true" title="thicker">
          <![CDATA[
<NativeBlock pillarInnerClampThickness="0.2" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="thicker">
          <![CDATA[
          ...
          ["pillarInnerClampThickness", 0.2]
          ...
          ]]>
        </scad:example>
      </examples>
    </pillarInnerClampThickness>

    <pillarOriginalWallThickness type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:Tubes />
        <mbgroup:NeverAiUsage />
      </groups>
      <documentation>LEGO system constant used for automatic tube diameter calculation.
        Encodes the classic LEGO underside wall / tube proportion relative to the
        grid. Do not modify for printer calibration or ordinary brick design —
        change only when intentionally resizing the grid system itself (non-LEGO
        scale).
      </documentation>
      <since>3.0.0</since>
      <value>0.53125</value>
      <scad:value>0.53125</scad:value>
      <examples>
        <example language="BML" snippet="true" title="non-LEGO grid scale">
          <![CDATA[
<NativeBlock pillarOriginalWallThickness="0.6" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="non-LEGO grid scale">
          <![CDATA[
          ...
          ["pillarOriginalWallThickness", 0.6]
          ...
          ]]>
        </scad:example>
      </examples>
    </pillarOriginalWallThickness>

    <pillars type="Boolean">
      <groups>
        <mbgroup:Pillars />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Whether tubes/pins are drawn on the underside (baseCutoutType=standard).
        Use pillarAreas for per-region overrides; later areas win on overlap.
      </documentation>
      <value>true</value>
      <scad:value>true</scad:value>
      <examples>
        <example language="BML" snippet="true" title="enabled">
          <![CDATA[
<NativeBlock pillars="true" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="enabled">
          <![CDATA[
          ...
          ["pillars", true]
          ...
          ]]>
        </scad:example>
      </examples>
    </pillars>

    <pillarAreas type="mbt:SelectiveGrid(Boolean)[]">
      <groups>
        <mbgroup:Pillars />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Per-region overrides for pillars on the plate grid. Each entry is an inclusive
        rectangular range (start/end in GridUnitXY) with a Boolean value. Later entries win on
        overlap.
      </documentation>
      <value>[]</value>
      <scad:value>[]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="one area">
          <![CDATA[
<NativeBlock pillars="true" pillarAreas="[{start:{x:0,y:0}, end:{x:1,y:1}, value:false}]" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="one area">
          <![CDATA[
          ...
          ["pillars", true],
          ["pillarAreas", [[[0,0],[1,1],false]]]
          ...
          ]]>
        </scad:example>
      </examples>
    </pillarAreas>

    <pinDiameter type="mbt:Auto | Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:Pins />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Diameter of pins (small tubes) for bricks with size.x or size.y = 1.
        Automatically calculated.
      </documentation>
      <value>Auto</value>
      <scad:value>auto</scad:value>
      <examples>
        <example language="BML" snippet="true" title="explicit">
          <![CDATA[
<NativeBlock pinDiameter="1.2" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="explicit">
          <![CDATA[
          ...
          ["pinDiameter", 1.2]
          ...
          ]]>
        </scad:example>
      </examples>
    </pinDiameter>

    <pinDiameterAdjustment type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:Pins />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <documentation>Calibration adjustment for pin diameter.</documentation>
      <value>0.0</value>
      <scad:value>0.0</scad:value>
      <examples>
        <example language="BML" snippet="true" title="tighter">
          <![CDATA[
<NativeBlock pinDiameterAdjustment="-0.05" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="tighter">
          <![CDATA[
          ...
          ["pinDiameterAdjustment", -0.05]
          ...
          ]]>
        </scad:example>
      </examples>
    </pinDiameterAdjustment>

    <ports type="Boolean.False | mbt:Port[]">
      <groups>
        <mbgroup:CoreGeometry />
        <mbgroup:NeverAiUsage />
      </groups>
      <documentation>Cutouts on a face for connectors such as USB, screw terminals, etc.
        Each port is placed on a face using anchor + offset, then filled with
        one or more shapes (rect/circle) that are subtracted from the body.
      </documentation>
      <since>3.0.0</since>
      <value>false</value>
      <scad:value>false</scad:value>
      <examples>
        <example language="BML" snippet="true" title="one port">
          <![CDATA[
<NativeBlock>
  <ports>
[
  {
    face: YNeg, align: Center, offset: {a: 0, b: 0}, rotation: 0,
    shapes: [{
      type: Rect, offset: {a: 0, b: 0}, rotation: 0,
      setting: {size: {a: 8, b: 4}}
    }],
    depth: Auto
  }
]
  </ports>
</NativeBlock>
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="one port">
          <![CDATA[
          ...
          ["ports", [["y-", "center", [0, 0], 0, [["rect", [0, 0], 0, [[8, 4]]]], "auto"]]]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="Raspberry Pi side ports (HDMI / power / headphone)">
          <![CDATA[
<NativeBlock>
  <ports>
[
  {
    face: XNeg, align: Start, offset: {a: 4.35, b: 3.25}, rotation: 0,
    shapes: [{
      type: Circle, offset: {a: 0, b: 0}, rotation: 0,
      setting: {diameter: 7.1}
    }],
    depth: Auto
  },
  {
    face: XNeg, align: Start, offset: {a: 9.725, b: 2.6875}, rotation: 0,
    shapes: [{
      type: Rect, offset: {a: 0, b: 0}, rotation: 0,
      setting: {size: {a: 8.5, b: 3.9}, radius: 1.95}
    }],
    depth: Auto
  },
  {
    face: XNeg, align: Start, offset: {a: 7.0375, b: 3.5625}, rotation: 0,
    shapes: [
      {
        type: Rect, offset: {a: 0, b: 0.575}, rotation: 0,
        setting: {size: {a: 16.2, b: 5.2}, radius: 1.3}
      },
      {
        type: Rect, offset: {a: 0, b: -1.425}, rotation: 0,
        setting: {size: {a: 13.48, b: 3.5}, radius: 1.2}
      }
    ],
    depth: Auto
  },
  {
    face: YNeg, align: Start, offset: {a: 1.6125, b: 4.5}, rotation: 0,
    shapes: [{
      type: Rect, offset: {a: 0, b: 0}, rotation: 0,
      setting: {size: {a: 17, b: 14.4}, radius: 0.5}
    }],
    depth: Auto
  }
]
  </ports>
</NativeBlock>
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="Raspberry Pi side ports (HDMI / power / headphone)">
          <![CDATA[
          ...
          ["ports", [
            ["x-", "start", [4.35, 3.25], 0, [ ["circle", [0, 0], 0, [7.1]] ], "auto"],
            ["x-", "start", [9.725, 2.6875], 0, [ ["rect", [0, 0], 0, [[8.5, 3.9], 1.95]] ], "auto"],
            ["x-", "start", [7.0375, 3.5625], 0, [
              ["rect", [0, 0.575], 0, [[16.2, 5.2], 1.3]],
              ["rect", [0, -1.425], 0, [[13.48, 3.5], 1.2]]
            ], "auto"],
            ["y-", "start", [1.6125, 4.5], 0, [ ["rect", [0, 0], 0, [[17, 14.4], 0.5]] ], "auto"]
          ]]
          ...
          ]]>
        </scad:example>
      </examples>
    </ports>

    <printerLayerHeight type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:System />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <documentation>Layer height of the 3D printer in mm. Typically set once in the
        global config. Used as the default value for other parameters when
        those parameters are set to "auto".

        Current auto-resolution rules:
        topPlateHelperHeight = "auto" → printerLayerHeight
        stabilizerLayerOffset = "auto" → printerLayerHeight
        screwHoleZHelperLayerOffset = "auto" → printerLayerHeight
        tongueGrooveDepthClearance = "auto" → printerLayerHeight
        tongueGrooveClampOffsetClearance = "auto" → printerLayerHeight
      </documentation>
      <since>3.0.0</since>
      <value>0.2</value>
      <scad:value>0.2</scad:value>
      <examples>
        <example language="BML" snippet="true" title="finer">
          <![CDATA[
<NativeBlock printerLayerHeight="0.1" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="finer">
          <![CDATA[
          ...
          ["printerLayerHeight", 0.1]
          ...
          ]]>
        </scad:example>
      </examples>
    </printerLayerHeight>

    <printerNozzleDiameter type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:System />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <documentation>Nozzle diameter of the 3D printer in mm. Typically set once in the
        global config. Used as the default value for other parameters when
        those parameters are set to "auto".

        Current auto-resolution rules:
        topPlateHelperThickness = "auto" → 0.5 * printerNozzleDiameter (min 0.1 mm)
        tongueGrooveThicknessClearance = "auto" → 0.25 * printerNozzleDiameter (min 0.1 mm)
        Any future *NozzleDiameter-based "auto" parameter follows the same min 0.1 mm rule.
      </documentation>
      <since>3.0.0</since>
      <value>0.4</value>
      <scad:value>0.4</scad:value>
      <examples>
        <example language="BML" snippet="true" title="0.1 nozzle">
          <![CDATA[
<NativeBlock printerNozzleDiameter="0.1" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="0.1 nozzle">
          <![CDATA[
          ...
          ["printerNozzleDiameter", 0.1]
          ...
          ]]>
        </scad:example>
      </examples>
    </printerNozzleDiameter>

    <quality type="mbt:QualityPreset">
      <groups>
        <mbgroup:Quality />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>User-level quality preset. Controls overall rendering quality
        independent of renderer implementation.
        "preview" — fast, reduced quality for interactive preview
        "normal" — balanced quality for general use
        "print" — high quality for 3D print export
        "render" — maximum quality for final renders
      </documentation>
      <value>Normal</value>
      <scad:value>normal</scad:value>
      <examples>
        <example language="BML" snippet="true" title="high">
          <![CDATA[
<NativeBlock quality="High" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="high">
          <![CDATA[
          ...
          ["quality", "high"]
          ...
          ]]>
        </scad:example>
      </examples>
    </quality>

    <recess type="Boolean">
      <groups>
        <mbgroup:Recess />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Whether a top-down cavity is created, forming a box with four walls
        and no lid. When active with baseCutoutType=standard, the baseCutout
        depth is reduced to minimum (1 mbu) if recessDepth=auto.
      </documentation>
      <value>false</value>
      <scad:value>false</scad:value>
      <examples>
        <example language="BML" snippet="true" title="enabled">
          <![CDATA[
<NativeBlock recess="true" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="enabled">
          <![CDATA[
          ...
          ["recess", true]
          ...
          ]]>
        </scad:example>
      </examples>
    </recess>

    <recessAdjustment type="mbt:Auto | mbt:FaceMapXYZ(Decimal(unit:Millimeter))">
      <groups>
        <mbgroup:Calibration />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <documentation>Per-side calibration adjustment for the inner recess walls and floor.
        Applied to the interior surfaces of the recess (the inner box).

        At "auto", uses the same values as baseAdjustment (except z+, which
        is not applicable to the recess).

        IMPORTANT — z- behaviour differs from baseAdjustment:
        The z- value is applied to the recess floor height (moves the floor).
        No downward shift or z+ extension occurs — it is a direct floor adjustment.

        Sign convention: negative values enlarge the recess (shrink the inner
        walls inward in x/y, and lower the floor in z-). Positive values
        shrink the recess.
      </documentation>
      <since>3.0.0</since>
      <value>Auto</value>
      <scad:value>auto</scad:value>
      <examples>
        <example language="BML" snippet="true" title="floor down">
          <![CDATA[
<NativeBlock recessAdjustment="{xNeg: 0, xPos: 0, yNeg: 0, yPos: 0, zNeg: -0.1, zPos: 0}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="floor down">
          <![CDATA[
          ...
          ["recessAdjustment", [0, 0, 0, 0, -0.1, 0]]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="faces">
          <![CDATA[
<NativeBlock recessAdjustment="{xNeg: 0, xPos: 0, yNeg: 0, yPos: 0, zNeg: 0, zPos: 0.1}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="faces">
          <![CDATA[
          ...
          ["recessAdjustment", [0, 0, 0, 0, 0, 0.1]]
          ...
          ]]>
        </scad:example>
      </examples>
    </recessAdjustment>

    <recessDepth type="mbt:Auto | Decimal(mbunit:GridUnitZ)">
      <groups>
        <mbgroup:Recess />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Depth of the recess cavity, expressed as multiples of one plate (unitGrid[1] =
        2 mbu).
        At "auto" depth is maximized.
        When set to an absolute value, the baseCutout (standard) goes up to
        baseCutoutMaxDepth and the remainder is filled with the top plate
        wall between baseCutout and recess.
      </documentation>
      <changelog>
        <change version="3.0.0">Unit clarified: unitGrid[1] (plates), not raw mbu.</change>
      </changelog>
      <value>Auto</value>
      <scad:value>auto</scad:value>
      <examples>
        <example language="BML" snippet="true" title="two plates">
          <![CDATA[
<NativeBlock recessDepth="2" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="two plates">
          <![CDATA[
          ...
          ["recessDepth", 2]
          ...
          ]]>
        </scad:example>
      </examples>
    </recessDepth>

    <recessRoundingRadius type="mbt:Auto | Decimal(mbunit:GridUnitXY) | mbt:PlaneRoundingMap">
      <groups>
        <mbgroup:Recess />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Rounding radius of the recess cavity corners on the horizontal (Z-face)
        plane only — not a full BaseRoundingMap like baseRoundingRadius. Expanded form is
        PlaneRoundingMap (CornerMap with GridUnitXY). Auto derives from the block's
        baseRoundingRadius. Usually does not need adjustment.
      </documentation>
      <value>Auto</value>
      <scad:value>auto</scad:value>
      <examples>
        <example language="BML" snippet="true" title="rounded">
          <![CDATA[
<NativeBlock recessRoundingRadius="0.5" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="rounded">
          <![CDATA[
          ...
          ["recessRoundingRadius", 0.5]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="per-corner">
          <![CDATA[
<NativeBlock recessRoundingRadius="{sw: 0.5, nw: 0.5, ne: 0.5, se: 0.5}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="per-corner">
          <![CDATA[
          ...
          ["recessRoundingRadius", [0.5, 0.5, 0.5, 0.5]]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="anisotropic corner">
          <![CDATA[
<NativeBlock recessRoundingRadius="{sw: {a: 0.5, b: 0.25}, nw: 0.5, ne: 0.5, se: {a: 0.5, b: 0.25}}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="anisotropic corner">
          <![CDATA[
          ...
          ["recessRoundingRadius", [[0.5, 0.25], 0.5, 0.5, [0.5, 0.25]]]
          ...
          ]]>
        </scad:example>
      </examples>
    </recessRoundingRadius>

    <recessStudPadding type="mbt:FaceMapXY(Decimal(mbunit:GridUnitXY))">
      <groups>
        <mbgroup:Recess />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Padding from the recess wall inward. Determines whether outer studs
        in the recess are hidden. Studs whose center is closer to the recess
        wall than this padding value are not drawn.
      </documentation>
      <value>0.2</value>
      <scad:value>0.2</scad:value>
      <examples>
        <example language="BML" snippet="true" title="more padding">
          <![CDATA[
<NativeBlock recessStudPadding="{xNeg: 0.4, xPos: 0.4, yNeg: 0.4, yPos: 0.4}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="more padding">
          <![CDATA[
          ...
          ["recessStudPadding", [0.4, 0.4, 0.4, 0.4]]
          ...
          ]]>
        </scad:example>
      </examples>
    </recessStudPadding>

    <recessStudShift type="Boolean">
      <groups>
        <mbgroup:Recess />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Whether recess floor studs are shifted by 1/2 stud in X and Y.
        false: studs sit at standard positions.
        true: studs are shifted by half a stud in both directions.
      </documentation>
      <value>false</value>
      <scad:value>false</scad:value>
      <examples>
        <example language="BML" snippet="true" title="shifted">
          <![CDATA[
<NativeBlock recessStudShift="true" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="shifted">
          <![CDATA[
          ...
          ["recessStudShift", true]
          ...
          ]]>
        </scad:example>
      </examples>
    </recessStudShift>

    <recessStudType type="mbt:StudType">
      <groups>
        <mbgroup:Recess />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Type of studs on the recess floor.
        solid: massive studs. hollow: studs with a hole in the center.
      </documentation>
      <value>Solid</value>
      <scad:value>solid</scad:value>
      <examples>
        <example language="BML" snippet="true" title="hollow">
          <![CDATA[
<NativeBlock recessStudType="Hollow" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="hollow">
          <![CDATA[
          ...
          ["recessStudType", "hollow"]
          ...
          ]]>
        </scad:example>
      </examples>
    </recessStudType>

    <recessStuds type="Boolean">
      <groups>
        <mbgroup:Recess />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Whether studs are drawn on the recess floor. Studs are at the same
        X/Y position as without recess. Only drawn if a 1x1 brick fits —
        studs too close to the recess wall are hidden.
      </documentation>
      <value>true</value>
      <scad:value>true</scad:value>
      <examples>
        <example language="BML" snippet="true" title="enabled">
          <![CDATA[
<NativeBlock recessStuds="true" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="enabled">
          <![CDATA[
          ...
          ["recessStuds", true]
          ...
          ]]>
        </scad:example>
      </examples>
    </recessStuds>

    <recessWallGapStuds type="Boolean">
      <groups>
        <mbgroup:Recess />
        <mbgroup:NeverAiUsage />
      </groups>
      <documentation>Whether studs are shown inside openings created by recessWallGaps.
        Only effective in combination with recessStuds = true.
      </documentation>
      <since>3.0.0</since>
      <value>false</value>
      <scad:value>false</scad:value>
      <examples>
        <example language="BML" snippet="true" title="enabled">
          <![CDATA[
<NativeBlock recessWallGapStuds="true" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="enabled">
          <![CDATA[
          ...
          ["recessWallGapStuds", true]
          ...
          ]]>
        </scad:example>
      </examples>
    </recessWallGapStuds>

    <recessWallGaps type="mbt:RecessWallGap[]">
      <groups>
        <mbgroup:Recess />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Openings in recess walls. Each entry specifies a side and optional
        left/right offsets to create partial or full wall openings.
        Also creates matching openings in tongue and groove.
      </documentation>
      <changelog>
        <change version="3.0.0">Short form input added; sides can now be specified as strings.</change>
      </changelog>
      <value>[]</value>
      <scad:value>[]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="one gap">
          <![CDATA[
<NativeBlock recessWallGaps="[{face: YPos, pos: 0, len: 1}]" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="one gap">
          <![CDATA[
          ...
          ["recessWallGaps", [["y+", 0, 1]]]
          ...
          ]]>
        </scad:example>
      </examples>
    </recessWallGaps>

    <recessWallStuds type="Boolean">
      <groups>
        <mbgroup:Recess />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Whether studs are drawn on the recess wall (the vertical wall of the
        recess cavity). Only active when studs = true and the recess wall is
        thick enough to fit studs.
      </documentation>
      <since>3.0.0</since>
      <value>true</value>
      <scad:value>true</scad:value>
      <examples>
        <example language="BML" snippet="true" title="enabled">
          <![CDATA[
<NativeBlock recessWallStuds="true" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="enabled">
          <![CDATA[
          ...
          ["recessWallStuds", true]
          ...
          ]]>
        </scad:example>
      </examples>
    </recessWallStuds>

    <recessWallThickness type="mbt:FaceMapXY(Decimal(mbunit:GridUnitXY))">
      <groups>
        <mbgroup:Recess />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Wall thickness of the recess cavity (box wall thickness).</documentation>
      <value>0.333</value>
      <scad:value>0.333</scad:value>
      <examples>
        <example language="BML" snippet="true" title="thicker sides">
          <![CDATA[
<NativeBlock recessWallThickness="{xNeg: 1, xPos: 1, yNeg: 1, yPos: 1}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="thicker sides">
          <![CDATA[
          ...
          ["recessWallThickness", [1, 1, 1, 1]]
          ...
          ]]>
        </scad:example>
      </examples>
    </recessWallThickness>

    <reliefCut type="Boolean">
      <groups>
        <mbgroup:ReliefCut />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Whether a relief cut is applied at the outer bottom edge of the block.
        Cuts a portion of the outer wall, resulting in a thinner outer wall
        in the lower area. The inner wall is not affected (baseCutoutType=standard).
      </documentation>
      <since>3.0.0</since>
      <value>false</value>
      <scad:value>false</scad:value>
      <examples>
        <example language="BML" snippet="true" title="enabled">
          <![CDATA[
<NativeBlock reliefCut="true" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="enabled">
          <![CDATA[
          ...
          ["reliefCut", true]
          ...
          ]]>
        </scad:example>
      </examples>
    </reliefCut>

    <reliefCutHeight type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:ReliefCut />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Height of the relief cut.</documentation>
      <since>3.0.0</since>
      <value>0.375</value>
      <scad:value>0.375</scad:value>
      <examples>
        <example language="BML" snippet="true" title="taller">
          <![CDATA[
<NativeBlock reliefCutHeight="0.75" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="taller">
          <![CDATA[
          ...
          ["reliefCutHeight", 0.75]
          ...
          ]]>
        </scad:example>
      </examples>
    </reliefCutHeight>

    <reliefCutThickness type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:ReliefCut />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Thickness of the cut-away portion.</documentation>
      <since>3.0.0</since>
      <value>0.375</value>
      <scad:value>0.375</scad:value>
      <examples>
        <example language="BML" snippet="true" title="thicker">
          <![CDATA[
<NativeBlock reliefCutThickness="0.5" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="thicker">
          <![CDATA[
          ...
          ["reliefCutThickness", 0.5]
          ...
          ]]>
        </scad:example>
      </examples>
    </reliefCutThickness>

    <render type="Boolean">
      <groups>
        <mbgroup:System />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Whether the block is rendered at all. When false, the block and all
        its children produce no geometry. Used in composite blocks to
        conditionally show or hide individual parts based on assemblyParts.
      </documentation>
      <since>3.0.0</since>
      <value>true</value>
      <scad:value>true</scad:value>
      <examples>
        <example language="BML" snippet="true" title="off">
          <![CDATA[
<NativeBlock render="false" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="off">
          <![CDATA[
          ...
          ["render", false]
          ...
          ]]>
        </scad:example>
      </examples>
    </render>

    <rotation type="mbt:RotationXYZ">
      <groups>
        <mbgroup:Positioning />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Free geometric rotation applied after align. Not grid-safe —
        can break alignment and connectivity. The pivot is the relative
        zero point which varies depending on align. Children are rotated
        along with the parent.
      </documentation>
      <value>[0, 0, 0]</value>
      <scad:value>[0, 0, 0]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="tilt">
          <![CDATA[
<NativeBlock rotation="{x: 0, y: 0, z: 45}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="tilt">
          <![CDATA[
          ...
          ["rotation", [0, 0, 45]]
          ...
          ]]>
        </scad:example>
      </examples>
    </rotation>

    <rotationOffset type="mbt:OffsetXYZ">
      <groups>
        <mbgroup:Positioning />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Shifts the rotation pivot before rotation is applied.</documentation>
      <value>[0, 0, 0]</value>
      <scad:value>[0, 0, 0]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="pivot shift">
          <![CDATA[
<NativeBlock rotationOffset="{x: 1, y: 0, z: 0}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="pivot shift">
          <![CDATA[
          ...
          ["rotationOffset", [1, 0, 0]]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="xy pair">
          <![CDATA[
<NativeBlock rotationOffset="{x: 0.5, y: -0.25}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="xy pair">
          <![CDATA[
          ...
          ["rotationOffset", [0.5, -0.25]]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="xyz offset">
          <![CDATA[
<NativeBlock rotationOffset="{x: 1, y: 0, z: 0.5}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="xyz offset">
          <![CDATA[
          ...
          ["rotationOffset", [1, 0, 0.5]]
          ...
          ]]>
        </scad:example>
      </examples>
    </rotationOffset>

    <rotationOffsetRevert type="Boolean">
      <groups>
        <mbgroup:Positioning />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Whether the rotationOffset is reversed after rotation.</documentation>
      <value>true</value>
      <scad:value>true</scad:value>
      <examples>
        <example language="BML" snippet="true" title="revert">
          <![CDATA[
<NativeBlock rotationOffsetRevert="true" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="revert">
          <![CDATA[
          ...
          ["rotationOffsetRevert", true]
          ...
          ]]>
        </scad:example>
      </examples>
    </rotationOffsetRevert>

    <scadPreviewMaxMult type="Decimal">
      <groups>
        <mbgroup:Quality />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Maximum preview segment length multiplier.
        Used together with scadPreviewQuality.
        Higher values allow more aggressive quality reduction during preview.
      </documentation>
      <value>2.5</value>
      <scad:value>2.5</scad:value>
      <examples>
        <example language="BML" snippet="true" title="higher">
          <![CDATA[
<NativeBlock scadPreviewMaxMult="2" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="higher">
          <![CDATA[
          ...
          ["scadPreviewMaxMult", 2]
          ...
          ]]>
        </scad:example>
      </examples>
    </scadPreviewMaxMult>

    <scadPreviewPreRender type="Boolean">
      <groups>
        <mbgroup:Quality />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Whether the block is rendered as mesh in OpenSCAD preview mode
        instead of CSG.
      </documentation>
      <value>true</value>
      <scad:value>true</scad:value>
      <examples>
        <example language="BML" snippet="true" title="on">
          <![CDATA[
<NativeBlock scadPreviewPreRender="true" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="on">
          <![CDATA[
          ...
          ["scadPreviewPreRender", true]
          ...
          ]]>
        </scad:example>
      </examples>
    </scadPreviewPreRender>

    <scadPreviewPreRenderConvexity type="Integer">
      <groups>
        <mbgroup:Quality />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Convexity parameter passed to OpenSCAD render() function.
        Used with scadPreviewPreRender.
      </documentation>
      <value>25</value>
      <scad:value>25</scad:value>
      <examples>
        <example language="BML" snippet="true" title="higher">
          <![CDATA[
<NativeBlock scadPreviewPreRenderConvexity="4" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="higher">
          <![CDATA[
          ...
          ["scadPreviewPreRenderConvexity", 4]
          ...
          ]]>
        </scad:example>
      </examples>
    </scadPreviewPreRenderConvexity>

    <scadPreviewQuality type="Decimal">
      <groups>
        <mbgroup:Quality />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Additional OpenSCAD preview quality reduction factor.
        1.0 = disabled. 0.0 = strongest preview reduction.
        Only applied when $preview is true.
      </documentation>
      <value>1.0</value>
      <scad:value>1.0</scad:value>
      <examples>
        <example language="BML" snippet="true" title="finer">
          <![CDATA[
<NativeBlock scadPreviewQuality="0.5" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="finer">
          <![CDATA[
          ...
          ["scadPreviewQuality", 0.5]
          ...
          ]]>
        </scad:example>
      </examples>
    </scadPreviewQuality>

    <scadQualityClassFactors type="mbt:ScadQualityClassFactors">
      <groups>
        <mbgroup:Quality />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Per quality-class segment length multipliers.
        Higher values reduce quality and improve render performance.
      </documentation>
      <value>
        {
        functional: 1.00,
        visual: 1.35,
        hidden: 2.25
        }
      </value>
      <scad:value>[1.00, 1.35, 2.25]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="higher visual">
          <![CDATA[
<NativeBlock>
  <scadQualityClassFactors>
{
  functional: 1.0,
  visual: 1.5,
  hidden: 2.0
}
  </scadQualityClassFactors>
</NativeBlock>
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="higher visual">
          <![CDATA[
          ...
          ["scadQualityClassFactors", [1.0, 1.5, 2.0]]
          ...
          ]]>
        </scad:example>
      </examples>
    </scadQualityClassFactors>

    <scadQualityClassMinSegments type="mbt:ScadQualityClassMinSegments">
      <groups>
        <mbgroup:Quality />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Minimum full-circle segment count per quality class.
        Prevents small radii from becoming overly coarse.
      </documentation>
      <value>
        {
        functional: 16,
        visual: 12,
        hidden: 8
        }
      </value>
      <scad:value>[16, 12, 8]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="more segments">
          <![CDATA[
<NativeBlock>
  <scadQualityClassMinSegments>
{
  functional: 24,
  visual: 16,
  hidden: 8
}
  </scadQualityClassMinSegments>
</NativeBlock>
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="more segments">
          <![CDATA[
          ...
          ["scadQualityClassMinSegments", [24, 16, 8]]
          ...
          ]]>
        </scad:example>
      </examples>
    </scadQualityClassMinSegments>

    <scadQualityProfile type="mbt:ScadQualityProfile">
      <groups>
        <mbgroup:Quality />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>OpenSCAD quality profile mapping. Maps each quality preset to
        segment length (mm) and maximum segment count.
        Smaller segmentLengthMm increases quality.
        maxSegments limits the maximum full-circle resolution.
      </documentation>
      <value>
        {
        preview: { length: 0.55, segments: 32 },
        normal: { length: 0.38, segments: 48 },
        print: { length: 0.28, segments: 64 },
        render: { length: 0.16, segments: 120 }
        }
      </value>
      <scad:value>[[0.55, 32], [0.38, 48], [0.28, 64], [0.16, 120]]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="finer preview">
          <![CDATA[
<NativeBlock>
  <scadQualityProfile>
{
  preview: { length: 0.4, segments: 24 },
  normal: { length: 0.3, segments: 32 },
  print: { length: 0.2, segments: 48 },
  render: { length: 0.12, segments: 96 }
}
  </scadQualityProfile>
</NativeBlock>
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="finer preview">
          <![CDATA[
          ...
          ["scadQualityProfile", [[0.4, 24], [0.3, 32], [0.2, 48], [0.12, 96]]]
          ...
          ]]>
        </scad:example>
      </examples>
    </scadQualityProfile>

    <scadQualitySegmentMultiplier type="Decimal">
      <groups>
        <mbgroup:Quality />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Global segment length multiplier. Applied after quality preset
        and class factor calculation.
        &gt; 1.0: lower quality, faster rendering.
        &lt; 1.0: higher quality, slower rendering.
        Useful for global tuning without modifying quality profiles.
      </documentation>
      <value>1</value>
      <scad:value>1</scad:value>
      <examples>
        <example language="BML" snippet="true" title="higher">
          <![CDATA[
<NativeBlock scadQualitySegmentMultiplier="1.5" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="higher">
          <![CDATA[
          ...
          ["scadQualitySegmentMultiplier", 1.5]
          ...
          ]]>
        </scad:example>
      </examples>
    </scadQualitySegmentMultiplier>

    <scale type="Decimal">
      <groups>
        <mbgroup:System />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Global scaling factor. Scales all mbu-based values.
        mbu values themselves remain unchanged; only the resulting
        physical dimensions change. Adjustments (mm) do NOT scale.
      </documentation>
      <value>1.0</value>
      <scad:value>1.0</scad:value>
      <examples>
        <example language="BML" snippet="true" title="double">
          <![CDATA[
<NativeBlock scale="2" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="double">
          <![CDATA[
          ...
          ["scale", 2]
          ...
          ]]>
        </scad:example>
      </examples>
    </scale>

    <screwHoleDepth type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:ScrewHoles />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Default depth of screw holes. Can be overridden per hole in screwHoles.</documentation>
      <since>3.0.0</since>
      <value>4</value>
      <scad:value>4</scad:value>
      <examples>
        <example language="BML" snippet="true" title="deeper">
          <![CDATA[
<NativeBlock screwHoleDepth="8" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="deeper">
          <![CDATA[
          ...
          ["screwHoleDepth", 8]
          ...
          ]]>
        </scad:example>
      </examples>
    </screwHoleDepth>

    <screwHoleDiameter type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:ScrewHoles />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Default diameter of screw holes. Can be overridden per hole in screwHoles.</documentation>
      <since>3.0.0</since>
      <value>1.6</value>
      <scad:value>1.6</scad:value>
      <examples>
        <example language="BML" snippet="true" title="M3">
          <![CDATA[
<NativeBlock screwHoleDiameter="3.2" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="M3">
          <![CDATA[
          ...
          ["screwHoleDiameter", 3.2]
          ...
          ]]>
        </scad:example>
      </examples>
    </screwHoleDiameter>

    <screwHoleInsetDepth type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:ScrewHoles />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Default inset ring depth for screw holes. 0 = no inset.
        Can be overridden per hole in screwHoles.
      </documentation>
      <since>3.0.0</since>
      <value>0.8</value>
      <scad:value>0.8</scad:value>
      <examples>
        <example language="BML" snippet="true" title="inset">
          <![CDATA[
<NativeBlock screwHoleInsetDepth="1" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="inset">
          <![CDATA[
          ...
          ["screwHoleInsetDepth", 1]
          ...
          ]]>
        </scad:example>
      </examples>
    </screwHoleInsetDepth>

    <screwHoleInsetThickness type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:ScrewHoles />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Default inset ring thickness around screw holes. 0 = no inset.
        Can be overridden per hole in screwHoles.
      </documentation>
      <since>3.0.0</since>
      <value>0.6</value>
      <scad:value>0.6</scad:value>
      <examples>
        <example language="BML" snippet="true" title="inset ring">
          <![CDATA[
<NativeBlock screwHoleInsetThickness="0.5" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="inset ring">
          <![CDATA[
          ...
          ["screwHoleInsetThickness", 0.5]
          ...
          ]]>
        </scad:example>
      </examples>
    </screwHoleInsetThickness>

    <screwHoleZHelperHeight type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:ScrewHoles />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Height of the helper layers for Z-face screw holes.</documentation>
      <value>0.2</value>
      <scad:value>0.2</scad:value>
      <examples>
        <example language="BML" snippet="true" title="taller helper">
          <![CDATA[
<NativeBlock screwHoleZHelperHeight="0.4" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="taller helper">
          <![CDATA[
          ...
          ["screwHoleZHelperHeight", 0.4]
          ...
          ]]>
        </scad:example>
      </examples>
    </screwHoleZHelperHeight>

    <screwHoleZHelperLayerOffset type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:ScrewHoles />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Offset between the two helper layers for Z-face screw holes.
        "auto" uses printerLayerHeight.
      </documentation>
      <since>3.0.0</since>
      <value>0.2</value>
      <scad:value>0.2</scad:value>
      <examples>
        <example language="BML" snippet="true" title="larger offset">
          <![CDATA[
<NativeBlock screwHoleZHelperLayerOffset="0.3" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="larger offset">
          <![CDATA[
          ...
          ["screwHoleZHelperLayerOffset", 0.3]
          ...
          ]]>
        </scad:example>
      </examples>
    </screwHoleZHelperLayerOffset>

    <screwHoleZHelperThickness type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:ScrewHoles />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Thickness of print helpers for Z-face screw holes on the underside.
        Required for baseCutoutType=standard to avoid needing print support.
      </documentation>
      <value>0.8</value>
      <scad:value>0.8</scad:value>
      <examples>
        <example language="BML" snippet="true" title="thicker helper">
          <![CDATA[
<NativeBlock screwHoleZHelperThickness="1.0" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="thicker helper">
          <![CDATA[
          ...
          ["screwHoleZHelperThickness", 1.0]
          ...
          ]]>
        </scad:example>
      </examples>
    </screwHoleZHelperThickness>

    <screwHoles type="mbt:ScrewHole[]">
      <groups>
        <mbgroup:ScrewHoles />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Mounting screw holes on any face of the brick. Each entry defines one hole
        with a face, a grid position, and optional per-hole size overrides.
        Global defaults for diameter, depth, and inset are set via the
        screwHoleDiameter, screwHoleDepth, screwHoleInsetThickness, screwHoleInsetDepth
        parameters.
      </documentation>
      <since>3.0.0</since>
      <value>[]</value>
      <scad:value>[]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="one hole">
          <![CDATA[
<NativeBlock screwHoles="[{face: ZPos, offset: {a: 1, b: 2}}]" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="one hole">
          <![CDATA[
          ...
          ["screwHoles", [["z+", [1, 2]]]]
          ...
          ]]>
        </scad:example>
      </examples>
    </screwHoles>

    <size type="mbt:SizeXYZ">
      <groups>
        <mbgroup:CoreGeometry />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Size of the bounding box in grid units. Defines the brick body;
        studs are excluded from the bounding box. For simple bricks the
        bounding box matches the body exactly.
        X/Y count in studs, Z counts in plates.
        Must contain integer values only. Fractional values are not permitted.
      </documentation>
      <changelog>
        <change version="3.0.0">Values must be integers. Fractional values are no longer permitted.</change>
      </changelog>
      <value>[1, 1, 1]</value>
      <scad:value>[1, 1, 1]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="2x4 plate">
          <![CDATA[
<NativeBlock size="{x: 2, y: 4, z: 1}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="2x4 plate">
          <![CDATA[
          ...
          ["size", [2, 4, 1]]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="xyz size">
          <![CDATA[
<NativeBlock size="{x: 2, y: 4, z: 3}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="xyz size">
          <![CDATA[
          ...
          ["size", [2, 4, 3]]
          ...
          ]]>
        </scad:example>
      </examples>
    </size>

    <sizeAdjustment type="mbt:FaceMapXYZ(Decimal(unit:Millimeter))">
      <groups>
        <mbgroup:Calibration />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <documentation>Global calibration adjustment for block size, applied uniformly.
        sideXYAdj is applied to all four horizontal sides (x-, x+, y-, y+).
        heightAdj is applied to the top face (z+) only.

        Typically set once in the global config and applies to all blocks.
        For per-block or per-side overrides, use baseAdjustment.

        Example: [-0.1, 0] reduces x-, x+, y-, y+ by 0.1mm each, no height change.

        Never scales with the scale parameter.
      </documentation>
      <since>3.0.0</since>
      <changelog>
        <change version="3.0.0">Now also accepts a single number (applies to XY only, Z = 0), in
          addition
          to the previous 2-element array [XYAdj, ZAdj].
        </change>
      </changelog>
      <value>[-0.1, 0]</value>
      <scad:value>[-0.1, 0]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="xy shrink">
          <![CDATA[
<NativeBlock sizeAdjustment="[-0.2, 0]" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="xy shrink">
          <![CDATA[
          ...
          ["sizeAdjustment", [-0.2, 0]]
          ...
          ]]>
        </scad:example>
      </examples>
    </sizeAdjustment>

    <sizeMod type="mbt:FaceMapXYZ(Decimal(mbunit:GridUnitXY))">
      <groups>
        <mbgroup:CoreGeometry />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Semantic size modification per side, in grid units. Adjusts the
        brick geometry while keeping it structurally intact (walls, studs,
        connectors remain consistent). Unlike crop, sizeMod does not brutally
        cut geometry — it semantically shifts where the brick starts/ends on
        each side.

        Example: sizeMod = [0.5, 0, 0, 0, 0, 0] shifts the x- side inward
        by 0.5 grid units, producing a half-brick that starts at 0.5 grid
        units from the original x- edge.

        z- behaviour: negative z- values shift the brick downward by the
        same amount (like a downward offset), independent of the regular
        offset parameter. The z+ side is extended correspondingly.

        Difference to baseAdjustment: sizeMod is a semantic geometry change
        (half-bricks, partial bricks). baseAdjustment is for printer
        calibration and gap closing in composite blocks.
      </documentation>
      <since>3.0.0</since>
      <value>{xNeg: 0, xPos: 0, yNeg: 0, yPos: 0, zNeg: 0, zPos: 0}</value>
      <scad:value>[0, 0, 0, 0, 0, 0]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="half brick">
          <![CDATA[
<NativeBlock sizeMod="{xNeg: 0, xPos: 0, yNeg: 0, yPos: 0, zNeg: 0, zPos: -0.5}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="half brick">
          <![CDATA[
          ...
          ["sizeMod", [0, 0, 0, 0, 0, -0.5]]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="faces">
          <![CDATA[
<NativeBlock sizeMod="{xNeg: 0, xPos: 0, yNeg: 0, yPos: 0, zNeg: 0, zPos: 0.1}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="faces">
          <![CDATA[
          ...
          ["sizeMod", [0, 0, 0, 0, 0, 0.1]]
          ...
          ]]>
        </scad:example>
      </examples>
    </sizeMod>

    <slope type="Boolean.False | mbt:FaceMapXY(Decimal(mbunit:GridUnitXY))">
      <groups>
        <mbgroup:CoreGeometry />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Defines slopes per side (0-3).
        Positive values: slope on top surface (z+), starting at slopeBaseHeightBottom
        and going the specified number of plates toward the center upward.
        Negative values: inverted slope on bottom surface (z-), starting at
        blockHeight - slopeBaseHeightTop going down to the floor.
        Slope and bevel can be used together.
      </documentation>
      <examples>
        <example language="BML" snippet="true" title="no slope (boolean)">
          <![CDATA[
<NativeBlock slope="false" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="no slope (boolean)">
          <![CDATA[
          ...
          ["slope", false]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="no slope (zero map)">
          <![CDATA[
<NativeBlock slope="{xNeg: 0, xPos: 0, yNeg: 0, yPos: 0}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="no slope (zero map)">
          <![CDATA[
          ...
          ["slope", [0, 0, 0, 0]]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="positive slope">
          <![CDATA[
<NativeBlock slope="{xNeg: 1, xPos: 1, yNeg: 0, yPos: 0}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="positive slope">
          <![CDATA[
          ...
          ["slope", [1, 1, 0, 0]]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="inverted slope">
          <![CDATA[
<NativeBlock slope="{xNeg: 0, xPos: 2, yNeg: -2, yPos: 0}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="inverted slope">
          <![CDATA[
          ...
          ["slope", [0, 2, -2, 0]]
          ...
          ]]>
        </scad:example>
      </examples>
      <changelog>
        <change version="3.0.0">Can now be combined with bevel. The conflicts_with constraint has
          been removed.</change>
      </changelog>
      <value>false</value>
      <scad:value>false</scad:value>
    </slope>

    <slopeBaseHeightBottom type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:CoreGeometry />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Start height of the slope on the respective side for positive slopes.
        Usually does not need adjustment.
      </documentation>
      <since>3.0.0</since>
      <value>1.333</value>
      <scad:value>1.333</scad:value>
      <examples>
        <example language="BML" snippet="true" title="higher base">
          <![CDATA[
<NativeBlock slopeBaseHeightBottom="1.5" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="higher base">
          <![CDATA[
          ...
          ["slopeBaseHeightBottom", 1.5]
          ...
          ]]>
        </scad:example>
      </examples>
    </slopeBaseHeightBottom>

    <slopeBaseHeightInner type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:CoreGeometry />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Start height of the slope on the inner wall of the brick.
        Usually does not need adjustment.
      </documentation>
      <since>3.0.0</since>
      <value>1.125</value>
      <scad:value>1.125</scad:value>
      <examples>
        <example language="BML" snippet="true" title="higher inner">
          <![CDATA[
<NativeBlock slopeBaseHeightInner="1.25" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="higher inner">
          <![CDATA[
          ...
          ["slopeBaseHeightInner", 1.25]
          ...
          ]]>
        </scad:example>
      </examples>
    </slopeBaseHeightInner>

    <slopeBaseHeightTop type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:CoreGeometry />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Height subtracted from block height for inverted (negative) slopes.
        Usually does not need adjustment.
      </documentation>
      <since>3.0.0</since>
      <value>1</value>
      <scad:value>1</scad:value>
      <examples>
        <example language="BML" snippet="true" title="higher top">
          <![CDATA[
<NativeBlock slopeBaseHeightTop="1.25" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="higher top">
          <![CDATA[
          ...
          ["slopeBaseHeightTop", 1.25]
          ...
          ]]>
        </scad:example>
      </examples>
    </slopeBaseHeightTop>

    <stabilizerExpansion type="Integer">
      <groups>
        <mbgroup:PrintHelpers />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>If &gt; 0, every n-th grid element is taller and extends down to
        stabilizerExpansionOffset from the bottom edge.
      </documentation>
      <value>2</value>
      <scad:value>2</scad:value>
      <examples>
        <example language="BML" snippet="true" title="wider">
          <![CDATA[
<NativeBlock stabilizerExpansion="3" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="wider">
          <![CDATA[
          ...
          ["stabilizerExpansion", 3]
          ...
          ]]>
        </scad:example>
      </examples>
    </stabilizerExpansion>

    <stabilizerExpansionOffset type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:PrintHelpers />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Distance of expanded grid elements from the bottom edge.</documentation>
      <value>1</value>
      <scad:value>1</scad:value>
      <examples>
        <example language="BML" snippet="true" title="larger offset">
          <![CDATA[
<NativeBlock stabilizerExpansionOffset="1.5" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="larger offset">
          <![CDATA[
          ...
          ["stabilizerExpansionOffset", 1.5]
          ...
          ]]>
        </scad:example>
      </examples>
    </stabilizerExpansionOffset>

    <stabilizerHeight type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:PrintHelpers />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Height of the stabilizer grid.</documentation>
      <since>3.0.0</since>
      <value>0.5</value>
      <scad:value>0.5</scad:value>
      <examples>
        <example language="BML" snippet="true" title="taller">
          <![CDATA[
<NativeBlock stabilizerHeight="0.75" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="taller">
          <![CDATA[
          ...
          ["stabilizerHeight", 0.75]
          ...
          ]]>
        </scad:example>
      </examples>
    </stabilizerHeight>

    <stabilizerLayerOffset type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:PrintHelpers />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Offset between the first and subsequent grid layers.
        Ensures subsequent layers have a surface to print on.
        "auto" uses printerLayerHeight.
      </documentation>
      <since>3.0.0</since>
      <value>Auto</value>
      <scad:value>auto</scad:value>
      <examples>
        <example language="BML" snippet="true" title="explicit mm">
          <![CDATA[
<NativeBlock stabilizerLayerOffset="0.2" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="explicit mm">
          <![CDATA[
          ...
          ["stabilizerLayerOffset", 0.2]
          ...
          ]]>
        </scad:example>
      </examples>
    </stabilizerLayerOffset>

    <stabilizerThickness type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:PrintHelpers />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Width of a single grid strut.</documentation>
      <since>3.0.0</since>
      <value>0.5</value>
      <scad:value>0.5</scad:value>
      <examples>
        <example language="BML" snippet="true" title="thicker">
          <![CDATA[
<NativeBlock stabilizerThickness="0.75" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="thicker">
          <![CDATA[
          ...
          ["stabilizerThickness", 0.75]
          ...
          ]]>
        </scad:example>
      </examples>
    </stabilizerThickness>

    <stabilizers type="Boolean">
      <groups>
        <mbgroup:PrintHelpers />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Whether a stabilizer grid connecting tubes to side walls is printed
        (baseCutoutType=standard). Provides stability and improves
        printability of the top plate. Usually does not need adjustment.
      </documentation>
      <since>3.0.0</since>
      <value>true</value>
      <scad:value>true</scad:value>
      <examples>
        <example language="BML" snippet="true" title="disabled">
          <![CDATA[
<NativeBlock stabilizers="false" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="disabled">
          <![CDATA[
          ...
          ["stabilizers", false]
          ...
          ]]>
        </scad:example>
      </examples>
    </stabilizers>

    <studBaseOverlap type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:Studs />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>How deeply the stud is sunk into the block body (overlap with base).
        Ensures the stud is geometrically connected to the body (no floating geometry).
        Also prevents gaps when grille or surfacePattern is active.
        Can be set to 0 when a block has base=false but still renders studs
        (e.g. stud-only decorative layers in composite blocks).
      </documentation>
      <since>3.0.0</since>
      <value>0.25</value>
      <scad:value>0.25</scad:value>
      <examples>
        <example language="BML" snippet="true" title="more overlap">
          <![CDATA[
<NativeBlock studBaseOverlap="0.4" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="more overlap">
          <![CDATA[
          ...
          ["studBaseOverlap", 0.4]
          ...
          ]]>
        </scad:example>
      </examples>
    </studBaseOverlap>

    <studClampHeight type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:Studs />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Height of the stud clamp ring at the upper stud edge.
        Creates a near-permanent connection between two bricks.
        Only active when studClampThickness &gt; 0.
      </documentation>
      <value>0.5</value>
      <scad:value>0.5</scad:value>
      <examples>
        <example language="BML" snippet="true" title="taller clamp">
          <![CDATA[
<NativeBlock studClampHeight="0.75" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="taller clamp">
          <![CDATA[
          ...
          ["studClampHeight", 0.75]
          ...
          ]]>
        </scad:example>
      </examples>
    </studClampHeight>

    <studClampOffset type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:Studs />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Distance from the stud clamp ring to the base body.
        "auto" = studHeight - studClampHeight, so the clamp sits as high
        as possible, flush with the top of the stud.
      </documentation>
      <since>3.0.0</since>
      <value>Auto</value>
      <scad:value>auto</scad:value>
      <examples>
        <example language="BML" snippet="true" title="explicit">
          <![CDATA[
<NativeBlock studClampOffset="0.5" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="explicit">
          <![CDATA[
          ...
          ["studClampOffset", 0.5]
          ...
          ]]>
        </scad:example>
      </examples>
    </studClampOffset>

    <studClampThickness type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:Studs />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Thickness of the stud clamp ring. At 0 no clamp is active.</documentation>
      <value>0.0</value>
      <scad:value>0.0</scad:value>
      <examples>
        <example language="BML" snippet="true" title="with clamp">
          <![CDATA[
<NativeBlock studClampThickness="0.15" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="with clamp">
          <![CDATA[
          ...
          ["studClampThickness", 0.15]
          ...
          ]]>
        </scad:example>
      </examples>
    </studClampThickness>

    <studCutoutDiameterAdjustment type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:Studs />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <documentation>Calibration adjustment for stud cutout diameter.
        Affects cutouts for studs in baseCutoutType=studs and outer wall
        cutouts in round bricks for grid compatibility. Calibration only.
      </documentation>
      <since>3.0.0</since>
      <value>0.2</value>
      <scad:value>0.2</scad:value>
      <examples>
        <example language="BML" snippet="true" title="looser">
          <![CDATA[
<NativeBlock studCutoutDiameterAdjustment="0.3" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="looser">
          <![CDATA[
          ...
          ["studCutoutDiameterAdjustment", 0.3]
          ...
          ]]>
        </scad:example>
      </examples>
    </studCutoutDiameterAdjustment>

    <studCutoutHeightAdjustment type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:Studs />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <documentation>Calibration adjustment for stud cutout height.
        Affects cutouts for studs in baseCutoutType=studs and outer wall
        cutouts in round bricks for grid compatibility. Calibration only.
      </documentation>
      <since>3.0.0</since>
      <value>0.4</value>
      <scad:value>0.4</scad:value>
      <examples>
        <example language="BML" snippet="true" title="taller cutout">
          <![CDATA[
<NativeBlock studCutoutHeightAdjustment="0.5" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="taller cutout">
          <![CDATA[
          ...
          ["studCutoutHeightAdjustment", 0.5]
          ...
          ]]>
        </scad:example>
      </examples>
    </studCutoutHeightAdjustment>

    <studDiameter type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:Studs />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Diameter of studs. Usually does not need adjustment.</documentation>
      <value>3</value>
      <scad:value>3</scad:value>
      <examples>
        <example language="BML" snippet="true" title="wider stud">
          <![CDATA[
<NativeBlock studDiameter="3.2" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="wider stud">
          <![CDATA[
          ...
          ["studDiameter", 3.2]
          ...
          ]]>
        </scad:example>
      </examples>
    </studDiameter>

    <studDiameterAdjustment type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:Studs />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <documentation>Calibration adjustment for studDiameter.</documentation>
      <value>0.2</value>
      <scad:value>0.2</scad:value>
      <examples>
        <example language="BML" snippet="true" title="tighter">
          <![CDATA[
<NativeBlock studDiameterAdjustment="0.1" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="tighter">
          <![CDATA[
          ...
          ["studDiameterAdjustment", 0.1]
          ...
          ]]>
        </scad:example>
      </examples>
    </studDiameterAdjustment>

    <studHeight type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:Studs />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Height of studs. Usually does not need adjustment.</documentation>
      <value>1</value>
      <scad:value>1</scad:value>
      <examples>
        <example language="BML" snippet="true" title="taller stud">
          <![CDATA[
<NativeBlock studHeight="1.2" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="taller stud">
          <![CDATA[
          ...
          ["studHeight", 1.2]
          ...
          ]]>
        </scad:example>
      </examples>
    </studHeight>

    <studHeightAdjustment type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:Studs />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <documentation>Calibration adjustment for studHeight.</documentation>
      <value>0.0</value>
      <scad:value>0.0</scad:value>
      <examples>
        <example language="BML" snippet="true" title="taller mm">
          <![CDATA[
<NativeBlock studHeightAdjustment="0.1" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="taller mm">
          <![CDATA[
          ...
          ["studHeightAdjustment", 0.1]
          ...
          ]]>
        </scad:example>
      </examples>
    </studHeightAdjustment>

    <studHoleClampThickness type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:Studs />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Thickness of the clamp inside the stud hole (studType=hollow).
        A constriction of the inner hole so pins/axles grip in the stud.
      </documentation>
      <value>0.1</value>
      <scad:value>0.1</scad:value>
      <examples>
        <example language="BML" snippet="true" title="thicker">
          <![CDATA[
<NativeBlock studHoleClampThickness="0.15" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="thicker">
          <![CDATA[
          ...
          ["studHoleClampThickness", 0.15]
          ...
          ]]>
        </scad:example>
      </examples>
    </studHoleClampThickness>

    <studHoleDiameter type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:Studs />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Diameter of the hole in studs (studType=hollow).
        Automatically calculated.
      </documentation>
      <value>Auto</value>
      <scad:value>auto</scad:value>
      <examples>
        <example language="BML" snippet="true" title="explicit">
          <![CDATA[
<NativeBlock studHoleDiameter="2.5" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="explicit">
          <![CDATA[
          ...
          ["studHoleDiameter", 2.5]
          ...
          ]]>
        </scad:example>
      </examples>
    </studHoleDiameter>

    <studHoleDiameterAdjustment type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:Studs />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <documentation>Calibration adjustment for studHoleDiameter.</documentation>
      <value>0.3</value>
      <scad:value>0.3</scad:value>
      <examples>
        <example language="BML" snippet="true" title="looser">
          <![CDATA[
<NativeBlock studHoleDiameterAdjustment="0.4" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="looser">
          <![CDATA[
          ...
          ["studHoleDiameterAdjustment", 0.4]
          ...
          ]]>
        </scad:example>
      </examples>
    </studHoleDiameterAdjustment>

    <studIcon type="Boolean.False | FilePath">
      <groups>
        <mbgroup:StudIcon />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>SVG file engraved into each stud.
        OpenSCAD resolves relative SVG paths against the .scad file that uses the path
        (the file that passes studIcon / import()), not against NativeBlock, the library
        root, or the FQN package folder. The same relative string therefore resolves
        differently from bricks/ vs examples/ vs a consumer project file — choose the
        path relative to the consuming .scad file. Absolute paths and paths relative to
        the OpenSCAD working directory follow normal OpenSCAD rules.
      </documentation>
      <value>../../pattern/bolt-solid-full.svg</value>
      <scad:value>../../pattern/bolt-solid-full.svg</scad:value>
      <examples>
        <example language="BML" snippet="true" title="bolt icon">
          <![CDATA[
<NativeBlock studIcon="../../pattern/bolt-solid-full.svg" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="bolt icon">
          <![CDATA[
          ...
          ["studIcon", "../../pattern/bolt-solid-full.svg"]
          ...
          ]]>
        </scad:example>
      </examples>
    </studIcon>

    <studIconColor type="mbt:Inherit | Color">
      <groups>
        <mbgroup:StudIcon />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Color of the stud icon. "inherit" uses baseColor.
        Only visually relevant when studIconDepth &gt; 0.
      </documentation>
      <value>Inherit</value>
      <scad:value>"inherit"</scad:value>
      <examples>
        <example language="BML" snippet="true" title="red">
          <![CDATA[
<NativeBlock studIconColor="#FF0000" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="red">
          <![CDATA[
          ...
          ["studIconColor", "#FF0000"]
          ...
          ]]>
        </scad:example>
      </examples>
    </studIconColor>

    <studIconDepth type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:StudIcon />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Depth of the icon engraving. Negative = engraved into the stud.
        Positive = raised above the stud.
      </documentation>
      <value>-0.2</value>
      <scad:value>-0.2</scad:value>
      <examples>
        <example language="BML" snippet="true" title="deeper icon">
          <![CDATA[
<NativeBlock studIconDepth="-0.3" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="deeper icon">
          <![CDATA[
          ...
          ["studIconDepth", -0.3]
          ...
          ]]>
        </scad:example>
      </examples>
    </studIconDepth>

    <studIconDimensions type="mbt:SizeXY(Decimal(unit:Millimeter))">
      <groups>
        <mbgroup:StudIcon />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Size of the stud icon SVG in mm (from the SVG file).
        Default values match all standard icons in the /patterns directory.
      </documentation>
      <value>{x: 169.333, y: 169.333}</value>
      <scad:value>[169.333, 169.333]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="custom svg size">
          <![CDATA[
<NativeBlock studIconDimensions="{x: 200, y: 200}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="custom svg size">
          <![CDATA[
          ...
          ["studIconDimensions", [200, 200]]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="xy size">
          <![CDATA[
<NativeBlock studIconDimensions="{x: 100, y: 50}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="xy size">
          <![CDATA[
          ...
          ["studIconDimensions", [100, 50]]
          ...
          ]]>
        </scad:example>
      </examples>
    </studIconDimensions>

    <studIconScale type="Decimal">
      <groups>
        <mbgroup:StudIcon />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Effective scale factor for the stud icon.</documentation>
      <value>0.8</value>
      <scad:value>0.8</scad:value>
      <examples>
        <example language="BML" snippet="true" title="larger">
          <![CDATA[
<NativeBlock studIconScale="1" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="larger">
          <![CDATA[
          ...
          ["studIconScale", 1]
          ...
          ]]>
        </scad:example>
      </examples>
    </studIconScale>

    <studMaxOverhang type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:Studs />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Maximum allowed stud overhang beyond the outer edge.
        Studs exceeding this are not drawn.
      </documentation>
      <value>0.3</value>
      <scad:value>0.3</scad:value>
      <examples>
        <example language="BML" snippet="true" title="more overhang">
          <![CDATA[
<NativeBlock studMaxOverhang="1.5" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="more overhang">
          <![CDATA[
          ...
          ["studMaxOverhang", 1.5]
          ...
          ]]>
        </scad:example>
      </examples>
    </studMaxOverhang>

    <studPadding type="mbt:FaceMapXY(Decimal(mbunit:GridUnitXY))">
      <groups>
        <mbgroup:Studs />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Padding from sides 0-3 inward. Shifts the outer wall for the decision
        whether studs are drawn, allowing outer studs to be hidden.
      </documentation>
      <value>{XNeg: 0, XPos: 0, YNeg: 0, YPos: 0}</value>
      <scad:value>[0, 0, 0, 0]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="inset studs">
          <![CDATA[
<NativeBlock studPadding="{xNeg: 0.5, xPos: 0.5, yNeg: 0.5, yPos: 0.5}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="inset studs">
          <![CDATA[
          ...
          ["studPadding", [0.5, 0.5, 0.5, 0.5]]
          ...
          ]]>
        </scad:example>
      </examples>
    </studPadding>

    <studRounding type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:Studs />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Rounding radius of the upper stud edge.</documentation>
      <value>0.0625</value>
      <scad:value>0.0625</scad:value>
      <examples>
        <example language="BML" snippet="true" title="more round">
          <![CDATA[
<NativeBlock studRounding="0.125" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="more round">
          <![CDATA[
          ...
          ["studRounding", 0.125]
          ...
          ]]>
        </scad:example>
      </examples>
    </studRounding>

    <studShift type="Boolean">
      <groups>
        <mbgroup:Studs />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Whether studs are shifted by 1/2 stud in X and Y.
        false: studs sit between pillars.
        true: studs sit directly above pillars.
      </documentation>
      <value>false</value>
      <scad:value>false</scad:value>
      <examples>
        <example language="BML" snippet="true" title="shifted">
          <![CDATA[
<NativeBlock studShift="true" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="shifted">
          <![CDATA[
          ...
          ["studShift", true]
          ...
          ]]>
        </scad:example>
      </examples>
    </studShift>

    <studType type="mbt:StudType">
      <groups>
        <mbgroup:Studs />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Type of studs. solid: massive. hollow: with a hole in the center.</documentation>
      <value>Solid</value>
      <scad:value>solid</scad:value>
      <examples>
        <example language="BML" snippet="true" title="hollow">
          <![CDATA[
<NativeBlock studType="Hollow" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="hollow">
          <![CDATA[
          ...
          ["studType", "hollow"]
          ...
          ]]>
        </scad:example>
      </examples>
    </studType>

    <studs type="Boolean">
      <groups>
        <mbgroup:Studs />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Whether studs are drawn. Use studAreas for per-region control including stud
        type override; later areas win on overlap.
      </documentation>
      <value>true</value>
      <scad:value>true</scad:value>
      <examples>
        <example language="BML" snippet="true" title="enabled">
          <![CDATA[
<NativeBlock studs="true" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="enabled">
          <![CDATA[
          ...
          ["studs", true]
          ...
          ]]>
        </scad:example>
      </examples>
    </studs>

    <studAreas type="mbt:SelectiveGrid(Boolean | mbt:StudType)[]">
      <groups>
        <mbgroup:Studs />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Per-region overrides for studs on the plate grid. Each entry is an inclusive
        rectangular range (start/end in GridUnitXY) with a Boolean or StudType value. Later entries
        win on overlap.
      </documentation>
      <value>[]</value>
      <scad:value>[]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="hollow region">
          <![CDATA[
<NativeBlock studs="true" studAreas="[{start:{x:0,y:0}, end:{x:3,y:0}, value:Hollow}]" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="hollow region">
          <![CDATA[
          ...
          ["studs", true],
          ["studAreas", [[[0,0],[3,0],"hollow"]]]
          ...
          ]]>
        </scad:example>
      </examples>
    </studAreas>

    <surfacePattern type="Boolean.False | FilePath">
      <groups>
        <mbgroup:SurfacePattern />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>SVG file for a pattern on the brick surface. Applied to the brick
        body surface as a repeating or single pattern.
        OpenSCAD resolves relative SVG paths against the .scad file that uses the path
        (the file that passes surfacePattern / import()), not against NativeBlock, the
        library root, or the FQN package folder. Pick the path relative to the consuming
        .scad file — the same string is not portable across different file depths.
      </documentation>
      <value>False</value>
      <scad:value>false</scad:value>
      <examples>
        <example language="BML" snippet="true" title="pattern file">
          <![CDATA[
<NativeBlock surfacePattern="patterns/hex.svg" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="pattern file">
          <![CDATA[
          ...
          ["surfacePattern", "patterns/hex.svg"]
          ...
          ]]>
        </scad:example>
      </examples>
    </surfacePattern>

    <surfacePatternColor type="mbt:Inherit | Color">
      <groups>
        <mbgroup:SurfacePattern />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Color of the surface pattern. "inherit" uses baseColor.
        Only visually relevant when surfacePatternDepth &gt; 0.
      </documentation>
      <value>Inherit</value>
      <scad:value>"inherit"</scad:value>
      <examples>
        <example language="BML" snippet="true" title="blue">
          <![CDATA[
<NativeBlock surfacePatternColor="#0066CC" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="blue">
          <![CDATA[
          ...
          ["surfacePatternColor", "#0066CC"]
          ...
          ]]>
        </scad:example>
      </examples>
    </surfacePatternColor>

    <surfacePatternDepth type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:SurfacePattern />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Depth of the surface pattern. Negative = engraved. Positive = raised.</documentation>
      <value>-0.0625</value>
      <scad:value>-0.0625</scad:value>
      <examples>
        <example language="BML" snippet="true" title="emboss">
          <![CDATA[
<NativeBlock surfacePatternDepth="0.2" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="emboss">
          <![CDATA[
          ...
          ["surfacePatternDepth", 0.2]
          ...
          ]]>
        </scad:example>
      </examples>
    </surfacePatternDepth>

    <surfacePatternDimensions type="mbt:SizeXY(Decimal(unit:Millimeter))">
      <groups>
        <mbgroup:SurfacePattern />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Size of the surface pattern SVG in mm (from the SVG file).</documentation>
      <value>{x: 451.556, y: 451.556}</value>
      <scad:value>[451.556, 451.556]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="custom svg size">
          <![CDATA[
<NativeBlock surfacePatternDimensions="{x: 500, y: 500}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="custom svg size">
          <![CDATA[
          ...
          ["surfacePatternDimensions", [500, 500]]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="xy size">
          <![CDATA[
<NativeBlock surfacePatternDimensions="{x: 100, y: 50}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="xy size">
          <![CDATA[
          ...
          ["surfacePatternDimensions", [100, 50]]
          ...
          ]]>
        </scad:example>
      </examples>
    </surfacePatternDimensions>

    <surfacePatternOffset type="mbt:OffsetXY">
      <groups>
        <mbgroup:SurfacePattern />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Offset of the surface pattern on the horizontal (Z-face) plane only
        (OffsetXY, default GridUnitXY). World XY — not AxisAB — because the pattern
        lies on the brick Z-face / GridUnitXY plane.
      </documentation>
      <value>{x: 0, y: 0}</value>
      <scad:value>[0, 0]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="shifted">
          <![CDATA[
<NativeBlock surfacePatternOffset="{x: 0.5, y: 0.25}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="shifted">
          <![CDATA[
          ...
          ["surfacePatternOffset", [0.5, 0.25]]
          ...
          ]]>
        </scad:example>
      </examples>
    </surfacePatternOffset>

    <surfacePatternPadding type="mbt:FaceMapXY(Decimal(mbunit:GridUnitXY))">
      <groups>
        <mbgroup:SurfacePattern />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Distance from the edges of the surface pattern area, forming a smooth
        (pattern-free) border around the structure. At 0, the pattern extends
        to the edges. Each edge can be configured individually via the
        4-element array form.
      </documentation>
      <since>3.0.0</since>
      <value>{XNeg: 0, XPos: 0, YNeg: 0, YPos: 0}</value>
      <scad:value>[0, 0, 0, 0]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="border">
          <![CDATA[
<NativeBlock surfacePatternPadding="{xNeg: 0.5, xPos: 0.5, yNeg: 0.5, yPos: 0.5}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="border">
          <![CDATA[
          ...
          ["surfacePatternPadding", [0.5, 0.5, 0.5, 0.5]]
          ...
          ]]>
        </scad:example>
      </examples>
    </surfacePatternPadding>

    <surfacePatternScale type="Decimal">
      <groups>
        <mbgroup:SurfacePattern />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Scale factor for the surface pattern.</documentation>
      <value>1</value>
      <scad:value>1</scad:value>
      <examples>
        <example language="BML" snippet="true" title="larger">
          <![CDATA[
<NativeBlock surfacePatternScale="1.5" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="larger">
          <![CDATA[
          ...
          ["surfacePatternScale", 1.5]
          ...
          ]]>
        </scad:example>
      </examples>
    </surfacePatternScale>

    <svg type="Boolean.False | FilePath">
      <groups>
        <mbgroup:Svg />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>SVG file to draw on a brick side. Placed on the side specified
        by svgFace.
      </documentation>
      <value>False</value>
      <scad:value>false</scad:value>
      <examples>
        <example language="BML" snippet="true" title="icon">
          <![CDATA[
<NativeBlock svg="icons/logo.svg" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="icon">
          <![CDATA[
          ...
          ["svg", "icons/logo.svg"]
          ...
          ]]>
        </scad:example>
      </examples>
    </svg>

    <svgColor type="Color">
      <groups>
        <mbgroup:Svg />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Color of the SVG.</documentation>
      <value>#2c3e50</value>
      <scad:value>"#2c3e50"</scad:value>
      <examples>
        <example language="BML" snippet="true" title="dark">
          <![CDATA[
<NativeBlock svgColor="#2c3e50" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="dark">
          <![CDATA[
          ...
          ["svgColor", "#2c3e50"]
          ...
          ]]>
        </scad:example>
      </examples>
    </svgColor>

    <svgDepth type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:Svg />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Depth/height of the SVG. Negative = engraved. Positive = raised.</documentation>
      <value>0.4</value>
      <scad:value>0.4</scad:value>
      <examples>
        <example language="BML" snippet="true" title="deeper svg">
          <![CDATA[
<NativeBlock svgDepth="0.6" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="deeper svg">
          <![CDATA[
          ...
          ["svgDepth", 0.6]
          ...
          ]]>
        </scad:example>
      </examples>
    </svgDepth>

    <svgDimensions type="mbt:SizeXY(Decimal(unit:Millimeter))">
      <groups>
        <mbgroup:Svg />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Size of the SVG in mm (from the SVG file).</documentation>
      <value>{x: 100, y: 100}</value>
      <scad:value>[100, 100]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="custom size">
          <![CDATA[
<NativeBlock svgDimensions="{x: 120, y: 80}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="custom size">
          <![CDATA[
          ...
          ["svgDimensions", [120, 80]]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="xy size">
          <![CDATA[
<NativeBlock svgDimensions="{x: 100, y: 50}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="xy size">
          <![CDATA[
          ...
          ["svgDimensions", [100, 50]]
          ...
          ]]>
        </scad:example>
      </examples>
    </svgDimensions>

    <svgFace type="mbt:Face">
      <groups>
        <mbgroup:Svg />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Side on which the SVG is drawn (0-5 or string "x-" etc.).</documentation>
      <since>3.0.0</since>
      <value>ZPos</value>
      <scad:value>z+</scad:value>
      <examples>
        <example language="BML" snippet="true" title="front">
          <![CDATA[
<NativeBlock svgFace="YPos" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="front">
          <![CDATA[
          ...
          ["svgFace", "y+"]
          ...
          ]]>
        </scad:example>
      </examples>
    </svgFace>

    <svgOffset type="mbt:OffsetXY">
      <groups>
        <mbgroup:Svg />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Offset of the SVG from its default position (OffsetXY, default GridUnitXY).</documentation>
      <value>{x: 0, y: 0}</value>
      <scad:value>[0, 0]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="shifted">
          <![CDATA[
<NativeBlock svgOffset="{x: 0.5, y: 0}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="shifted">
          <![CDATA[
          ...
          ["svgOffset", [0.5, 0]]
          ...
          ]]>
        </scad:example>
      </examples>
    </svgOffset>

    <svgScale type="Decimal">
      <groups>
        <mbgroup:Svg />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Scale factor for the SVG.</documentation>
      <value>1.0</value>
      <scad:value>1.0</scad:value>
      <examples>
        <example language="BML" snippet="true" title="larger">
          <![CDATA[
<NativeBlock svgScale="1.5" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="larger">
          <![CDATA[
          ...
          ["svgScale", 1.5]
          ...
          ]]>
        </scad:example>
      </examples>
    </svgScale>

    <text type="Boolean.False | Text">
      <groups>
        <mbgroup:Text />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Text to draw on the brick. If not empty, rendered on the side
        specified by textFace.
      </documentation>
      <value>False</value>
      <scad:value>false</scad:value>
      <examples>
        <example language="BML" snippet="true" title="label">
          <![CDATA[
<NativeBlock text="MB" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="label">
          <![CDATA[
          ...
          ["text", "MB"]
          ...
          ]]>
        </scad:example>
      </examples>
    </text>

    <textAlign type="mbt:Align">
      <groups>
        <mbgroup:Text />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Alignment of the text on the brick surface, using the same
        format as align and alignChildren.
      </documentation>
      <since>3.0.0</since>
      <value>Center</value>
      <scad:value>center</scad:value>
      <examples>
        <example language="BML" snippet="true" title="center">
          <![CDATA[
<NativeBlock textAlign="Center" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="center">
          <![CDATA[
          ...
          ["textAlign", "center"]
          ...
          ]]>
        </scad:example>
      </examples>
    </textAlign>

    <textColor type="Color">
      <groups>
        <mbgroup:Text />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Color of the text. Independent from baseColor.</documentation>
      <value>#2c3e50</value>
      <scad:value>"#2c3e50"</scad:value>
      <examples>
        <example language="BML" snippet="true" title="dark">
          <![CDATA[
<NativeBlock textColor="#2c3e50" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="dark">
          <![CDATA[
          ...
          ["textColor", "#2c3e50"]
          ...
          ]]>
        </scad:example>
      </examples>
    </textColor>

    <textDepth type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:Text />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Depth/height of the text. Negative = engraved. Positive = raised.</documentation>
      <value>-0.25</value>
      <scad:value>-0.25</scad:value>
      <examples>
        <example language="BML" snippet="true" title="raised text">
          <![CDATA[
<NativeBlock textDepth="0.2" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="raised text">
          <![CDATA[
          ...
          ["textDepth", 0.2]
          ...
          ]]>
        </scad:example>
      </examples>
    </textDepth>

    <textFace type="mbt:Face">
      <groups>
        <mbgroup:Text />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Side of the brick on which text is displayed (0-5 or string "x-" etc.).</documentation>
      <since>3.0.0</since>
      <value>XNeg</value>
      <scad:value>x-</scad:value>
      <examples>
        <example language="BML" snippet="true" title="top face">
          <![CDATA[
<NativeBlock textFace="ZPos" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="top face">
          <![CDATA[
          ...
          ["textFace", "z+"]
          ...
          ]]>
        </scad:example>
      </examples>
    </textFace>

    <textFont type="Text">
      <groups>
        <mbgroup:Text />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Font family for the text.</documentation>
      <value>Liberation Sans</value>
      <scad:value>Liberation Sans</scad:value>
      <examples>
        <example language="BML" snippet="true" title="font">
          <![CDATA[
<NativeBlock textFont="RBNo3.1 Black" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="font">
          <![CDATA[
          ...
          ["textFont", "RBNo3.1 Black"]
          ...
          ]]>
        </scad:example>
      </examples>
    </textFont>

    <textOffset type="mbt:OffsetXY">
      <groups>
        <mbgroup:Text />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Offset of the text from its normal position (OffsetXY, default GridUnitXY).</documentation>
      <value>[0, 0]</value>
      <scad:value>[0, 0]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="shifted">
          <![CDATA[
<NativeBlock textOffset="{x: 0.5, y: 0}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="shifted">
          <![CDATA[
          ...
          ["textOffset", [0.5, 0]]
          ...
          ]]>
        </scad:example>
      </examples>
    </textOffset>

    <textSize type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:Text />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Font size of the text.</documentation>
      <value>4</value>
      <scad:value>4</scad:value>
      <examples>
        <example language="BML" snippet="true" title="larger">
          <![CDATA[
<NativeBlock textSize="6" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="larger">
          <![CDATA[
          ...
          ["textSize", 6]
          ...
          ]]>
        </scad:example>
      </examples>
    </textSize>

    <textSpacing type="Decimal">
      <groups>
        <mbgroup:Text />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Letter spacing of the text.</documentation>
      <value>1</value>
      <scad:value>1</scad:value>
      <examples>
        <example language="BML" snippet="true" title="looser">
          <![CDATA[
<NativeBlock textSpacing="1.2" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="looser">
          <![CDATA[
          ...
          ["textSpacing", 1.2]
          ...
          ]]>
        </scad:example>
      </examples>
    </textSpacing>

    <tongue type="Boolean">
      <groups>
        <mbgroup:TongueGroove />
        <mbgroup:FrequentAiUsage />
      </groups>
      <documentation>Whether a tongue (ridge) is drawn. Counterpart to baseCutoutType=groove.
        Tongue and groove are an alternative attachment system for joining two
        bricks, typically to create a solid block from two separate parts.
        The tongue wraps around the outermost ring of studs and is compatible
        with a plate of the same size, but typically used with a groove brick.
        Can be used with or without recess.
      </documentation>
      <value>false</value>
      <scad:value>false</scad:value>
      <examples>
        <example language="BML" snippet="true" title="enabled">
          <![CDATA[
<NativeBlock tongue="true" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="enabled">
          <![CDATA[
          ...
          ["tongue", true]
          ...
          ]]>
        </scad:example>
      </examples>
    </tongue>

    <tongueClampHeight type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:TongueGroove />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Height of the tongue clamp lip. Affects both the lip on the tongue
        and the matching recess in the groove for snapping together.
      </documentation>
      <value>0.5</value>
      <scad:value>0.5</scad:value>
      <examples>
        <example language="BML" snippet="true" title="taller">
          <![CDATA[
<NativeBlock tongueClampHeight="0.75" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="taller">
          <![CDATA[
          ...
          ["tongueClampHeight", 0.75]
          ...
          ]]>
        </scad:example>
      </examples>
    </tongueClampHeight>

    <tongueClampOffset type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:TongueGroove />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Distance from the lower edge of the tongue to the lower edge of
        the tongue clamp lip. Also affects the groove's clamp recess position.
      </documentation>
      <changelog>
        <change version="3.0.0">Measurement changed from upper-edge-to-upper-edge to
          lower-edge-to-lower-edge.
          This avoids needing to calculate groove depth when positioning the clamp.
        </change>
      </changelog>
      <value>0.5</value>
      <scad:value>0.5</scad:value>
      <examples>
        <example language="BML" snippet="true" title="larger offset">
          <![CDATA[
<NativeBlock tongueClampOffset="0.75" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="larger offset">
          <![CDATA[
          ...
          ["tongueClampOffset", 0.75]
          ...
          ]]>
        </scad:example>
      </examples>
    </tongueClampOffset>

    <tongueClampThickness type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:TongueGroove />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Thickness of the tongue clamp lip / groove recess.</documentation>
      <value>0.1</value>
      <scad:value>0.1</scad:value>
      <examples>
        <example language="BML" snippet="true" title="thicker">
          <![CDATA[
<NativeBlock tongueClampThickness="0.15" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="thicker">
          <![CDATA[
          ...
          ["tongueClampThickness", 0.15]
          ...
          ]]>
        </scad:example>
      </examples>
    </tongueClampThickness>

    <!-- TODO: implement in SCAD -->
    <tongueGrooveClampOffsetClearance type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:TongueGroove />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <documentation>Extra clearance in the groove before the clamp recess. In the groove,
        both tongueClampOffset and tongueClampHeight are increased by this value,
        so the clamp snaps more easily into the groove recess.
        "auto" uses printerLayerHeight.
      </documentation>
      <since>3.0.0</since>
      <value>0</value>
      <scad:value>0</scad:value>
      <examples>
        <example language="BML" snippet="true" title="more clearance">
          <![CDATA[
<NativeBlock tongueGrooveClampOffsetClearance="0.05" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="more clearance">
          <![CDATA[
          ...
          ["tongueGrooveClampOffsetClearance", 0.05]
          ...
          ]]>
        </scad:example>
      </examples>
    </tongueGrooveClampOffsetClearance>

    <tongueGrooveDepthClearance type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:TongueGroove />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <documentation>Additional depth clearance above the tongue inside the groove.
        The effective groove depth = tongueHeight + tongueGrooveDepthClearance.
        Replaces the old tongueGrooveDepth parameter.
        "auto" uses printerLayerHeight.
      </documentation>
      <since>3.0.0</since>
      <value>Auto</value>
      <scad:value>auto</scad:value>
      <examples>
        <example language="BML" snippet="true" title="explicit">
          <![CDATA[
<NativeBlock tongueGrooveDepthClearance="0.1" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="explicit">
          <![CDATA[
          ...
          ["tongueGrooveDepthClearance", 0.1]
          ...
          ]]>
        </scad:example>
      </examples>
    </tongueGrooveDepthClearance>

    <!-- TODO: implement in SCAD -->
    <tongueGrooveThicknessClearance type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:TongueGroove />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <documentation>Clearance added to the groove width to allow the tongue to fit.
        Applied to both the groove wall thickness and tongueClampThickness
        inside the groove. Unlike tongueThicknessAdjustment (which only adjusts
        the tongue itself and not the clamp), this parameter adjusts the groove side
        including the clamp recess.
        "auto" uses 0.25 * printerNozzleDiameter (minimum 0.1 mm).
      </documentation>
      <since>3.0.0</since>
      <value>0.1</value>
      <scad:value>0.1</scad:value>
      <examples>
        <example language="BML" snippet="true" title="more clearance">
          <![CDATA[
<NativeBlock tongueGrooveThicknessClearance="0.15" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="more clearance">
          <![CDATA[
          ...
          ["tongueGrooveThicknessClearance", 0.15]
          ...
          ]]>
        </scad:example>
      </examples>
    </tongueGrooveThicknessClearance>

    <tongueHeight type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:TongueGroove />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Height of the tongue.</documentation>
      <value>1.25</value>
      <scad:value>1.25</scad:value>
      <examples>
        <example language="BML" snippet="true" title="taller tongue">
          <![CDATA[
<NativeBlock tongueHeight="1.5" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="taller tongue">
          <![CDATA[
          ...
          ["tongueHeight", 1.5]
          ...
          ]]>
        </scad:example>
      </examples>
    </tongueHeight>

    <tongueOffset type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:TongueGroove />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Distance of the tongue from the side edge.
        Corresponds to the distance of studs from the side edge.
      </documentation>
      <value>1</value>
      <scad:value>1</scad:value>
      <examples>
        <example language="BML" snippet="true" title="inset">
          <![CDATA[
<NativeBlock tongueOffset="1.5" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="inset">
          <![CDATA[
          ...
          ["tongueOffset", 1.5]
          ...
          ]]>
        </scad:example>
      </examples>
    </tongueOffset>

    <tongueRoundingRadius type="mbt:Auto | Decimal(mbunit:GridUnitXY) | mbt:PlaneRoundingMap">
      <groups>
        <mbgroup:TongueGroove />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Rounding radius of the tongue corners on the horizontal (Z-face) plane
        only — not a full BaseRoundingMap like baseRoundingRadius. Expanded form is
        PlaneRoundingMap (CornerMap with GridUnitXY). Auto typically derives from the block's
        baseRoundingRadius. Usually does not need adjustment.
      </documentation>
      <value>Auto</value>
      <scad:value>auto</scad:value>
      <examples>
        <example language="BML" snippet="true" title="rounded">
          <![CDATA[
<NativeBlock tongueRoundingRadius="0.5" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="rounded">
          <![CDATA[
          ...
          ["tongueRoundingRadius", 0.5]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="per-corner">
          <![CDATA[
<NativeBlock tongueRoundingRadius="{sw: 0.5, nw: 0.5, ne: 0.5, se: 0.5}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="per-corner">
          <![CDATA[
          ...
          ["tongueRoundingRadius", [0.5, 0.5, 0.5, 0.5]]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="anisotropic corner">
          <![CDATA[
<NativeBlock tongueRoundingRadius="{sw: {a: 0.5, b: 0.25}, nw: 0.5, ne: 0.5, se: {a: 0.5, b: 0.25}}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="anisotropic corner">
          <![CDATA[
          ...
          ["tongueRoundingRadius", [[0.5, 0.25], 0.5, 0.5, [0.5, 0.25]]]
          ...
          ]]>
        </scad:example>
      </examples>
    </tongueRoundingRadius>

    <tongueThickness type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:TongueGroove />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Thickness of the tongue.</documentation>
      <value>0.666</value>
      <scad:value>0.666</scad:value>
      <examples>
        <example language="BML" snippet="true" title="thicker">
          <![CDATA[
<NativeBlock tongueThickness="1.2" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="thicker">
          <![CDATA[
          ...
          ["tongueThickness", 1.2]
          ...
          ]]>
        </scad:example>
      </examples>
    </tongueThickness>

    <tongueThicknessAdjustment type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:TongueGroove />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <documentation>Calibration adjustment for tongue thickness. Adjusts the thickness
        of the tongue only (not the groove). Used when using a tongue with
        a non-groove partner brick. Does not affect tongueClampThickness.
        For groove clearance, use tongueGrooveThicknessClearance instead.
      </documentation>
      <value>0.0</value>
      <scad:value>0.0</scad:value>
      <examples>
        <example language="BML" snippet="true" title="thicker mm">
          <![CDATA[
<NativeBlock tongueThicknessAdjustment="0.1" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="thicker mm">
          <![CDATA[
          ...
          ["tongueThicknessAdjustment", 0.1]
          ...
          ]]>
        </scad:example>
      </examples>
    </tongueThicknessAdjustment>

    <topPlateHeight type="Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:TopPlate />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Preferred height of the top plate (upper ceiling of the base body).
        Actual height may differ depending on baseCutoutMaxDepth and
        recess depth. Usually does not need adjustment.
      </documentation>
      <since>3.0.0</since>
      <value>1</value>
      <scad:value>1</scad:value>
      <examples>
        <example language="BML" snippet="true" title="thicker plate">
          <![CDATA[
<NativeBlock topPlateHeight="1.5" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="thicker plate">
          <![CDATA[
          ...
          ["topPlateHeight", 1.5]
          ...
          ]]>
        </scad:example>
      </examples>
    </topPlateHeight>

    <topPlateHeightAdjustment type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:TopPlate />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <documentation>Calibration adjustment for topPlateHeight.
        Only for calibration/printer compensation.
      </documentation>
      <since>3.0.0</since>
      <value>-0.6</value>
      <scad:value>-0.6</scad:value>
      <examples>
        <example language="BML" snippet="true" title="taller mm">
          <![CDATA[
<NativeBlock topPlateHeightAdjustment="-0.4" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="taller mm">
          <![CDATA[
          ...
          ["topPlateHeightAdjustment", -0.4]
          ...
          ]]>
        </scad:example>
      </examples>
    </topPlateHeightAdjustment>

    <topPlateHelperHeight type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:PrintHelpers />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Height of one top plate helper layer. Typically matches the 3D print
        layer height. The horizontal layer is effectively 2× this value as
        it is printed first.
        "auto" uses printerLayerHeight.
      </documentation>
      <value>Auto</value>
      <scad:value>auto</scad:value>
      <examples>
        <example language="BML" snippet="true" title="explicit">
          <![CDATA[
<NativeBlock topPlateHelperHeight="0.2" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="explicit">
          <![CDATA[
          ...
          ["topPlateHelperHeight", 0.2]
          ...
          ]]>
        </scad:example>
      </examples>
    </topPlateHelperHeight>

    <topPlateHelperThickness type="mbt:Auto | Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:PrintHelpers />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Thickness of the top plate helpers in X/Y direction.
        "auto" uses 0.5 * printerNozzleDiameter (minimum 0.1 mm).
      </documentation>
      <value>Auto</value>
      <scad:value>auto</scad:value>
      <examples>
        <example language="BML" snippet="true" title="explicit">
          <![CDATA[
<NativeBlock topPlateHelperThickness="0.4" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="explicit">
          <![CDATA[
          ...
          ["topPlateHelperThickness", 0.4]
          ...
          ]]>
        </scad:example>
      </examples>
    </topPlateHelperThickness>

    <topPlateHelpers type="Boolean">
      <groups>
        <mbgroup:PrintHelpers />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Whether top plate helpers are active. A small frame that slightly
        widens the inner walls of the underside opening (baseCutoutType=standard).
        Improves adhesion when printing the ceiling (top plate).
        Two layers: horizontal (X-axis) then vertical (Y-axis).
        Usually active, does not need adjustment.
      </documentation>
      <value>true</value>
      <scad:value>true</scad:value>
      <examples>
        <example language="BML" snippet="true" title="on">
          <![CDATA[
<NativeBlock topPlateHelpers="true" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="on">
          <![CDATA[
          ...
          ["topPlateHelpers", true]
          ...
          ]]>
        </scad:example>
      </examples>
    </topPlateHelpers>

    <tubeDiameter type="mbt:Auto | Decimal(mbunit:MBU)">
      <groups>
        <mbgroup:Tubes />
        <mbgroup:NeverAiUsage />
      </groups>
      <documentation>Diameter of outer tubes for LEGO Technic holes.
        Automatically calculated per axis.
      </documentation>
      <since>3.0.0</since>
      <value>Auto</value>
      <scad:value>auto</scad:value>
      <examples>
        <example language="BML" snippet="true" title="explicit">
          <![CDATA[
<NativeBlock tubeDiameter="4" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="explicit">
          <![CDATA[
          ...
          ["tubeDiameter", 4]
          ...
          ]]>
        </scad:example>
      </examples>
    </tubeDiameter>

    <tubeDiameterAdjustment type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:Tubes />
        <mbgroup:ConfigOnlyAiUsage />
      </groups>
      <documentation>Calibration adjustment for tubeDiameter.</documentation>
      <since>3.0.0</since>
      <value>-0.1</value>
      <scad:value>-0.1</scad:value>
      <examples>
        <example language="BML" snippet="true" title="tighter">
          <![CDATA[
<NativeBlock tubeDiameterAdjustment="-0.15" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="tighter">
          <![CDATA[
          ...
          ["tubeDiameterAdjustment", -0.15]
          ...
          ]]>
        </scad:example>
      </examples>
    </tubeDiameterAdjustment>

    <!-- TODO: use XYZ in scad -->
    <unitGridToMbu type="mbt:SizeXYZ(Integer)">
      <groups>
        <mbgroup:System />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Grid size in mbu, representing a 1x1 plate.
        X and Y share the first value, Z uses the second.
        A 1x1 plate = 5×5×2 mbu = 8×8×3.2 mm at default settings.
      </documentation>
      <value>{x: 5, y: 5, z: 2}</value>
      <scad:value>[5, 5, 2]</scad:value>
      <examples>
        <example language="BML" snippet="true" title="custom grid">
          <![CDATA[
<NativeBlock unitGridToMbu="{x: 8, y: 8, z: 3.2}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="custom grid">
          <![CDATA[
          ...
          ["unitGridToMbu", [8, 8, 3.2]]
          ...
          ]]>
        </scad:example>
        <example language="BML" snippet="true" title="xyz size">
          <![CDATA[
<NativeBlock unitGridToMbu="{x: 2, y: 4, z: 3}" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="xyz size">
          <![CDATA[
          ...
          ["unitGridToMbu", [2, 4, 3]]
          ...
          ]]>
        </scad:example>
      </examples>
    </unitGridToMbu>

    <unitMbuToMm type="Decimal(unit:Millimeter)">
      <groups>
        <mbgroup:System />
        <mbgroup:RareAiUsage />
      </groups>
      <documentation>Base unit of the MachineBlocks system in millimeters.
        All grid-based size values are multiples of this unit.
        Adjustment parameters are exempt (always in mm).
      </documentation>
      <value>1.6</value>
      <scad:value>1.6</scad:value>
      <examples>
        <example language="BML" snippet="true" title="custom scale">
          <![CDATA[
<NativeBlock unitMbuToMm="1.5" />
          ]]>
        </example>
        <scad:example language="OpenSCAD" snippet="true" title="custom scale">
          <![CDATA[
          ...
          ["unitMbuToMm", 1.5]
          ...
          ]]>
        </scad:example>
      </examples>
    </unitMbuToMm>
  </properties>

  <aggregations>
    <children type="mbcore:Block[]" default="true">
      <documentation>
        Defines the child blocks of the current block.
      </documentation>
    </children>
    <cutouts type="NativeBlock[]">
      <groups>
        <mbgroup:CoreGeometry />
        <mbgroup:NeverAiUsage />
      </groups>
      <documentation>Void volumes subtracted from the block body. Unlike ports / connectors /
        screwHoles (ValueType structs), each cutout is a full NativeBlock instance — a complete
        block description limited to the parameters that determine shape (size, offset, bevel,
        slope, rounding, etc.). Aggregation (not a property) because cutouts are composition
        children of geometry, not scalar/struct values. A future split of NativeBlock will
        extract a dedicated shape-only Block type for this role. The subtraction is applied
        brutally — it ignores walls, recess, tongue, and all structural features.
      </documentation>
      <since>3.0.0</since>
    </cutouts>
  </aggregations>

</block>
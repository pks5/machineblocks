<!--MachineBlocks MBOM — composable Block with _parts aggregation

  FQN: com.machineblocks.bml.core.CompositeBlock-->
<mbcore:CompositeBlock xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:lang="org.blockml.bml.language"
  xmlns:mbcore="com.machineblocks.bml.core"
  xmlns:mbt="com.machineblocks.bml.type">

  <baseType>
    mbcore:Block
  </baseType>
  <is>
    A Block made of child Blocks
  </is>
  <documentation>
    Composable MachineBlocks Block with default _parts aggregation. _parts holds
    placed block instances (direction, offset, appliedPresets) or child blocks for SCAD
    composition.
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="mbcore:Block">
      Domain base type — inherits presets and basePresets for preset resolution.
    </see>
    <see type="mbcore:Set">
      Set specialization uses _parts for placed instances in a LEGO-style build.
    </see>
  </references>
  <properties>
    <offset type="mbt:OffsetXYZ">
      <documentation>
        Final displacement of this Block within a parent _parts composition.
        Same unit as NativeBlock.offset (grid units / multiples of a 1x1 plate).
      </documentation>
      <value>{x:0,y:0,z:0}</value>
    </offset>
  </properties>
  <aggregations>
    <_parts type="mbcore:Block[]" default="true" />
  </aggregations>
</mbcore:CompositeBlock>

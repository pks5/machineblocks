<!--MachineBlocks MBOM — Set base type (STEPS + views)

  FQN: com.machineblocks.bml.core.Set-->
<mbcore:Set xmlns="http://blockml.org/bml"
  xmlns:mbcore="com.machineblocks.bml.core">

  <baseType>
    mbcore:CompositeBlock
  </baseType>
  <is>
    A LEGO-style build set
  </is>
  <documentation>
    Abstract composable Block for LEGO-style Sets — block palette, placed instances,
    and assembly order. Top-level catalog unit in MachineBlocks.
  </documentation>
  <abstract>
    true
  </abstract>
  <references>
    <see type="mbcore:CompositeBlock">
      Extends CompositeBlock — inherits _parts for placed instances and presets for block palette.
    </see>
    <see type="mbcore:Step">
      Assembly steps in _steps reference placed parts via part association.
    </see>
  </references>
  <aggregations>
    <_steps type="mbcore:Step[]" />
  </aggregations>
</mbcore:Set>

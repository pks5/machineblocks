<!--MachineBlocks — config-only AI usage facet

  FQN: com.machineblocks.bml.group.ConfigOnlyAiUsage
  YAML ai_usage: config_only-->
<mbgroup:ConfigOnlyAiUsage xmlns="http://blockml.org/bml"
  xmlns:mbgroup="com.machineblocks.bml.group">

  <baseType>
    mbgroup:AiUsage
  </baseType>
  <is>
    A config-only AI usage recommendation
  </is>
  <documentation>
    AI usage facet — AI should only place this member in config / environment scope,
    not in per-brick settings (YAML ai_usage: config_only). Typical for calibration and adjustment
    values shared across bricks.
  </documentation>
</mbgroup:ConfigOnlyAiUsage>

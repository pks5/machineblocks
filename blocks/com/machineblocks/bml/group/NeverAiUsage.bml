  MachineBlocks — never AI usage facet

  FQN: com.machineblocks.bml.group.NeverAiUsage
  YAML ai_usage: never
-->
<block
  xmlns="http://blockml.org/bml"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/bml https://blockml.org/schemas/bml.xsd
                      "
  xmlns:mbgroup="com.machineblocks.bml.group">

  <name>NeverAiUsage</name>

<!--MachineBlocks — AI usage member group branch

  FQN: com.machineblocks.bml.group.AiUsage-->
<mbgroup:AiUsage xmlns="http://blockml.org/bml"
  xmlns:group="org.blockml.bml.group"
  xmlns:mbgroup="com.machineblocks.bml.group">

  <baseType>
    group:MemberGroup
  </baseType>
  <is>
    An AI member-usage guidance category
  </is>
  <documentation>
    Abstract base MemberGroup for AI usage facets — categories that describe whether
    and how an AI should set or omit a member when generating Block instances. Intentionally empty —
    no properties, aggregations, or Sub-Blocks. Concrete facets: FrequentAiUsage (yes), RareAiUsage
    (rarely), ConfigOnlyAiUsage (config_only), NeverAiUsage (never). Orthogonal to Category groups
    such as System or Positioning; members may list both via MemberDefinition.groups.
  </documentation>
  <abstract>
    true
  </abstract>
</mbgroup:AiUsage>

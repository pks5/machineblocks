<!--MachineBlocks — rare AI usage facet

  FQN: com.machineblocks.bml.group.RareAiUsage
  YAML ai_usage: rarely-->
<mbgroup:RareAiUsage xmlns="http://blockml.org/bml"
  xmlns:mbgroup="com.machineblocks.bml.group">

  <baseType>
    mbgroup:AiUsage
  </baseType>
  <is>
    A rare AI usage recommendation
  </is>
  <documentation>
    AI usage facet — usually not needed, but safe if intentional (YAML ai_usage:
    rarely). AI systems should omit this member by default and only set it when the generation task
    clearly requires it.
  </documentation>
</mbgroup:RareAiUsage>

<!--MachineBlocks — frequent AI usage facet

  FQN: com.machineblocks.bml.group.FrequentAiUsage
  YAML ai_usage: yes-->
<mbgroup:FrequentAiUsage xmlns="http://blockml.org/bml"
  xmlns:mbgroup="com.machineblocks.bml.group">

  <baseType>
    mbgroup:AiUsage
  </baseType>
  <is>
    A frequent AI usage recommendation
  </is>
  <documentation>
    AI usage facet — safe and common to set this member in per-brick settings when
    generating Block instances (YAML ai_usage: yes). Maps to the guidance that AI systems may use
    this parameter routinely for individual bricks.
  </documentation>
</mbgroup:FrequentAiUsage>

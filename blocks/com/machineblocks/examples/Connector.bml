<block
  xmlns="http://blockml.org/schema/block"
  xmlns:bml="http://blockml.org/schema/bml"
  xmlns:data="http://blockml.org/schema/data"
  xmlns:core="com.machineblocks.core"
  xmlns:type="com.machineblocks.type"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://blockml.org/schema/block https://blockml.org/schemas/core/block.xsd
                      http://machineblocks.com/schema/core https://machineblocks.com/schemas/machineblocks/core.xsd
                      http://machineblocks.com/schema/bricks https://machineblocks.com/schemas/machineblocks/bricks.xsd
                      "
  xmlns:examples="com.machineblocks.examples">

  <idea>Checkerboard grid of bricks demonstrating composition and computed defaults.</idea>
  <name>Connector</name>
  <type>examples:Connector</type>
  <baseType>core:Block</baseType>
  <properties>

    <!-- Grid dimensions -->
    <columns type="Integer">
      <value>5</value>
    </columns>
    <rows type="Integer">
      <value>4</value>
    </rows>
    <blockSize type="type:Size3D">
      <value>[4, 2, 3]</value>
    </blockSize>

    <!--
      size is computed from columns, rows, blockSize.
      Computed value — references other properties of this Block.
      Cycle detection: columns, rows, blockSize have no dependencies → resolved first.
    -->
    <size type="type:Size3D"
    >
      <value>${ [blockSize.x * columns, blockSize.y * rows, blockSize.z] }</value>
    </size>

    <!-- Checkerboard colors -->
    <colorA type="type:Color">
      <value>#55AB68</value>
      <suggestions>
        <suggestion value="#55AB68" label="Nephritis" />
        <suggestion value="#58B99D" label="Turquoise" />
        <suggestion value="#5296D5" label="Peter River" />
        <suggestion value="#EAC645" label="Sun Flower" />
        <suggestion value="#EDF0F1" label="Clouds" />
      </suggestions>
    </colorA>
    <colorB type="type:Color">
      <value>#303D4E</value>
      <suggestions>
        <suggestion value="#303D4E" label="Midnight Blue" />
        <suggestion value="#38485C" label="Wet Asphalt" />
        <suggestion value="#D65745" label="Alizarin" />
        <suggestion value="#925CB1" label="Amethyst" />
        <suggestion value="#98A4A6" label="Concrete" />
      </suggestions>
    </colorB>

  </properties>

  <!--
    Composition: columns × rows NativeBlock children.
    → ScadBlockProcessor generates automatic wrapper mb_block()
      with base=false, studs=false (wrapper is layout-only).

    Nested bml:each — named stat variables avoid collision:
      Outer loop: x, xStat  (iterates 0..columns-1)
      Inner loop: y, yStat  (iterates 0..rows-1)

    Checkerboard color: (x + y) % 2 == 0 ? colorA : colorB

    Connectors: conditional array built with #lists.concat.
      xStat.first / xStat.last detect edge columns.
      yStat.first / yStat.last detect edge rows.
      Each face gets a connector only when a neighbor exists:
        x- (left)   → female, when not first column
        x+ (right)  → male,   when not last column
        y- (front)  → female, when not first row
        y+ (back)   → male,   when not last row
  -->
  <composition>

    <bml:container bml:each="x, xStat : ${ columns }">
      <core:NativeBlock
        bml:each="y, yStat : ${ rows }"
        bml:id="${ 'brick_' + x + '_' + y }"
        size="${ blockSize }"
        offset="${ [x * blockSize.x, y * blockSize.y, 0] }"
        baseColor="${ (x + y) % 2 == 0 ? colorA : colorB }"
        connectors="${ #lists.concat(
            !xStat.first ? [{ face: 'x-', axis: 'z', type: 'female' }] : [],
            !xStat.last  ? [{ face: 'x+', axis: 'z', type: 'male'   }] : [],
            !yStat.first ? [{ face: 'y-', axis: 'z', type: 'female' }] : [],
            !yStat.last  ? [{ face: 'y+', axis: 'z', type: 'male'   }] : []
          ) }" />
    </bml:container>

  </composition>

</block>